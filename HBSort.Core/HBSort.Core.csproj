<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
  </PropertyGroup>

  <!-- NuGet-Pakete für die Core-Bibliothek (reine Logik, kein UI) -->
  <ItemGroup>
    <!-- Entity Framework Core mit SQLite für die userdata.db -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.27" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.26">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- Microsoft.Data.Sqlite: Direkter ADO.NET-Zugriff auf SQLite, ohne EF.
         Wird fuer den BL-Cache (bl_cache.db) und Bulk-Import genutzt -
         EF ist fuer Bulk-Inserts zu langsam. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.26" />

    <!-- OpenCvSharp4: C#-Wrapper für OpenCV, gibt uns Zugriff auf USB-Webcams
         und Bildverarbeitung (Frame-Capture, Bild speichern etc.) -->
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260427" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260302" />

    <!-- System.Text.Json ist ab .NET 8 eingebaut, braucht kein extra Paket -->

    <!-- Serilog für Logging auch in der Core-Schicht -->
    <PackageReference Include="Serilog" Version="4.3.1" />

    <!-- DI-Abstraktion -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />

    <!-- BricklinkSharp: offizieller .NET-Wrapper um die BL-Store-API.
         Macht OAuth1 + JSON-Parsing fuer uns. Wir kapseln das Library-Singleton
         hinter unserem eigenen IBricklinkClient damit Tests gegen unseren
         Wrapper laufen koennen. -->
    <PackageReference Include="BricklinkSharp" Version="1.9.0" />

    <!-- ProtectedData: DPAPI-Encrypt/Decrypt fuer die BL-Tokens. Im
         net8.0-windows-Target nicht im base-class-library, daher als Paket. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.7" />
  </ItemGroup>

  <ItemGroup>
    <!-- BL-Cache-Schema: wird beim ersten Start vom BlCacheRepository ausgefuehrt. -->
    <EmbeddedResource Include="Database\BlCacheSchema.sql">
      <LogicalName>HBSort.Core.Database.BlCacheSchema.sql</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
