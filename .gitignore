# ============================================
# Local config / Secrets / User-Data
# ============================================
appsettings.Development.json
appsettings.Local.json
secrets.json
.env
.env.local

# ============================================
# Claude Code lokale Settings
# ============================================
.claude/settings.local.json

# ============================================
# Rebrickable-Seed-Daten in PROMPT 6 (2026-05-02) entfernt; Eintraege bleiben
# als Schutz gegen versehentliches Re-Adden, falls jemand die alten ZIPs
# zurueckkopiert.
# ============================================
seed-data/*.zip
HBSort.Core/Resources/CatalogSeed/*.zip

# BrickStore-Datenbank-Download-Cache (~570 MB, wird zur Laufzeit
# heruntergeladen via Settings -> BL-Catalog-Daten -> "Von GitHub importieren")
downloads/

# Lokale Resources (Icons, Screenshots etc. die nicht ins Repo gehoeren)
Resources/
# Hilfe-Inhalte gehoeren explizit ins Repo (Markdown + index.json + Bilder),
# damit sie versioniert sind und in CI/CD-Builds eingebettet werden koennen.
# Reihenfolge wichtig: erst HBSort/Resources/ wieder zugreifbar machen,
# dann den direkten Inhalt erneut sperren (logo.png, app.ico etc. bleiben
# lokal), und schliesslich nur den Help-Unterordner durchlassen.
!/HBSort/Resources/
/HBSort/Resources/*
!/HBSort/Resources/Help/
!/HBSort/Resources/Help/**

# ============================================
# Lokale App-Daten (KRITISCH - duerfen nie ins Repo)
# ============================================
# SQLite-Datenbanken (userdata.db, bl_cache.db, etc.) - enthalten
# persoenliche Sortier-Daten und API-Cache. Auch Sidecar-Files (-shm/-wal).
*.db
*.db-shm
*.db-wal

# settings.json enthaelt DPAPI-verschluesselte BL-Tokens. Auch wenn
# der Inhalt kryptografisch geschuetzt ist: gehoert nicht ins Repo.
settings.json

# User-Bilder + Scan-Snapshots, falls sie im Projekt-Ordner landen
# (Default-Pfad ist AppData, aber defensiv ausschliessen).
images/
scans/

# Migrations-Marker aus dem LegoMinifigSorter-Rename-Schritt.
MIGRATED_TO_HBSort.txt

# ============================================
# Publish-Output (Release-Builds)
# ============================================
# dotnet publish landet hier (Self-Contained-Builds, mehrere 100 MB).
publish/

# ============================================
# Interne Berichte (nicht fuer Public-Repo)
# ============================================
CODE_AUDIT_REPORT.md
CODE_CHECK_REPORT.md
HBSort_Test_Checkliste.pdf
*.pdf

# ============================================
# Logs
# ============================================
*.log
logs/

# ============================================
# Test-Outputs
# ============================================
TestResults/
coverage/
*.trx
*.coverage
*.coveragexml

# ============================================
# Temporary / Backup
# ============================================
*.bak
*.tmp
*~
~*
*.swp

