<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
  </PropertyGroup>

  <!-- NuGet-Pakete für die Core-Bibliothek (reine Logik, kein UI) -->
  <ItemGroup>
    <!-- Entity Framework Core mit SQLite für die userdata.db -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.13">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- Microsoft.Data.Sqlite: Direkter ADO.NET-Zugriff auf SQLite, ohne EF.
         Wird fuer den Catalog-Import (Bulk-Insert von >1 Mio. Zeilen) genutzt –
         da ist EF zu langsam. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.13" />

    <!-- CsvHelper: De-facto-Standard fuer CSV-Parsing in .NET.
         Robust gegen Edge Cases (eingebettete Kommas, Anfuehrungszeichen, etc.). -->
    <PackageReference Include="CsvHelper" Version="33.0.1" />

    <!-- OpenCvSharp4: C#-Wrapper für OpenCV, gibt uns Zugriff auf USB-Webcams
         und Bildverarbeitung (Frame-Capture, Bild speichern etc.) -->
    <PackageReference Include="OpenCvSharp4" Version="4.10.0.20241108" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20241108" />

    <!-- System.Text.Json ist ab .NET 8 eingebaut, braucht kein extra Paket -->

    <!-- Serilog für Logging auch in der Core-Schicht -->
    <PackageReference Include="Serilog" Version="4.2.0" />

    <!-- DI-Abstraktion -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />

    <!-- BricklinkSharp: offizieller .NET-Wrapper um die BL-Store-API.
         Macht OAuth1 + JSON-Parsing fuer uns. Wir kapseln das Library-Singleton
         hinter unserem eigenen IBricklinkClient damit Tests gegen unseren
         Wrapper laufen koennen. -->
    <PackageReference Include="BricklinkSharp" Version="1.9.0" />

    <!-- ProtectedData: DPAPI-Encrypt/Decrypt fuer die BL-Tokens. Im
         net8.0-windows-Target nicht im base-class-library, daher als Paket. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <!-- Rebrickable-CSV-ZIPs als Embedded Resources einbinden.
       Die ZIPs werden zur Build-Zeit in die DLL gepackt und beim ersten App-Start
       in die catalog.db importiert. So kann die App ohne Internet (nach erstem
       Setup) komplett offline laufen. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\CatalogSeed\*.zip">
      <LogicalName>LegoMinifigSorter.Core.Resources.CatalogSeed.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- BL-Cache-Schema: wird beim ersten Start vom BlCacheRepository ausgefuehrt. -->
    <EmbeddedResource Include="Database\BlCacheSchema.sql">
      <LogicalName>LegoMinifigSorter.Core.Database.BlCacheSchema.sql</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
