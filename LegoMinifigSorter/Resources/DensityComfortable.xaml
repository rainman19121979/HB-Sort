<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime">
    <!-- Comfortable: groesserer Schrift + mehr Abstand fuer entspanntes Lesen. -->

    <!-- Schrift-Groessen -->
    <system:Double x:Key="HeaderFontSize">18</system:Double>
    <system:Double x:Key="BodyFontSize">14</system:Double>
    <system:Double x:Key="DetailFontSize">12</system:Double>
    <system:Double x:Key="MicroFontSize">11</system:Double>

    <!-- Spacing -->
    <Thickness x:Key="CardPadding">12</Thickness>
    <Thickness x:Key="BorderPadding">16</Thickness>
    <Thickness x:Key="ContentMargin">12</Thickness>
    <Thickness x:Key="ItemMargin">4</Thickness>

    <!-- Bild-Groessen -->
    <GridLength x:Key="CardImageHeight">240</GridLength>
    <system:Double x:Key="PartImageSize">80</system:Double>
    <system:Double x:Key="MinifigImageSize">140</system:Double>
    <system:Double x:Key="ColorSwatchSize">20</system:Double>

    <!-- Button -->
    <Thickness x:Key="ButtonPadding">16,6</Thickness>
</ResourceDictionary>
