<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime">
    <!-- Compact: viel Info auf einen Blick, kleinere Schrift, knapper Spacing. -->

    <!-- Schrift-Groessen -->
    <system:Double x:Key="HeaderFontSize">13</system:Double>
    <system:Double x:Key="BodyFontSize">11</system:Double>
    <system:Double x:Key="DetailFontSize">10</system:Double>
    <system:Double x:Key="MicroFontSize">9</system:Double>

    <!-- Spacing -->
    <Thickness x:Key="CardPadding">6</Thickness>
    <Thickness x:Key="BorderPadding">8</Thickness>
    <Thickness x:Key="ContentMargin">6</Thickness>
    <Thickness x:Key="ItemMargin">1</Thickness>

    <!-- Bild-Groessen -->
    <GridLength x:Key="CardImageHeight">160</GridLength>
    <system:Double x:Key="PartImageSize">48</system:Double>
    <system:Double x:Key="MinifigImageSize">96</system:Double>
    <system:Double x:Key="ColorSwatchSize">14</system:Double>

    <!-- Button -->
    <Thickness x:Key="ButtonPadding">10,3</Thickness>
</ResourceDictionary>
