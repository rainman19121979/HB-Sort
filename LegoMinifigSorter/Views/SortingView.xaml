<UserControl x:Class="LegoMinifigSorter.Views.SortingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:LegoMinifigSorter.Views">
    <!--
        Phase X: extrahierte UserControl fuer den Sortier-Tab im Hauptfenster.
        DataContext wird vom Parent (MainWindow / TabItem) geerbt = MainViewModel.
        GridSplitter-Persistierung (col/row-Sizes) erfolgt im Code-Behind via App.Services.
    -->
    <Grid x:Name="MainQuadrantsGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="65*" x:Name="TopRow"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="35*" x:Name="BottomRow"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" x:Name="LeftCol"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*" x:Name="RightCol"/>
        </Grid.ColumnDefinitions>

        <!-- Vertikaler Splitter (zwischen Spalten) -->
        <GridSplitter Grid.Row="0" Grid.RowSpan="3" Grid.Column="1"
                      Width="5"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="Transparent"
                      ShowsPreview="True"
                      ResizeBehavior="PreviousAndNext"
                      Cursor="SizeWE"
                      DragCompleted="ColumnSplitter_DragCompleted"/>

        <!--
            Horizontaler Splitter wurde absichtlich entfernt: das 65/35-Verhaeltnis
            zwischen oberer und unterer Zeile ist fix. Vertikaler Splitter (Spalten)
            bleibt aktiv und wird weiter persistiert.
        -->

        <!-- ===== OBEN-LINKS (R0,C0): Webcam-Bereich ===== -->
        <Border Grid.Row="0" Grid.Column="0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                BorderThickness="1" CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Image Grid.Row="0"
                       Source="{Binding ScanViewModel.CurrentFrame}"
                       Stretch="Uniform"
                       MinHeight="240" MaxHeight="600"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>

                <TextBlock Grid.Row="0"
                           Text="Kein Kamerabild verfügbar"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="16" Foreground="Gray"
                           Visibility="{Binding ScanViewModel.IsCameraRunning,
                               Converter={StaticResource InverseBoolToVisibility}}"/>

                <!-- Steuerleiste -->
                <StackPanel Grid.Row="1" Margin="8">
                    <!-- Kamera-Auswahl -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Kamera:"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding ScanViewModel.AvailableCameras}"
                                  SelectedIndex="{Binding ScanViewModel.SelectedCameraIndex}"
                                  ToolTip="USB-Kamera auswählen"/>
                    </Grid>

                    <!-- Modus-Auswahl (3 RadioButtons) -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Scan-Modus:" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <RadioButton Content="Automatisch"
                                     IsChecked="{Binding ScanViewModel.IsModeAuto, Mode=OneWay}"
                                     Click="ModeAuto_Click"
                                     GroupName="ScanMode" Margin="0,0,12,0"
                                     ToolTip="/predict/ – Brickognize entscheidet selbst"/>
                        <RadioButton Content="Minifigur"
                                     IsChecked="{Binding ScanViewModel.IsModeMinifig, Mode=OneWay}"
                                     Click="ModeMinifig_Click"
                                     GroupName="ScanMode" Margin="0,0,12,0"
                                     ToolTip="/predict/figs/ – nur Minifiguren"/>
                        <RadioButton Content="Einzelteil"
                                     IsChecked="{Binding ScanViewModel.IsModePart, Mode=OneWay}"
                                     Click="ModePart_Click"
                                     GroupName="ScanMode"
                                     ToolTip="/predict/parts/?predict_color=true – Teile mit Farberkennung"/>
                    </StackPanel>

                    <Button Content="Scannen (Leertaste)"
                            Command="{Binding ScanViewModel.PerformScanCommand}"
                            IsEnabled="{Binding ScanViewModel.CanScan}"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,4"
                            ToolTip="Leertaste drücken oder hier klicken zum Scannen"/>

                    <TextBlock Text="{Binding ScanViewModel.ScanStatusText}"
                               Foreground="Gray" FontSize="12"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== OBEN-RECHTS (R0,C2): Aktive Figur (MinifigDetailView) ===== -->
        <Border Grid.Row="0" Grid.Column="2"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                BorderThickness="1" CornerRadius="4">
            <Grid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ScanViewModel.HasPendingMinifig}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ScanViewModel.HasPendingPart}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Scanne eine Figur oder ein Teil"
                               FontSize="{DynamicResource HeaderFontSize}"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="Gray"/>
                    <TextBlock Text="Druecke Leertaste oder klicke 'Scannen'"
                               FontSize="{DynamicResource DetailFontSize}"
                               Foreground="Gray"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="6"
                              Visibility="{Binding ScanViewModel.HasPendingMinifig,
                                  Converter={StaticResource BoolToVisibility}}">
                    <ContentControl DataContext="{Binding ScanViewModel.PendingMinifig}">
                        <views:MinifigDetailView/>
                    </ContentControl>
                </ScrollViewer>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="6"
                              Visibility="{Binding ScanViewModel.HasPendingPart,
                                  Converter={StaticResource BoolToVisibility}}">
                    <ContentControl DataContext="{Binding ScanViewModel.PendingPart}">
                        <views:PartLookupView/>
                    </ContentControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ===== UNTEN-LINKS (R2,C0): Brickognize-Vorschlaege ===== -->
        <Border Grid.Row="2" Grid.Column="0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                BorderThickness="1" CornerRadius="4"
                Padding="{DynamicResource BorderPadding}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="BRICKOGNIZE-VORSCHLAEGE"
                           FontSize="{DynamicResource HeaderFontSize}" FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <TextBlock Grid.Row="1"
                           Text="Hier erscheinen die Brickognize-Vorschlaege nach einem Scan"
                           Foreground="Gray" FontStyle="Italic"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding ScanViewModel.HasResults,
                               Converter={StaticResource InverseBoolToVisibility}}"/>

                <Grid Grid.Row="1"
                      Visibility="{Binding ScanViewModel.HasResults, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding ScanViewModel.ResultHeadlineText}"
                                   FontSize="{DynamicResource BodyFontSize}"
                                   FontWeight="SemiBold"/>
                        <Button Grid.Column="1"
                                Content="Manuelle Suche..."
                                Visibility="{Binding ScanViewModel.ShowSearchFallback, Converter={StaticResource BoolToVisibility}}"
                                Click="SearchFallback_Click"/>
                    </Grid>

                    <Border Grid.Row="1" Margin="0,0,0,8"
                            Padding="8"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            BorderThickness="1" CornerRadius="4"
                            Visibility="{Binding ScanViewModel.HasColors,
                                 Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Erkannte Farbe(n)"
                                       FontSize="{DynamicResource DetailFontSize}"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding ScanViewModel.RecognizedColors}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,12,0"
                                                Padding="6,4"
                                                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                BorderThickness="1"
                                                CornerRadius="3">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="20" Height="20"
                                                        Background="{Binding SwatchBrush}"
                                                        BorderBrush="Black" BorderThickness="1"
                                                        Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding DisplayLabel}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding ScoreText}"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           Foreground="Gray"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <ItemsControl Grid.Row="2" ItemsSource="{Binding ScanViewModel.ResultCards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" Columns="3"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{Binding BorderBrush}"
                                        BorderThickness="{Binding BorderThickness}"
                                        CornerRadius="4"
                                        Padding="{DynamicResource CardPadding}" Margin="4"
                                        Background="Transparent"
                                        Cursor="Hand"
                                        Tag="{Binding Rank}"
                                        MouseLeftButtonUp="ResultCard_MouseLeftButtonUp">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background"
                                                            Value="{DynamicResource SystemControlBackgroundChromeMediumBrush}"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#4CAF50"/>
                                                    <Setter Property="BorderThickness" Value="3"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="{DynamicResource CardImageHeight}"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Image Grid.Row="0"
                                               Source="{Binding ImageUrl}"
                                               Stretch="Uniform"
                                               HorizontalAlignment="Center"/>

                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Name}"
                                                   FontSize="{DynamicResource BodyFontSize}"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   Margin="0,8,0,0"/>

                                        <Grid Grid.Row="2" Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding TypeLabel}"
                                                       Foreground="Gray"
                                                       FontSize="{DynamicResource DetailFontSize}"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ScoreText}"
                                                       FontSize="{DynamicResource DetailFontSize}"
                                                       FontWeight="SemiBold"/>
                                        </Grid>

                                        <TextBlock Grid.Row="3"
                                                   Text="{Binding HighlightLabel}"
                                                   FontSize="{DynamicResource DetailFontSize}"
                                                   Foreground="#4CAF50"
                                                   FontWeight="SemiBold" Margin="0,4,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Grid>
        </Border>

        <!-- ===== UNTEN-RECHTS (R2,C2): Lagerfach-Uebersicht ===== -->
        <Border Grid.Row="2" Grid.Column="2"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                BorderThickness="1" CornerRadius="4"
                Padding="{DynamicResource BorderPadding}"
                DataContext="{Binding WaitingMinifigs}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="LAGERFAECHER"
                               FontSize="{DynamicResource HeaderFontSize}" FontWeight="SemiBold"/>
                    <Button Grid.Column="1" Content="↻" Width="28" Padding="0"
                            ToolTip="Liste neu laden"
                            Command="{Binding RefreshCommand}"/>
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Anzeigen:" Foreground="Gray"
                               VerticalAlignment="Center" Margin="0,0,8,0"
                               FontSize="{DynamicResource MicroFontSize}"/>
                    <RadioButton Content="Nur belegt"
                                 IsChecked="{Binding IsFilterOccupiedOnly, Mode=OneWay}"
                                 Click="BinFilterOccupied_Click"
                                 GroupName="BinOverviewFilter" Margin="0,0,12,0"
                                 VerticalAlignment="Center"/>
                    <RadioButton Content="Alle"
                                 IsChecked="{Binding IsFilterAll, Mode=OneWay}"
                                 Click="BinFilterAll_Click"
                                 GroupName="BinOverviewFilter"
                                 VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Row="2"
                           Text="Keine Faecher zur Anzeige. Wechsle auf 'Alle' oder lege Faecher in den Einstellungen an."
                           Foreground="Gray" FontStyle="Italic" TextWrapping="Wrap"
                           VerticalAlignment="Top"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"/>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Bins}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                        BorderThickness="1" CornerRadius="4"
                                        Padding="0" Margin="0,2,0,4">
                                    <StackPanel>
                                        <Button Click="BinHeader_Click" Tag="{Binding}"
                                                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                                                BorderBrush="Transparent"
                                                HorizontalContentAlignment="Stretch"
                                                Padding="6,4" Cursor="Hand"
                                                ToolTip="Klicken zum Auf-/Zuklappen">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding ExpandIcon}"
                                                           VerticalAlignment="Center" Margin="0,0,6,0"
                                                           FontSize="{DynamicResource MicroFontSize}"/>
                                                <TextBlock Grid.Column="1" Text="📦"
                                                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Label}"
                                                           FontWeight="SemiBold"
                                                           FontSize="{DynamicResource DetailFontSize}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding StatusText}"
                                                           FontSize="{DynamicResource MicroFontSize}"
                                                           Foreground="Gray"
                                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <Button Grid.Column="4" Content="📋" Width="28" Padding="0"
                                                        Click="BinShowDetailFromOverview_Click"
                                                        Tag="{Binding}"
                                                        ToolTip="Inhalt anzeigen"/>
                                            </Grid>
                                        </Button>

                                        <StackPanel Margin="6,4,6,6"
                                                    Visibility="{Binding IsExpanded,
                                                        Converter={StaticResource BoolToVisibility}}">
                                            <ItemsControl ItemsSource="{Binding WaitingMinifigs}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Background="Transparent" BorderBrush="Transparent"
                                                                HorizontalContentAlignment="Stretch"
                                                                Click="WaitingMinifig_Click"
                                                                Tag="{Binding}"
                                                                Padding="4" Margin="0,1"
                                                                ToolTip="Klicken fuer Details">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="40"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Image Grid.Column="0"
                                                                       Source="{Binding ImageUrl}"
                                                                       Width="36" Height="36"
                                                                       Stretch="Uniform"/>
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                                                            Margin="6,0">
                                                                    <TextBlock Text="{Binding Name}"
                                                                               FontSize="{DynamicResource MicroFontSize}"
                                                                               FontWeight="SemiBold"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding BricklinkId}"
                                                                               FontFamily="Consolas"
                                                                               FontSize="{DynamicResource MicroFontSize}"
                                                                               Foreground="Gray"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                                                            MinWidth="70">
                                                                    <TextBlock Text="{Binding ProgressLabel}"
                                                                               FontSize="{DynamicResource MicroFontSize}"
                                                                               HorizontalAlignment="Right"/>
                                                                    <ProgressBar Height="4" Width="64"
                                                                                 Minimum="0" Maximum="1"
                                                                                 Value="{Binding ProgressFraction, Mode=OneWay}"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding MoreLabel}"
                                                       FontSize="{DynamicResource MicroFontSize}"
                                                       FontStyle="Italic" Foreground="Gray"
                                                       Margin="2,4,0,0"
                                                       Visibility="{Binding HasMore,
                                                           Converter={StaticResource BoolToVisibility}}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Grid.Row="3" Text="{Binding SummaryText}"
                           FontSize="{DynamicResource MicroFontSize}"
                           Foreground="Gray" Margin="0,4,0,0"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
