<Application x:Class="HBSort.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:converters="clr-namespace:HBSort.Converters"
             Startup="Application_Startup"
             ShutdownMode="OnExplicitShutdown">
    <!--
        ShutdownMode="OnExplicitShutdown": Die App beendet sich NICHT automatisch wenn
        das Fenster geschlossen wird. Stattdessen minimieren wir ins Tray-Icon.
        Erst ueber das Tray-Menue "Beenden" wird die App wirklich geschlossen.
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- ModernWpfUI Theme-Ressourcen: Folgt automatisch dem Windows-System-Theme -->
                <ui:ThemeResources />
                <ui:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>

            <!--
                UX-Iteration X.9: globaler Tooltips-Schalter. Wurzel-Windows
                binden ToolTipService.IsEnabled per DynamicResource an diesen
                Wert. Initial True; der TooltipsService ueberschreibt den Wert
                beim App-Start mit AppSettings.ShowTooltips und live bei jedem
                Toggle in den Einstellungen.
            -->
            <sys:Boolean x:Key="TooltipsEnabled">True</sys:Boolean>

            <!-- Converter fuer Datenbindung (z.B. bool → Visibility umkehren) -->
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
            <!--
                Schuetzt alle <Image Source="{Binding ...}"/>-Bindings vor
                null/leerem Strings. Verhindert die Trace-Warnung
                "Cannot convert '<null>' to ImageSource".
            -->
            <converters:NullToImageSourceConverter x:Key="NullToImageSource"/>
            <converters:ToastKindToBrushConverter x:Key="ToastKindToBrush"/>
            <converters:BrickognizeStatusToBrushConverter x:Key="BrickognizeStatusToBrush"/>
            <converters:RateLimitStateToBrushConverter x:Key="RateLimitStateToBrush"/>

            <!--
                Status-Brushes (Audit W-4, 2026-05-04):
                Material-Design-inspirierte Farben fuer einheitliche Status-
                Anzeige (Komplett, Wartend, Fehler, Info). Vorher waren die
                Hex-Werte 5x/4x/3x/3x in einzelnen Views hardcoded.

                Verwendung:
                - StatusSuccessBrush (#2E7D32, dunkelgruen): Komplett, Erfolg,
                  positive Bestaetigung. Foreground-Farbe.
                - StatusWarningBrush (#E65100, dunkelorange): Wartend, Stale,
                  Hinweis. Foreground-Farbe.
                - StatusErrorBrush (#C62828, dunkelrot): Fehler, kritischer
                  Status. Foreground-Farbe.
                - StatusInfoBrush (#1976D2, dunkelblau): Info, Hinweis.
                  Foreground-Farbe.

                Jeweils dazu die hellen Box-Backgrounds (Material-50-Tone)
                fuer Banner/Hintergruende:
                - SuccessBoxBackground (#E8F5E9): zur Kombination mit
                  StatusSuccessBrush als BorderBrush + Foreground.
                - WarningBoxBackground (#FFF3E0)
                - ErrorBoxBackground   (#FFEBEE)
                - InfoBoxBackground    (#E3F2FD)
            -->
            <!--
                Dialog-/View-Header-Schriftgroesse (Audit M-13, 2026-05-04).
                Stand 2026-05-04 = 20, kann hier zentral nachjustiert werden.
                Verwendung: App-Logo-Header, Dialog-Titel, View-Titel.
            -->
            <sys:Double x:Key="DialogHeaderFontSize">20</sys:Double>

            <SolidColorBrush x:Key="StatusSuccessBrush" Color="#2E7D32"/>
            <SolidColorBrush x:Key="StatusWarningBrush" Color="#E65100"/>
            <SolidColorBrush x:Key="StatusErrorBrush"   Color="#C62828"/>
            <SolidColorBrush x:Key="StatusInfoBrush"    Color="#1976D2"/>
            <SolidColorBrush x:Key="SuccessBoxBackground" Color="#E8F5E9"/>
            <SolidColorBrush x:Key="WarningBoxBackground" Color="#FFF3E0"/>
            <SolidColorBrush x:Key="ErrorBoxBackground"   Color="#FFEBEE"/>
            <SolidColorBrush x:Key="InfoBoxBackground"    Color="#E3F2FD"/>

            <!--
                MainTabRadioStyle (UX-Iteration X.4): Pivot-/NavigationView-Optik
                fuer die Haupt-Tabs ("Sortieren" / "Lagerliste") im modernisierten
                Header. RadioButton wird als grosser Tab-Button ohne Bullet
                dargestellt; aktiver Tab bekommt einen 3px-Indikator-Balken unten
                und die Akzent-Farbe.
            -->
            <Style x:Key="MainTabRadioStyle" TargetType="RadioButton">
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="OuterBorder"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}"
                                    BorderBrush="Transparent" BorderThickness="0,0,0,3"
                                    CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                  TextElement.FontWeight="{TemplateBinding FontWeight}"
                                                  TextElement.FontSize="{TemplateBinding FontSize}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="OuterBorder" Property="Background"
                                            Value="{DynamicResource SystemControlBackgroundChromeMediumBrush}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="OuterBorder" Property="BorderBrush"
                                            Value="{DynamicResource SystemAccentColorBrush}"/>
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
