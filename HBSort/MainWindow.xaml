<Window x:Class="HBSort.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:views="clr-namespace:HBSort.Views"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="HB-Sort"
        Icon="Resources/app.ico"
        Height="900" Width="1400"
        WindowState="Maximized"
        Closing="Window_Closing"
        Loaded="Window_Loaded">

    <!--
        Window-weite KeyBindings: feuern unabhaengig vom Fokus eines einzelnen
        Controls, sobald das Fenster aktiv ist. Loest das Problem, dass die
        Leertaste zuvor an dem zuletzt fokussierten Button (z.B. "Einstellungen")
        haengen blieb. Sicherheits-Check fuer TextBox-Fokus geschieht in den
        Commands selbst (siehe ScanViewModel.PerformScanAsync).
    -->
    <Window.InputBindings>
        <KeyBinding Key="Space"
                    Command="{Binding ScanViewModel.PerformScanCommand}"/>
        <KeyBinding Key="Q"
                    Command="{Binding ScanViewModel.OpenQuantityDialogCommand}"/>
        <KeyBinding Modifiers="Control" Key="Z"
                    Command="{Binding ScanViewModel.UndoLastScanCommand}"/>
        <KeyBinding Key="F1"
                    Command="{Binding OpenHelpCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Zeile 0: Titelleiste -->
            <RowDefinition Height="Auto"/>
            <!-- Zeile 1: Hauptbereich (2x2 Grid mit Splittern) -->
            <RowDefinition Height="*"/>
            <!-- Zeile 2: Status-Leiste -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--
            FocusTrap: ein unsichtbares ContentControl, das den initialen Tastatur-
            Fokus "auffaengt". Damit hat kein Button den Fokus solange der User
            keinen klickt. Width/Height=0 macht ihn unsichtbar; Focusable=True
            erlaubt Tastatur-Fokus; IsTabStop=False sorgt dafuer dass Tab den Trap
            ueberspringt. Wir nehmen ContentControl (nicht Border), weil Border
            kein Tab-Stop-Property hat.
        -->
        <ContentControl x:Name="FocusTrap" Grid.Row="0" Grid.RowSpan="3"
                        Focusable="True" IsTabStop="False"
                        Width="0" Height="0"
                        HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <!-- === TITELLEISTE === -->
        <Grid Grid.Row="0" Margin="16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Logo links -->
            <Image Grid.Column="0"
                   Source="Resources/logo.png"
                   Width="40" Height="40"
                   Margin="0,0,12,0"
                   VerticalAlignment="Center"
                   ToolTip="HB-Sort - HB-Bricks"/>

            <!-- Titel mit Version -->
            <TextBlock Grid.Column="1"
                       FontSize="18" FontWeight="SemiBold"
                       VerticalAlignment="Center">
                <Run Text="HB-Sort"/>
                <Run Text="{Binding VersionText, Mode=OneWay}"
                     FontSize="12" Foreground="Gray"/>
            </TextBlock>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="Einstellungen" Click="OpenSettings_Click"
                        ToolTip="Kamera, Schwellwerte und andere Einstellungen"/>
            </StackPanel>
        </Grid>

        <!-- === HAUPTBEREICH: TabControl (Phase X) === -->
        <TabControl Grid.Row="1" Margin="16,0,16,8">
            <TabItem Header="Sortieren">
                <views:SortingView/>
            </TabItem>
            <TabItem Header="Lagerliste">
                <views:InventoryListView DataContext="{Binding Inventory}"/>
            </TabItem>
        </TabControl>


        <!-- === STATUS-LEISTE === -->
        <Border Grid.Row="2"
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusText}"
                           FontSize="{DynamicResource DetailFontSize}"
                           VerticalAlignment="Center"/>

                <!-- BL-Rate-Limit-Counter (Phase R2.5) -->
                <TextBlock Grid.Column="1"
                           Text="{Binding BricklinkRateLimitText}"
                           ToolTip="{Binding BricklinkRateLimitTooltip}"
                           Foreground="{Binding BricklinkRateLimitState, Converter={StaticResource RateLimitStateToBrush}}"
                           FontSize="{DynamicResource DetailFontSize}" FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0"/>

                <!-- Bild-Cache-Stats live -->
                <TextBlock Grid.Column="2" Text="{Binding CacheStatusText}"
                           FontSize="{DynamicResource DetailFontSize}" VerticalAlignment="Center"
                           Margin="0,0,16,0"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>

                <!-- Brickognize-Status mit LED -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Margin="0,0,6,0"
                             Fill="{Binding ScanViewModel.BrickognizeStatus,
                                 Converter={StaticResource BrickognizeStatusToBrush}}"/>
                    <TextBlock Text="{Binding ScanViewModel.BrickognizeStatusText}"
                               FontSize="{DynamicResource DetailFontSize}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- === TOAST-CONTAINER (unten rechts) === -->
        <ItemsControl Grid.Row="1" Grid.RowSpan="2"
                      ItemsSource="{Binding ActiveToasts}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Margin="0,0,16,40"
                      IsHitTestVisible="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{Binding Kind, Converter={StaticResource ToastKindToBrush}}"
                            CornerRadius="6" Padding="14,10" Margin="0,4"
                            MinWidth="280" MaxWidth="420"
                            Effect="{x:Null}">
                        <TextBlock Text="{Binding Message}"
                                   Foreground="White"
                                   FontSize="13"
                                   TextWrapping="Wrap"/>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- === TRAY-ICON === -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        IconSource="Resources/app.ico"
                        ToolTipText="HB-Sort"
                        TrayMouseDoubleClick="TrayIcon_TrayMouseDoubleClick"
                        Visibility="Visible">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Öffnen" Click="TrayOpen_Click"/>
                    <Separator/>
                    <MenuItem Header="Beenden" Click="TrayExit_Click"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Grid>
</Window>
