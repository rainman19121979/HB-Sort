<Window x:Class="HBSort.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:views="clr-namespace:HBSort.Views"
        xmlns:behaviors="clr-namespace:HBSort.Behaviors"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="HB-Sort"
        Icon="Resources/app.ico"
        Height="900" Width="1400"
        WindowState="Maximized"
        Closing="Window_Closing"
        Loaded="Window_Loaded"
        PreviewKeyDown="MainWindow_PreviewKeyDown"
        ToolTipService.IsEnabled="{DynamicResource TooltipsEnabled}">

    <!--
        Window-weite KeyBindings: feuern unabhaengig vom Fokus eines einzelnen
        Controls, sobald das Fenster aktiv ist. UX X.20 Teil 6: deutlich erweitert.

        Leertaste hat einen ZUSAETZLICHEN PreviewKeyDown-Handler im Code-Behind -
        siehe MainWindow_PreviewKeyDown -, weil InputBindings nicht greifen wenn
        ein Border / TabItem / RadioButton den Tastatur-Fokus haelt (das passiert
        nach Maus-Klicks). Der PreviewKeyDown faengt die Leertaste vor dem
        Border ab und triggert PerformScan.

        Bewusst NICHT umgesetzt (siehe CLAUDE.md UX X.20 Teil 6 fuer Begruendung):
          - 1/2/3 (Top-3-Treffer uebernehmen): kollidiert mit TextBox-Eingabe
            in Anzahl-Feldern
          - +/- (Anzahl hoch/runter): kollidiert mit TextBox-Eingabe
          - Pfeiltasten / Pos1 / Ende: WPF-Standard fuer Listen + TextBox -
            wuerden Standard-Verhalten ueberschreiben
          - Entf (Lagerliste-Loeschen): kollidiert mit TextBox-Standard
          - F5 (Refresh): "aktueller Tab" ist mehrdeutig, kein klarer Use-Case
    -->
    <Window.InputBindings>
        <KeyBinding Key="Q"
                    Command="{Binding ScanViewModel.OpenQuantityDialogCommand}"/>
        <KeyBinding Modifiers="Control" Key="Z"
                    Command="{Binding ScanViewModel.UndoLastScanCommand}"/>
        <KeyBinding Key="F1"
                    Command="{Binding OpenHelpCommand}"/>

        <!-- UX X.20 Teil 6: Tab-Wechsel via Strg+S/L/H -->
        <KeyBinding Modifiers="Control" Key="S"
                    Command="{Binding SwitchToSortingTabCommand}"/>
        <KeyBinding Modifiers="Control" Key="L"
                    Command="{Binding SwitchToInventoryTabCommand}"/>
        <KeyBinding Modifiers="Control" Key="H"
                    Command="{Binding SwitchToHelpTabCommand}"/>

        <!-- UX X.20 Teil 6: Einstellungen via Strg+Komma (Standard-Konvention). -->
        <KeyBinding Modifiers="Control" Key="OemComma"
                    Command="{Binding OpenSettingsCommand}"/>

        <!-- UX-Iteration X.21 Teil 3: Strg+Q = App beenden. Alt+F4 ist Windows-
             Standard und funktioniert ohnehin (dort greift Window_Closing →
             Tray-Hide-Pfad); Strg+Q ist der explizite "App komplett beenden"-
             Shortcut, der den gleichen Pfad nutzt wie der Beenden-Button. -->
        <KeyBinding Modifiers="Control" Key="Q"
                    Command="{Binding ExitAppCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Zeile 0: Titelleiste -->
            <RowDefinition Height="Auto"/>
            <!-- Zeile 1: Hauptbereich (2x2 Grid mit Splittern) -->
            <RowDefinition Height="*"/>
            <!-- Zeile 2: Status-Leiste -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--
            FocusTrap: ein unsichtbares ContentControl, das den initialen Tastatur-
            Fokus "auffaengt". Damit hat kein Button den Fokus solange der User
            keinen klickt. Width/Height=0 macht ihn unsichtbar; Focusable=True
            erlaubt Tastatur-Fokus; IsTabStop=False sorgt dafuer dass Tab den Trap
            ueberspringt. Wir nehmen ContentControl (nicht Border), weil Border
            kein Tab-Stop-Property hat.
        -->
        <ContentControl x:Name="FocusTrap" Grid.Row="0" Grid.RowSpan="3"
                        Focusable="True" IsTabStop="False"
                        Width="0" Height="0"
                        HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <!-- === MODERNER HEADER (UX-Iteration X.4) ===
             Eine einzige Zeile: Logo+Version (links), Pivot-Tabs (Mitte),
             Settings-Button (rechts). Inspiriert vom Win11-Settings-/Photos-
             App-Header. Tabs sind RadioButtons mit dem ToggleSwitchButtonStyle
             aus ModernWpf - ein dezenter Indikator unter dem aktiven Tab. -->
        <Grid Grid.Row="0" Margin="16,12,16,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Links: Logo + Titel + Version -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="Resources/logo.png"
                       Width="36" Height="36"
                       Margin="0,0,12,0"
                       VerticalAlignment="Center"
                       ToolTip="HB-Sort - HB-Bricks"/>
                <TextBlock VerticalAlignment="Center"
                           FontSize="{StaticResource DialogHeaderFontSize}"
                           FontWeight="SemiBold">
                    <Run Text="HB-Sort"/>
                </TextBlock>
                <TextBlock Text="{Binding VersionText, Mode=OneWay}"
                           VerticalAlignment="Center"
                           Margin="8,4,0,0"
                           FontSize="12" Foreground="Gray"/>
            </StackPanel>

            <!-- Mitte: Pivot-Tabs -->
            <StackPanel Grid.Column="1" Orientation="Horizontal"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom">
                <RadioButton x:Name="TabSortingButton" GroupName="MainTabs"
                             Style="{StaticResource MainTabRadioStyle}"
                             IsChecked="{Binding IsMainTabSorting, Mode=OneWay}"
                             Click="MainTabSorting_Click"
                             Content="Sortieren"
                             ToolTip="Webcam-Scan + Pending-Bereich + variable Felder. Hier passiert die eigentliche Arbeit."
                             Margin="0,0,8,0"/>
                <RadioButton x:Name="TabInventoryButton" GroupName="MainTabs"
                             Style="{StaticResource MainTabRadioStyle}"
                             IsChecked="{Binding IsMainTabInventory, Mode=OneWay}"
                             Click="MainTabInventory_Click"
                             Content="Lagerliste"
                             ToolTip="Zeigt deinen kompletten Bestand: wartende Figuren, komplette Figuren, Einzelteile."
                             Margin="0,0,8,0"/>
                <RadioButton x:Name="TabHelpButton" GroupName="MainTabs"
                             Style="{StaticResource MainTabRadioStyle}"
                             IsChecked="{Binding IsMainTabHelp, Mode=OneWay}"
                             Click="MainTabHelp_Click"
                             Content="Hilfe"
                             ToolTip="Integrierte Doku zu Workflow, Lagerverwaltung, Export. (F1)"/>
            </StackPanel>

            <!-- Rechts: Settings + Beenden. UX X.26 (v0.1.13): Update-Badge
                 entfernt nach 6 fehlgeschlagenen Sichtbarkeits-Iterationen
                 (v0.1.5..v0.1.12). Diagnose-Logs zeigten korrekte Property-
                 Werte (Opacity=1, IsHitTestVisible=true, ActualWidth=128),
                 aber visuell blieb der Button unsichtbar. Vermutung:
                 WPF-Phantom-Bug, Hardware/Treiber-spezifisch. Update-Pfad
                 lebt jetzt nur noch im Settings-Tab "Updates". -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                <Button VerticalAlignment="Center"
                        Click="OpenSettings_Click"
                        Padding="10,6"
                        Margin="0,0,8,0"
                        ToolTip="Oeffnet die Einstellungen (Kamera, BL-Tokens, Cache, Preise, Lagerfaecher).">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="16" VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>
                        <TextBlock Text="Einstellungen" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- UX-Iteration X.21 Teil 3: Beenden-Button neben Einstellungen.
                     Kein AccentButtonStyle - das ist eine destruktive Aktion und kein
                     primaerer Workflow. Shortcut: Strg+Q (siehe InputBindings oben). -->
                <Button VerticalAlignment="Center"
                        Click="ExitApp_Click"
                        Padding="10,6"
                        ToolTip="Beendet die App (Strg+Q).">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="16" VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>
                        <TextBlock Text="Beenden" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Trenn-Linie zwischen Header und Inhalt -->
        <Border Grid.Row="0" VerticalAlignment="Bottom"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,0,1"/>

        <!-- === HAUPTBEREICH: ContentControl mit Tab-Inhalten ===
             Statt eines TabControl nutzen wir ContentControl + DataTrigger,
             damit die Tab-Optik komplett im modernen Header oben sitzt
             (TabControl wuerde sonst seinen eigenen Header zeigen). -->
        <Grid Grid.Row="1" Margin="16,8,16,8">
            <views:SortingView Visibility="{Binding IsMainTabSorting, Converter={StaticResource BoolToVisibility}}"/>
            <views:InventoryListView DataContext="{Binding Inventory}"
                                     Visibility="{Binding DataContext.IsMainTabInventory,
                                         RelativeSource={RelativeSource AncestorType=Window},
                                         Converter={StaticResource BoolToVisibility}}"/>
            <views:HelpView DataContext="{Binding Help}"
                            Visibility="{Binding DataContext.IsMainTabHelp,
                                RelativeSource={RelativeSource AncestorType=Window},
                                Converter={StaticResource BoolToVisibility}}"/>
        </Grid>


        <!-- === STATUS-LEISTE === -->
        <Border Grid.Row="2"
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusText}"
                           FontSize="10"
                           VerticalAlignment="Center"/>

                <!-- BL-Rate-Limit-Counter (Phase R2.5) -->
                <TextBlock Grid.Column="1"
                           Text="{Binding BricklinkRateLimitText}"
                           ToolTip="{Binding BricklinkRateLimitTooltip}"
                           Foreground="{Binding BricklinkRateLimitState, Converter={StaticResource RateLimitStateToBrush}}"
                           FontSize="10" FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0"/>

                <!-- Bild-Cache-Stats live -->
                <TextBlock Grid.Column="2" Text="{Binding CacheStatusText}"
                           FontSize="10" VerticalAlignment="Center"
                           Margin="0,0,16,0"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                           ToolTip="Aktuelle Belegung des Bild-Caches. Limit aenderst du in den Einstellungen."/>

                <!-- Brickognize-Status mit LED -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                            ToolTip="Erkennungs-Service. Gruen = ok, Rot = nicht erreichbar.">
                    <Ellipse Width="10" Height="10" Margin="0,0,6,0"
                             Fill="{Binding ScanViewModel.BrickognizeStatus,
                                 Converter={StaticResource BrickognizeStatusToBrush}}"/>
                    <TextBlock Text="{Binding ScanViewModel.BrickognizeStatusText}"
                               FontSize="10" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- === TOAST-CONTAINER (unten rechts) === -->
        <ItemsControl Grid.Row="1" Grid.RowSpan="2"
                      ItemsSource="{Binding ActiveToasts}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Margin="0,0,16,40"
                      IsHitTestVisible="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!--
                        UX X.20 Teil 5: Toasts mit optionalem Item-Bild links.
                        HasImage steuert die Visibility - bei Toasts ohne Bild
                        bleibt das Layout schmal wie vorher.
                    -->
                    <Border Background="{Binding Kind, Converter={StaticResource ToastKindToBrush}}"
                            CornerRadius="6" Padding="14,10" Margin="0,4"
                            MinWidth="280" MaxWidth="440"
                            Effect="{x:Null}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0"
                                   Source="{Binding ImageUrl, Converter={StaticResource NullToImageSource}}"
                                   Width="32" Height="32" Stretch="Uniform"
                                   Margin="0,0,10,0"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Message}"
                                       Foreground="White"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- === IMAGE-ZOOM-OVERLAY ===
             Liegt als oberste Schicht ueber allem (Grid.Row=0..2) damit das
             Overlay den ganzen Fensterinhalt ueberdeckt. Wird vom
             ImageZoom-Behavior aktiviert wenn der User auf ein Bild klickt
             das mit b:ImageZoom.IsEnabled=True markiert ist. -->
        <behaviors:ZoomOverlayHost x:Name="ZoomOverlay"
                                   Grid.Row="0" Grid.RowSpan="3"
                                   Panel.ZIndex="1000"/>

        <!-- UX X.24: Tray-Icon entfernt. X-Klick + Header-Beenden + Strg+Q
             machen jetzt alle das gleiche (echtes Beenden via
             Application.Shutdown). Vorher: X-Klick minimierte ins Tray, was zu
             "App ist zu, neue Instanz starten"-Verwirrung gefuehrt hat -
             zwei Instanzen kaempften um die Webcam. -->
    </Grid>
</Window>
