<UserControl x:Class="HBSort.Behaviors.ZoomOverlayHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed"
             Focusable="True"
             KeyDown="OnKeyDown">
    <!--
        Modal-Overlay fuer Bilder. UX X.20 Teil 3: Klick IRGENDWO im Popup
        schliesst es (Hintergrund, Bild, Border-Padding, X-Button). Vorher
        schloss nur der dunkle Hintergrund + ESC-Taste; ein Klick aufs
        Bild war ein No-op.

        Wir lassen den X-Button als visuelles Affordance drin - User die
        nicht wissen "klick irgendwo schliesst das" finden ihn intuitiv.
    -->
    <Grid Background="#B0000000"
          MouseLeftButtonUp="Background_MouseUp"
          ToolTip="Klick irgendwo zum Schliessen">
        <Border Margin="60"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Background="#22000000" CornerRadius="6"
                Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- X-Button oben rechts. Cursor=Hand und eigener Click-Handler;
                     wir verhindern das Bubbling NICHT mehr - selbst wenn der
                     Hintergrund-Handler greift, das Resultat ist dasselbe. -->
                <Button Grid.Row="0" Content="✕"
                        HorizontalAlignment="Right"
                        Width="32" Height="32"
                        FontSize="16"
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0"
                        Click="Close_Click"
                        ToolTip="Schliessen (ESC)"/>

                <!-- Das vergroesserte Bild. Klick darauf schliesst auch.
                     Source wird im Code-Behind gesetzt. -->
                <Image x:Name="ZoomedImage" Grid.Row="1"
                       Stretch="Uniform"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
