<UserControl x:Class="HBSort.Behaviors.ZoomOverlayHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed"
             Focusable="True"
             KeyDown="OnKeyDown">
    <!--
        Modal-Overlay fuer Bilder (UX-Iteration X.4). Wird ins MainWindow als
        oberste Schicht gelegt. Bei aktivem Overlay halbtransparenter Hintergrund
        + grosses Bild + X-Button zum Schliessen.

        Schliessen: Klick ausserhalb des Bildes, ESC-Taste, X-Button.

        Statt eines Converters nutzen wir Margin auf dem Bild-Border, damit
        rundherum ~10% Luft bleibt - das ergibt visuell die geforderten "~80%
        der Fensterflaeche" ohne zusaetzliche Converter-Dependency.
    -->
    <Grid Background="#B0000000" MouseLeftButtonUp="Background_MouseUp">
        <Border Margin="60"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Background="#22000000" CornerRadius="6"
                Padding="12"
                MouseLeftButtonUp="Border_MouseUp">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- X-Button oben rechts -->
                <Button Grid.Row="0" Content="✕"
                        HorizontalAlignment="Right"
                        Width="32" Height="32"
                        FontSize="16"
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0"
                        Click="Close_Click"
                        ToolTip="Schliessen (ESC)"/>

                <!-- Das vergroesserte Bild. Source wird im Code-Behind gesetzt. -->
                <Image x:Name="ZoomedImage" Grid.Row="1"
                       Stretch="Uniform"
                       MouseLeftButtonUp="Border_MouseUp"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
