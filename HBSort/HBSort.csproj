<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>12</LangVersion>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <AssemblyTitle>HB-Sort</AssemblyTitle>
    <Product>HB-Sort</Product>
    <Company>HB-Bricks</Company>
    <Description>Sortier-Werkzeug fuer Klemmbausteine</Description>
    <Copyright>(c) 2026 Holger</Copyright>
  </PropertyGroup>

  <!-- Projekt-Referenz auf die Core-Bibliothek (enthält alle Services und Models) -->
  <ItemGroup>
    <ProjectReference Include="..\HBSort.Core\HBSort.Core.csproj" />
  </ItemGroup>

  <!-- NuGet-Pakete für das WPF-Hauptprojekt -->
  <ItemGroup>
    <!-- CommunityToolkit.Mvvm: Microsoft-Bibliothek die MVVM-Boilerplate reduziert
         (ObservableObject, RelayCommand etc.) -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />

    <!-- ModernWpfUI: Bringt das moderne Windows-Look-and-Feel (Hell/Dunkel-Theme)
         automatisch passend zum System-Theme -->
    <PackageReference Include="ModernWpfUI" Version="0.9.6" />

<!-- H.NotifyIcon.Wpf entfernt in UX X.24: Tray-Icon raus, X-Klick beendet jetzt
         direkt die App (nicht mehr in den Tray minimieren). -->


    <!-- Serilog: Strukturiertes Logging-Framework mit tagesweiser Rotation -->
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />

    <!-- DI-Container von Microsoft -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />

    <!-- EF Core Design-Package wird vom Startup-Projekt gebraucht für Migrations-Tooling -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.26">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- Markdig: CommonMark-konformer Markdown-Parser. Wird vom Hilfe-Tab
         genutzt, um die .md-Dateien aus Resources/Help/ zur Laufzeit zu rendern. -->
    <PackageReference Include="Markdig" Version="0.45.0" />
    <!-- Markdig.Wpf: Renderer der ein FlowDocument aus dem Markdig-Tree baut.
         Bringt eigene Default-Styles fuer Headings/Listen/Code/Bilder mit, die
         per ResourceDictionary ueberschrieben werden koennen. -->
    <PackageReference Include="Markdig.Wpf" Version="0.5.0.1" />

    <!-- Velopack: Setup-Erstellung + Auto-Update via GitHub Releases. Ersetzt
         das fruehere SquirrelWindows. Kerncode laedt einen neuen Release im
         Hintergrund herunter und wechselt beim naechsten Start auf die neue
         Version. UI-Sichtbarkeit liegt komplett bei uns (kein eigenes Velopack-
         UI). Setup.exe + .nupkg + RELEASES-Datei werden im CI-Workflow ueber
         vpk pack erzeugt. -->
    <PackageReference Include="Velopack" Version="0.0.1298" />
  </ItemGroup>

  <!-- Logo-Resources fuer Splash, About-Dialog, Window-Icons -->
  <ItemGroup>
    <Resource Include="Resources\logo.png" />
    <Resource Include="Resources\app.ico" />
  </ItemGroup>

  <!-- Hilfe-Inhalte (Markdown + index.json + Bilder) als WPF-Resource einbinden,
       damit sie ueber pack://application:,,, addressierbar sind. Markdig.Wpf
       kann Bilder direkt ueber pack-URIs laden. -->
  <ItemGroup>
    <Resource Include="Resources\Help\**\*.md" />
    <Resource Include="Resources\Help\**\*.json" />
    <Resource Include="Resources\Help\images\**\*.png" />
    <Resource Include="Resources\Help\images\**\*.jpg" />
  </ItemGroup>

</Project>
