<Window x:Class="HBSort.Views.SupersetsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Wo kommt das Teil vor?"
        Icon="../Resources/app.ico"
        Width="720" Height="640"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="{Binding HeaderText}"
                   FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                   Margin="0,0,0,8"/>

        <!-- Suchfeld -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ui:ControlHelper.PlaceholderText="Suche nach Name oder BL-ID..."/>
            <ProgressBar Grid.Column="1" Width="120" Height="6"
                         IsIndeterminate="True" Margin="8,0,0,0"
                         VerticalAlignment="Center"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
        </Grid>

        <!-- Gruppierte Liste -->
        <Border Grid.Row="2"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="1" CornerRadius="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding GroupedView}">
                    <ItemsControl.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                                            Padding="8,4" Margin="0,4,0,2">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold" FontSize="12"/>
                                            <TextBlock Text="{Binding ItemCount, StringFormat=' ({0})'}"
                                                       FontSize="11" Foreground="Gray"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ItemsControl.GroupStyle>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="6,4" Margin="6,2"
                                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Image Grid.Column="0" Source="{Binding ImageUrl}"
                                           Width="44" Height="44" Stretch="Uniform"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                                        <TextBlock>
                                            <Run Text="{Binding BlMinifigId, Mode=OneWay}" FontFamily="Consolas"
                                                 FontWeight="SemiBold"/>
                                            <Run Text=" - "/>
                                            <Run Text="{Binding MinifigName, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding WaitingStatusText}"
                                                   Foreground="Gray" FontSize="11"
                                                   Visibility="{Binding IsAlreadyWaiting,
                                                       Converter={StaticResource BoolToVisibility}}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Zuordnen"
                                                Click="Assign_Click" Tag="{Binding}"
                                                Padding="6,2" Margin="0,0,4,0"
                                                Visibility="{Binding IsAlreadyWaiting,
                                                    Converter={StaticResource BoolToVisibility}}"/>
                                        <Button Content="Diese Figur sammeln"
                                                Click="Collect_Click" Tag="{Binding}"
                                                Padding="6,2"
                                                Visibility="{Binding IsCollectable,
                                                    Converter={StaticResource BoolToVisibility}}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Schliessen" IsCancel="True" IsDefault="True" Width="120"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
