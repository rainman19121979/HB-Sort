<UserControl x:Class="HBSort.Views.MinifigDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:HBSort.Behaviors">
    <!--
        Phase R3: Detailansicht der erkannten Minifigur (Daten aus BlCatalogService).
        Header mit Bild + Name + BL-ID + Jahr + Anzahl Teile,
        Teileliste mit Bild, BL-Part-No, BL-Color (Swatch + Name + ID), Anzahl,
        Footer mit Lagerfach-Auswahl (Phase-4-Stub) + Verwerfen-Button.
    -->

    <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
            BorderThickness="1" CornerRadius="4"
            Padding="8">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Header: Bild + Daten -->
                <RowDefinition Height="Auto"/>
                <!-- Trenner -->
                <RowDefinition Height="Auto"/>
                <!-- Source-Label (z.B. "Aus Cache") -->
                <RowDefinition Height="Auto"/>
                <!-- Teileliste -->
                <RowDefinition Height="*"/>
                <!-- Footer mit Lagerfach + Buttons -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== HEADER ===== -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0"
                       b:ImageZoom.IsEnabled="True"
                       Source="{Binding ImageUrl, Converter={StaticResource NullToImageSource}}"
                       Stretch="Uniform"
                       Width="96"
                       Height="96"
                       HorizontalAlignment="Left" VerticalAlignment="Top"/>

                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock Text="{Binding Name}"
                               FontSize="13" FontWeight="SemiBold"
                               TextWrapping="Wrap"/>

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="BL:" Foreground="Gray"
                                   FontSize="10"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding BricklinkId}"
                                   FontSize="10"
                                   FontFamily="Consolas"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Jahr:" Foreground="Gray"
                                   FontSize="10"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding YearReleased, TargetNullValue=-}"
                                   FontSize="10"/>
                    </Grid>

                    <TextBlock Text="{Binding PartsHeaderLabel}"
                               FontSize="10"
                               Foreground="Gray" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>

            <Separator Grid.Row="1" Margin="0,8"/>

            <TextBlock Grid.Row="2"
                       Text="{Binding SourceLabel}"
                       FontSize="10"
                       FontStyle="Italic" Foreground="Gray"
                       Margin="0,0,0,4"/>

            <!-- ===== TEILELISTE =====
                 UX X.30 (v0.1.17): MaxHeight=320 entfernt damit die Liste den
                 verfuegbaren Platz nutzt wenn der User den horizontalen
                 Splitter nach unten zieht. KEIN MinHeight - der Grid.Row="*"-
                 Layout schrumpft die Liste automatisch wenn das Feld kleiner
                 wird, ScrollViewer scrollt dann mehr. Footer (Beschreibung +
                 Lagerfach + Buttons) bleibt dank Grid.Row="4" Height="Auto"
                 immer sichtbar. -->
            <ScrollViewer Grid.Row="3"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Parts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!--
                                Padding-Right=18 reserviert Platz neben der vertikalen
                                ScrollBar (System-Default ~17px, skaliert mit UI-Density)
                                damit die Quantity-Spalte rechts nicht mehr darunter
                                verschwindet. Untere Trenn-Linie laeuft trotzdem durch.
                            -->
                            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="6,6,18,6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush"
                                                Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCollected}" Value="True">
                                                <!-- Linker gruener Balken + dezenter Hintergrund -->
                                                <Setter Property="BorderBrush" Value="#4CAF50"/>
                                                <Setter Property="BorderThickness" Value="3,0,0,1"/>
                                                <Setter Property="Background" Value="#1A4CAF50"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <!-- Checkbox (in Phase 5 aktivierbar) -->
                                        <ColumnDefinition Width="Auto"/>
                                        <!-- Teil-Bild -->
                                        <ColumnDefinition Width="80"/>
                                        <!-- Beschreibung -->
                                        <ColumnDefinition Width="*"/>
                                        <!-- Quantity -->
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsCollected, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              ToolTip="Markieren wenn du dieses Teil bereits hast - beim &quot;In Fach legen&quot; wird es als &quot;gesammelt&quot; uebernommen."/>

                                    <Image Grid.Column="1"
                                           Source="{Binding ImageUrl, Converter={StaticResource NullToImageSource}}"
                                           Stretch="Uniform"
                                           Width="48"
                                           Height="48"
                                           Margin="8,0"
                                           b:ImageZoom.IsEnabled="True"/>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PartName}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding PartDisplayLabel}"
                                                   Foreground="Gray"
                                                   FontSize="10"
                                                   FontFamily="Consolas"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <Border Width="14"
                                                    Height="14"
                                                    Background="{Binding SwatchBrush}"
                                                    BorderBrush="Black" BorderThickness="1"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding ColorDisplayLabel}"
                                                       FontSize="10"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <!-- Alt-Teil-Hinweis (Match-Group) - nur sichtbar wenn IsAlternate=true -->
                                        <TextBlock Text="{Binding AlternateLabel}"
                                                   FontSize="9"
                                                   Foreground="#FF8000"
                                                   FontStyle="Italic" Margin="0,2,0,0"
                                                   Visibility="{Binding IsAlternate, Converter={StaticResource BoolToVisibility}}"/>
                                    </StackPanel>

                                    <!--
                                        Quantity-Spalte: zeigt das benoetigte "x N",
                                        einen Fortschritt "(2/3)" wenn schon teilweise
                                        gesammelt, und den "Aus Fach uebernehmen"-Button
                                        falls ein passender FloatingPart existiert.
                                    -->
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center"
                                                HorizontalAlignment="Right">
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding QuantityLabel}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding QuantityProgressLabel}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource StatusSuccessBrush}"
                                                       FontWeight="SemiBold"
                                                       Margin="6,0,0,0"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- "Aus Fach uebernehmen"-Button - nur sichtbar
                                             wenn FloatingPart vorhanden UND noch was gebraucht wird. -->
                                        <Button Content="📦 Aus Fach"
                                                Click="TakeFromBin_Click"
                                                Tag="{Binding}"
                                                Margin="0,4,0,0"
                                                Padding="6,2"
                                                FontSize="11"
                                                HorizontalAlignment="Right"
                                                ToolTip="Ein Exemplar aus dem Lagerfach in diese Figur uebernehmen"
                                                Visibility="{Binding IsTransferButtonVisible,
                                                             Converter={StaticResource BoolToVisibility}}"/>

                                        <!-- Bin-Label-Hinweis: "📦 Box 003 (3x)" -->
                                        <TextBlock FontSize="10" Foreground="Gray"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,2,0,0"
                                                   Visibility="{Binding IsTransferButtonVisible,
                                                                Converter={StaticResource BoolToVisibility}}">
                                            <Run Text="{Binding MatchingFloatingPartBinLabel, Mode=OneWay}"/>
                                            <Run Text=" ("/><Run Text="{Binding MatchingFloatingPartQuantity, Mode=OneWay}"/><Run Text="x)"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- ===== FOOTER ===== -->
            <StackPanel Grid.Row="4" Margin="0,12,0,0">

                <!-- Notizen-Feld -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- UX X.30 (v0.1.17): "Notizen" -> "Beschreibung".
                         Klarer Hinweis dass das Feld beim BSX-Export im
                         oeffentlichen Comments-Feld landet (sichtbar fuer
                         Kaeufer auf BrickLink), nicht im internen
                         Remarks-Feld. Internes DB-Feld heisst weiter
                         UserNotes (kein Schema-Change noetig). -->
                    <TextBlock Grid.Column="0" Text="Beschreibung:"
                               VerticalAlignment="Top" Margin="0,4,8,0"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding UserNotes, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             Height="40" VerticalScrollBarVisibility="Auto"
                             ToolTip="Oeffentliche Beschreibung fuer den BrickLink-Verkauf (z.B. 'kleiner Riss am Helm', 'Helm fehlt original'). Wird beim BSX-Export im Comments-Feld hinterlegt und ist fuer Kaeufer sichtbar."/>
                </Grid>

                <!--
                    UX X.20 Teil 4: Lagerfach-Bereich prominenter. Akzentfarben-
                    Border um Dropdown + Aktionen, Box-Icon vor dem Label,
                    groesseres Dropdown (MinHeight 34, FontSize 13) - der User
                    sieht jetzt klar dass das die naechste Entscheidung ist.
                -->
                <Border Background="{StaticResource InfoBoxBackground}"
                        BorderBrush="{StaticResource StatusInfoBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource StatusInfoBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0">
                            <Run Text="📦"/>
                            <Run Text="Lagerfach:"/>
                        </TextBlock>
                        <ComboBox Grid.Column="1" MinHeight="34" FontSize="13"
                                  ItemsSource="{Binding AvailableBins}"
                                  SelectedItem="{Binding SelectedBin}"
                                  DisplayMemberPath="Label"
                                  ToolTip="Fach in das die Figur gelegt wird (Default: erstes freies Fach)"/>

                        <!-- Buttons rechtsbuendig -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                    HorizontalAlignment="Right" Margin="12,0,0,0">
                            <Button Content="Verwerfen" Width="100" MinHeight="34"
                                    Click="Discard_Click"
                                    Margin="0,0,8,0"/>
                            <Button Content="{Binding PersistButtonText}" MinWidth="160" MinHeight="34"
                                    Style="{StaticResource AccentButtonStyle}"
                                    IsEnabled="{Binding CanPersist}"
                                    Click="Persist_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
