<Window x:Class="HBSort.Views.BlReserveDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        ToolTipService.IsEnabled="{DynamicResource TooltipsEnabled}"
        Icon="../Resources/app.ico"
        Title="BrickLink-Lot reservieren"
        SizeToContent="Height"
        Width="520"
        MaxHeight="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <!--
        v0.1.24-beta.8 Phase 3 (Fix 3): Reservierungs-Dialog listet Lots
        einzeln auf (gruppiert nach Condition: Neu / Gebraucht). Pro Lot
        eine Karte mit Shop-Position (Remarks) + verfuegbare Menge. Klick
        auf eine Lot-Karte reserviert genau dieses Lot.
    -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding HeaderLine}"
                   FontSize="14" FontWeight="SemiBold"
                   TextWrapping="Wrap" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="1" Text="{Binding BodyLine}"
                   TextWrapping="Wrap" Margin="0,0,0,12"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Neu-Sektion -->
                <StackPanel Visibility="{Binding HasNew, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Neu" FontWeight="SemiBold" FontSize="13"
                               Foreground="#2E7D32" Margin="0,0,0,4"/>
                    <ItemsControl ItemsSource="{Binding NewLots}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                        BorderThickness="1" CornerRadius="4"
                                        Padding="10,6" Margin="0,2"
                                        Cursor="Hand"
                                        Background="#F1F8E9"
                                        Tag="{Binding}"
                                        MouseLeftButtonUp="LotCard_Click"
                                        ToolTip="Klicken um dieses Lot zu reservieren.">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding LocationDisplay}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding QuantityDisplay}"
                                                   FontFamily="Consolas"
                                                   Foreground="#2E7D32"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Gebraucht-Sektion -->
                <StackPanel Margin="0,8,0,0"
                            Visibility="{Binding HasUsed, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Gebraucht" FontWeight="SemiBold" FontSize="13"
                               Foreground="#EF6C00" Margin="0,0,0,4"/>
                    <ItemsControl ItemsSource="{Binding UsedLots}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                        BorderThickness="1" CornerRadius="4"
                                        Padding="10,6" Margin="0,2"
                                        Cursor="Hand"
                                        Background="#FFF3E0"
                                        Tag="{Binding}"
                                        MouseLeftButtonUp="LotCard_Click"
                                        ToolTip="Klicken um dieses Lot zu reservieren.">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding LocationDisplay}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding QuantityDisplay}"
                                                   FontFamily="Consolas"
                                                   Foreground="#EF6C00"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1"
                    Content="Abbrechen"
                    Click="Cancel_Click"
                    IsCancel="True"
                    MinWidth="100"/>
        </Grid>
    </Grid>
</Window>
