<UserControl x:Class="HBSort.Views.LiveStatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        PROMPT 11: Live-Stats-Tab. DataContext = LiveStatsViewModel.
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
        <StackPanel>
            <TextBlock Text="LIVE-STATS" FontSize="14" FontWeight="SemiBold"
                       Margin="0,0,0,8"/>

            <TextBlock Text="Heute" FontWeight="SemiBold" Foreground="{StaticResource StatusInfoBrush}"
                       Margin="0,4,0,4"/>
            <UniformGrid Columns="3" Margin="0,0,0,12">
                <Border BorderBrush="Gray" BorderThickness="1"
                        CornerRadius="4" Padding="8" Margin="0,0,4,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Scans" FontSize="10" Foreground="Gray"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding ScansToday}"
                                   FontSize="20" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border BorderBrush="Gray" BorderThickness="1"
                        CornerRadius="4" Padding="8" Margin="2,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Komplett" FontSize="10" Foreground="Gray"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding CompletedToday}"
                                   FontSize="20" FontWeight="SemiBold"
                                   Foreground="{StaticResource StatusSuccessBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border BorderBrush="Gray" BorderThickness="1"
                        CornerRadius="4" Padding="8" Margin="4,0,0,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Zerlegt" FontSize="10" Foreground="Gray"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding DismantledToday}"
                                   FontSize="20" FontWeight="SemiBold"
                                   Foreground="{StaticResource StatusWarningBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock Text="{Binding StreakText}"
                       FontStyle="Italic" Foreground="{StaticResource StatusInfoBrush}"
                       Margin="0,0,0,12"/>

            <TextBlock Text="Letzte 7 Tage" FontWeight="SemiBold"
                       Foreground="{StaticResource StatusInfoBrush}" Margin="0,4,0,4"/>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Scans:"/>
                <TextBlock Grid.Row="0" Grid.Column="1"
                           Text="{Binding ScansLast7Days}" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Komplett:"/>
                <TextBlock Grid.Row="1" Grid.Column="1"
                           Text="{Binding CompletedLast7Days}" FontWeight="SemiBold"
                           Foreground="{StaticResource StatusSuccessBrush}"/>
            </Grid>

            <Separator Margin="0,8"/>

            <TextBlock Text="Aktueller Bestand" FontWeight="SemiBold"
                       Foreground="{StaticResource StatusInfoBrush}" Margin="0,4,0,4"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Wartende Figuren:"/>
                <TextBlock Grid.Row="0" Grid.Column="1"
                           Text="{Binding CurrentWaitingCount}" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Komplette Figuren:"/>
                <TextBlock Grid.Row="1" Grid.Column="1"
                           Text="{Binding CurrentCompleteCount}" FontWeight="SemiBold"
                           Foreground="{StaticResource StatusSuccessBrush}"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Einzelteile:"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="{Binding CurrentFloatingEntries}" FontWeight="SemiBold"/>
                    <TextBlock Text=" Eintraege, "/>
                    <TextBlock Text="{Binding CurrentFloatingTotal}" FontWeight="SemiBold"/>
                    <TextBlock Text=" Stueck"/>
                </StackPanel>
            </Grid>

            <!-- UX X.30 (v0.1.17) Block C: Lagerfach-Auslastung. -->
            <Separator Margin="0,8"/>
            <TextBlock Text="Lagerfaecher" FontWeight="SemiBold"
                       Foreground="{StaticResource StatusInfoBrush}" Margin="0,4,0,4"/>
            <TextBlock Text="{Binding BinsOccupancyText}"
                       Margin="0,0,0,4"/>
            <ProgressBar Maximum="100"
                         Value="{Binding BinsOccupiedPercent, Mode=OneWay}"
                         Height="12"
                         Margin="0,0,0,8"
                         ToolTip="Anteil der Lagerfaecher mit Inhalt"/>
            <TextBlock Text="Top 5 nach Belegung:"
                       FontStyle="Italic" Foreground="Gray"
                       Margin="0,4,0,4"/>
            <ItemsControl ItemsSource="{Binding TopBins}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Display}" Margin="8,2,0,0"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="(noch keine belegten Faecher)"
                       FontStyle="Italic" Foreground="Gray" Margin="8,2,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding TopBins.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- UX X.30 (v0.1.17) Block C: Letzte Komplettierungen. -->
            <Separator Margin="0,8"/>
            <TextBlock Text="Letzte Komplettierungen" FontWeight="SemiBold"
                       Foreground="{StaticResource StatusInfoBrush}" Margin="0,4,0,4"/>
            <ItemsControl ItemsSource="{Binding LastCompletions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Display}" Margin="8,2,0,0" TextTrimming="CharacterEllipsis"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="(noch keine Figur komplett)"
                       FontStyle="Italic" Foreground="Gray" Margin="8,2,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LastCompletions.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</UserControl>
