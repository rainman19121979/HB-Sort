<Window x:Class="HBSort.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        Title="HB-Sort"
        Width="480" Height="320"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent">

    <!--
        Splash-Screen beim App-Start (UX-Iteration X.23).
        - Randlos, zentriert, nicht in der Taskleiste.
        - Wird in App.xaml.cs vor dem MainWindow gezeigt und nach mind.
          800ms wieder geschlossen sobald MainWindow ready ist.
        - Topmost=True damit der Splash nicht hinter andere App-Fenster
          verschwindet wenn das System langsam aufbaut.
    -->

    <!-- Border mit weichem Schatten + abgerundeten Ecken. AllowsTransparency
         braucht Window.Background=Transparent damit nur der Border-Inhalt
         sichtbar ist. -->
    <Border CornerRadius="8"
            Background="White"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.3"/>
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <!-- Logo + Titel -->
                <RowDefinition Height="*"/>
                <!-- ProgressRing + Status -->
                <RowDefinition Height="Auto"/>
                <!-- Footer -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Mitte: Logo + Titel + Version -->
            <StackPanel Grid.Row="0"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <Image Source="pack://application:,,,/Resources/logo.png"
                       Width="96" Height="96"
                       Margin="0,0,0,12"/>
                <TextBlock Text="HB-Sort"
                           FontSize="28" FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Foreground="#222"/>
                <TextBlock x:Name="VersionLabel"
                           Text="v0.0.0"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Foreground="Gray"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- ProgressRing als Lade-Indikator. v0.1.5 (2026-05-06):
                 Status-Text von 'Wird geladen...' auf 'App startet...'
                 geaendert - sichtbarer Marker fuer Auto-Update-Badge-
                 Verifikation (UX X.23 Final-Verifikation). -->
            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,12,0,12">
                <ui:ProgressRing IsActive="True"
                                 Width="20" Height="20"/>
                <TextBlock Text="App startet..."
                           FontSize="12"
                           Foreground="Gray"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"/>
            </StackPanel>

            <!-- Footer. v0.1.2 (2026-05-06): Wort "Powered by" entfernt fuer
                 Auto-Update-Verifikation - sichtbarer Marker dass das Update
                 von v0.1.1 auf v0.1.2 wirklich angewendet wurde. -->
            <TextBlock Grid.Row="2"
                       Text="Brickognize · BrickStore-DB · BrickLink"
                       FontSize="10"
                       HorizontalAlignment="Center"
                       Foreground="#999"/>
        </Grid>
    </Border>
</Window>
