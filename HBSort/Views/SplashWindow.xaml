<Window x:Class="HBSort.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="HB-Sort"
        Icon="../Resources/app.ico"
        Width="540" Height="300"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True">
    <!--
        SplashWindow: zeigt waehrend des Catalog-Imports (beim ersten Start)
        eine Progress-Bar mit Status-Text. Schliesst sich nach Erfolg automatisch.
        Bei Fehler kommt ein "Erneut versuchen"-Button.
    -->

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- Titel -->
            <RowDefinition Height="Auto"/>
            <!-- Beschreibung -->
            <RowDefinition Height="Auto"/>
            <!-- Spacer -->
            <RowDefinition Height="*"/>
            <!-- Progress-Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Status-Text -->
            <RowDefinition Height="Auto"/>
            <!-- Schritt-Text -->
            <RowDefinition Height="Auto"/>
            <!-- Fehler-Bereich (eigene Zeile, ueberlagert nichts) -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Titel-Zeile mit Logo links + Text rechts -->
        <StackPanel Grid.Row="0" Orientation="Horizontal"
                    Margin="0,0,0,4">
            <Image Source="../Resources/logo.png"
                   Width="64" Height="64"
                   Margin="0,0,12,0"
                   VerticalAlignment="Center"/>
            <TextBlock Text="HB-Sort"
                       FontSize="24" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <TextBlock Grid.Row="1"
                   Text="Erstinitialisierung des Katalogs (ca. 30-90 Sekunden)..."
                   Foreground="Gray" FontSize="13"
                   TextWrapping="Wrap"/>

        <!-- Progress-Bar -->
        <ProgressBar Grid.Row="3"
                     Height="14"
                     Minimum="0" Maximum="100"
                     Value="{Binding ProgressPercent, Mode=OneWay}"
                     Margin="0,0,0,8"/>

        <!-- Status-Text -->
        <TextBlock Grid.Row="4"
                   Text="{Binding StatusText}"
                   FontSize="13"
                   Margin="0,0,0,4"
                   TextTrimming="CharacterEllipsis"/>

        <TextBlock Grid.Row="5"
                   Text="{Binding StepText}"
                   FontSize="11" Foreground="Gray"/>

        <!-- Fehler-Bereich (nur sichtbar wenn HasError) -->
        <StackPanel Grid.Row="6"
                    Margin="0,16,0,0"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="Red" FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Beenden"
                        Width="120" Margin="0,0,8,0"
                        Click="Cancel_Click"/>
                <Button Content="Erneut versuchen"
                        Width="160"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="Retry_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
