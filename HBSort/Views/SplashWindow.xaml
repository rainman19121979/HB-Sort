<Window x:Class="HBSort.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        Title="HB-Sort"
        Width="480" Height="320"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="False"
        Background="Transparent">

    <!--
        Splash-Screen beim App-Start (UX-Iteration X.23).
        - Randlos, zentriert, nicht in der Taskleiste.
        - Wird in App.xaml.cs vor dem MainWindow gezeigt und nach mind.
          800ms wieder geschlossen sobald MainWindow ready ist.
        - UX X.34 v0.1.20-beta.3 Bug-Fix: Topmost=False. Vorher True war
          die Ursache dass der FirstRunDialog (modaler Welcome-Dialog beim
          ersten Start) ueber dem Splash erschien aber dahinter verdeckt
          war - WPF haelt Topmost-Z-Order auch kurz nach Close() noch im
          Compositor, besonders mit AllowsTransparency=True. Splash ist
          eh das einzige Window in der Startup-Phase, Topmost ist also
          ueberfluessig.
    -->

    <!-- Border mit weichem Schatten + abgerundeten Ecken. AllowsTransparency
         braucht Window.Background=Transparent damit nur der Border-Inhalt
         sichtbar ist. -->
    <Border CornerRadius="8"
            Background="White"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.3"/>
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <!-- Logo + Titel -->
                <RowDefinition Height="*"/>
                <!-- ProgressRing + Status -->
                <RowDefinition Height="Auto"/>
                <!-- Footer -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Mitte: Logo + Titel + Version -->
            <StackPanel Grid.Row="0"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <Image Source="pack://application:,,,/Resources/logo.png"
                       Width="96" Height="96"
                       Margin="0,0,0,12"/>
                <TextBlock Text="HB-Sort"
                           FontSize="28" FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Foreground="#222"/>
                <TextBlock x:Name="VersionLabel"
                           Text="v0.0.0"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Foreground="Gray"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- ProgressRing als Lade-Indikator.
                 v0.1.12 (2026-05-07): Status-Text von 'App startet...'
                 auf 'Bereitet App vor...' geaendert - sichtbarer Marker
                 fuer Update-Badge-Trigger nach Opacity-Fix in v0.1.11. -->
            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,12,0,12">
                <ui:ProgressRing IsActive="True"
                                 Width="20" Height="20"/>
                <!-- v0.1.22-beta.1 Block A: Status-Text als x:Name damit Application_Startup
                     ihn waehrend der Init-Schritte aktualisieren kann (App-Start, Cache,
                     DataHeal, Catalog-Update, MainWindow). -->
                <TextBlock x:Name="StatusLabel"
                           Text="Bereitet App vor..."
                           FontSize="12"
                           Foreground="Gray"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"
                           MinWidth="220"/>
            </StackPanel>

            <!-- Footer. v0.1.10 (2026-05-07): Reihenfolge der Drittanbieter
                 alphabetisch sortiert - sichtbarer Marker fuer Update-Badge-
                 Praxis-Test (UX X.24 Opacity-Fix-Verifikation v0.1.9 -> v0.1.10). -->
            <TextBlock Grid.Row="2"
                       Text="BrickLink · Brickognize · BrickStore-DB"
                       FontSize="10"
                       HorizontalAlignment="Center"
                       Foreground="#999"/>
        </Grid>
    </Border>
</Window>
