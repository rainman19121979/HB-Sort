<Window x:Class="HBSort.Views.BinBulkCreateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Lagerfaecher anlegen (Bulk)"
        Icon="../Resources/app.ico"
        Width="500" Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Praefix + Suffix -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Praefix:" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1"
                     Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>
        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Suffix:" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1"
                     Text="{Binding Suffix, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>

        <!-- Typ-Auswahl -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock Text="Typ:" VerticalAlignment="Center" Width="100"/>
            <RadioButton Content="Zahlen"
                         IsChecked="{Binding IsNumbers, Mode=OneWay}"
                         Click="TypeNumbers_Click"
                         GroupName="BinSeq" Margin="0,0,16,0"/>
            <RadioButton Content="Buchstaben"
                         IsChecked="{Binding IsLetters, Mode=OneWay}"
                         Click="TypeLetters_Click"
                         GroupName="BinSeq"/>
        </StackPanel>

        <!-- Bereich -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Bereich:" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1"
                     Text="{Binding StartStr, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Start-Wert (z.B. '1' oder 'A')"/>
            <TextBlock Grid.Column="2" Text=" bis " VerticalAlignment="Center" Margin="8,0"/>
            <TextBox Grid.Column="3"
                     Text="{Binding EndStr, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Ende-Wert (z.B. '20' oder 'F')"/>
        </Grid>

        <!-- Padding (nur bei Zahlen sinnvoll) -->
        <Grid Grid.Row="4" Margin="0,12,0,0"
              Visibility="{Binding IsNumbers, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Padding:" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1"
                     Text="{Binding Padding, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Mindestlaenge der Zahl (mit fuehrenden Nullen)"/>
            <TextBlock Grid.Column="2" Text="Stellen (0 = keine fuehrenden Nullen)"
                       Foreground="Gray" VerticalAlignment="Center" Margin="8,0,0,0"
                       FontSize="11"/>
        </Grid>

        <!-- Validation -->
        <TextBlock Grid.Row="5"
                   Text="{Binding ValidationMessage}"
                   Foreground="Red" FontSize="11" Margin="0,8,0,0"
                   TextWrapping="Wrap"/>

        <!-- Vorschau -->
        <Border Grid.Row="6" Margin="0,12,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="1" CornerRadius="4" Padding="10">
            <StackPanel>
                <TextBlock Text="Vorschau" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ItemsControl ItemsSource="{Binding PreviewItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontFamily="Consolas" FontSize="12"
                                       Text="{Binding StringFormat='→ {0}'}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="7"
                   Text="{Binding SummaryText}"
                   Margin="0,8,0,0"
                   FontStyle="Italic" Foreground="Gray"/>

        <StackPanel Grid.Row="8" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Abbrechen" IsCancel="True" Width="100" Margin="0,0,8,0"
                    Click="Cancel_Click"/>
            <Button Content="Anlegen" IsDefault="True" Width="100"
                    Style="{StaticResource AccentButtonStyle}"
                    IsEnabled="{Binding CanCreate}"
                    Click="Create_Click"/>
        </StackPanel>
    </Grid>
</Window>
