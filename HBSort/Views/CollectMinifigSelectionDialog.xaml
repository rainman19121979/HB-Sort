<Window x:Class="HBSort.Views.CollectMinifigSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:b="clr-namespace:HBSort.Behaviors"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Figur anlegen"
        ToolTipService.IsEnabled="{DynamicResource TooltipsEnabled}"
        Icon="../Resources/app.ico"
        Width="640" Height="600"
        MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <!--
        UX X.32 v0.1.19-beta.4 Block D: Auswahl-Dialog vor "Diese Figur anlegen".
        User markiert / demarkiert Teile die beim Anlegen aus dem Floating-Pool
        gezogen werden sollen. Trigger-Teil ist immer markiert (Checkbox
        deaktiviert).

        Layout: Header (Bild + Name + BL-Id) - Liste der Teile mit Checkbox
        und Status-Label - Footer mit Verwerfen / Figur anlegen.
    -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>     <!-- Header -->
            <RowDefinition Height="Auto"/>     <!-- Trenner -->
            <RowDefinition Height="Auto"/>     <!-- Erklaerungs-Hint -->
            <RowDefinition Height="*"/>        <!-- Teile-Liste -->
            <RowDefinition Height="Auto"/>     <!-- Lagerfach-Picker -->
            <RowDefinition Height="Auto"/>     <!-- Volle-Faecher-Banner (v0.1.22 Block D) -->
            <RowDefinition Height="Auto"/>     <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- Header: Bild links + Name+BL-Id rechts -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="80" Height="80"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1" CornerRadius="4"
                    Margin="0,0,12,0">
                <Image Source="{Binding ImageUrl, Converter={StaticResource NullToImageSource}}"
                       Stretch="Uniform"
                       b:ImageZoom.IsEnabled="True"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock>
                    <Run Text="Figur "/>
                    <Run Text="&quot;"/>
                    <Run Text="{Binding MinifigName, Mode=OneWay}" FontWeight="SemiBold"/>
                    <Run Text="&quot;"/>
                    <Run Text=" anlegen"/>
                </TextBlock>
                <TextBlock Foreground="Gray" FontSize="11">
                    <Run Text="BL:"/>
                    <Run Text="{Binding BricklinkId, Mode=OneWay}" FontFamily="Consolas"/>
                </TextBlock>
            </StackPanel>
        </Grid>

        <Separator Grid.Row="1" Margin="0,8"/>

        <!-- Hinweis-Block: was passiert beim Klick -->
        <TextBlock Grid.Row="2" TextWrapping="Wrap" Foreground="Gray" FontSize="11"
                   Margin="0,0,0,8">
            Markiere die Teile die du fuer diese Figur zur Verfuegung hast oder aus
            deinem Lager nehmen willst. Vor-Markierung: Teile die schon im Lager
            liegen (gruen) und das gerade gescannte Trigger-Teil (gelb). Demarkierte
            Teile bleiben in ihrem Fach und die Figur wartet weiter darauf.
        </TextBlock>

        <!-- Teile-Liste -->
        <Border Grid.Row="3"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="1" CornerRadius="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Parts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                    BorderThickness="0,0,0,1" Padding="8,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsKept, Mode=TwoWay,
                                                                  UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding IsCheckBoxEnabled}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,12,0"
                                              ToolTip="Aktiv: Teil wird beim Anlegen aus dem Lager genommen / als Trigger eingetragen."/>

                                    <Image Grid.Column="1"
                                           Source="{Binding ImageUrl, Converter={StaticResource NullToImageSource}}"
                                           Width="40" Height="40"
                                           Stretch="Uniform"
                                           Margin="0,0,8,0"
                                           b:ImageZoom.IsEnabled="True"/>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayLabel}"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding StatusText}"
                                                   Foreground="{Binding StatusBrush}"
                                                   FontSize="11"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="3"
                                               Text="{Binding QuantityNeeded, StringFormat='x{0}'}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0"
                                               Foreground="Gray"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!--
            UX X.32 v0.1.19-beta.4 (User-Befund): Lagerfach-Auswahl im Dialog.
            Default = wartende-Figur-Vorschlag aus dem StorageBinService -
            also NICHT das Floating-Bin des gerade gescannten Teils.
        -->
        <Border Grid.Row="4"
                Background="{StaticResource InfoBoxBackground}"
                BorderBrush="{StaticResource StatusInfoBrush}"
                BorderThickness="1" CornerRadius="4"
                Padding="10" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource StatusInfoBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0">
                    <Run Text="📦"/>
                    <Run Text="Lagerfach:"/>
                </TextBlock>
                <ComboBox Grid.Column="1" MinHeight="34" FontSize="13"
                          ItemsSource="{Binding AvailableBins}"
                          SelectedItem="{Binding SelectedBin}"
                          DisplayMemberPath="Label"
                          ToolTip="Fach in das die neue wartende Figur gelegt wird (Default: erstes wirklich freies Fach)."/>
            </Grid>
        </Border>

        <!--
            v0.1.22-beta.1 Block D: Konsistenz-Banner zu Block K (Volle-Faecher-
            Warnung in MinifigDetail / PartLookup / DismantleWizard / Build-
            Suggestion). Sichtbar wenn der Suggest-Service nichts liefert und
            alle Faecher belegt sind. Im Gegensatz zu BuildSuggestion KEIN
            "Lagerfach-Verwaltung oeffnen"-Button - User schliesst den Dialog
            via "Verwerfen" und macht es selbst (Spec-Entscheidung KISS).
        -->
        <Border Grid.Row="5"
                Background="#FFF4E5" BorderBrush="#E65100"
                BorderThickness="1" CornerRadius="4" Padding="10"
                Margin="0,8,0,0"
                Visibility="{Binding IsAllBinsFullBannerVisible, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Alle Lagerfaecher sind belegt. Bitte ein neues Fach anlegen oder ein bestehendes leeren."
                       TextWrapping="Wrap" VerticalAlignment="Center"
                       FontWeight="SemiBold" Foreground="#E65100"/>
        </Border>

        <!-- Footer-Buttons -->
        <StackPanel Grid.Row="6" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Verwerfen" IsCancel="True"
                    MinWidth="100" Margin="0,0,8,0"
                    Click="Cancel_Click"/>
            <Button Content="Figur anlegen"
                    MinWidth="140"
                    Style="{StaticResource AccentButtonStyle}"
                    IsDefault="True"
                    Click="Confirm_Click"/>
        </StackPanel>
    </Grid>
</Window>
