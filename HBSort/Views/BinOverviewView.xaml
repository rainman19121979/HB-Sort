<UserControl x:Class="HBSort.Views.BinOverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:HBSort.Behaviors">
    <!--
        Phase X.3 (PROMPT 11): Lagerfach-Uebersicht als eigenstaendiges UserControl.
        Bisheriger Inhalt 1:1 aus SortingView (R2,C2) extrahiert; jetzt einer von
        5 Tabs im variablen Feld unten rechts.

        DataContext = WaitingMinifigsViewModel (vom umschliessenden TabItem gesetzt).
    -->
    <Grid Margin="{DynamicResource BorderPadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="LAGERFAECHER"
                       FontSize="{DynamicResource HeaderFontSize}" FontWeight="SemiBold"/>
            <Button Grid.Column="1" Content="↻" Width="28" Padding="0"
                    ToolTip="Laed die Lagerfach-Liste aus der DB neu."
                    Command="{Binding RefreshCommand}"/>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="Anzeigen:" Foreground="Gray"
                       VerticalAlignment="Center" Margin="0,0,8,0"
                       FontSize="{DynamicResource MicroFontSize}"/>
            <RadioButton Content="Nur belegt"
                         IsChecked="{Binding IsFilterOccupiedOnly, Mode=OneWay}"
                         Click="BinFilterOccupied_Click"
                         GroupName="BinOverviewFilter" Margin="0,0,12,0"
                         VerticalAlignment="Center"
                         ToolTip="Zeigt nur Faecher mit Inhalt (mind. eine Figur oder ein Floating-Part)."/>
            <RadioButton Content="Alle"
                         IsChecked="{Binding IsFilterAll, Mode=OneWay}"
                         Click="BinFilterAll_Click"
                         GroupName="BinOverviewFilter"
                         VerticalAlignment="Center"
                         ToolTip="Zeigt alle Faecher inkl. der freien."/>
        </StackPanel>

        <TextBlock Grid.Row="2"
                   Text="Keine Faecher zur Anzeige. Wechsle auf 'Alle' oder lege Faecher in den Einstellungen an."
                   Foreground="Gray" FontStyle="Italic" TextWrapping="Wrap"
                   VerticalAlignment="Top"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Bins}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                BorderThickness="1" CornerRadius="4"
                                Padding="0" Margin="0,2,0,4">
                            <StackPanel>
                                <Button Click="BinHeader_Click" Tag="{Binding}"
                                        Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                                        BorderBrush="Transparent"
                                        HorizontalContentAlignment="Stretch"
                                        Padding="6,4" Cursor="Hand"
                                        ToolTip="Klick zum Auf-/Zuklappen dieses Fachs.">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding ExpandIcon}"
                                                   VerticalAlignment="Center" Margin="0,0,6,0"
                                                   FontSize="{DynamicResource MicroFontSize}"/>
                                        <TextBlock Grid.Column="1" Text="📦"
                                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Label}"
                                                   FontWeight="SemiBold"
                                                   FontSize="{DynamicResource DetailFontSize}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding StatusText}"
                                                   FontSize="{DynamicResource MicroFontSize}"
                                                   Foreground="Gray"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                                   ToolTip="Inhalt dieses Fachs (wartend / komplett / Einzelteile)."/>
                                        <Button Grid.Column="4" Content="📋" Width="28" Padding="0"
                                                Click="BinShowDetailFromOverview_Click"
                                                Tag="{Binding}"
                                                ToolTip="Oeffnet die Detail-Ansicht mit allen Figuren und Einzelteilen in diesem Fach."/>
                                    </Grid>
                                </Button>

                                <StackPanel Margin="6,4,6,6"
                                            Visibility="{Binding IsExpanded,
                                                Converter={StaticResource BoolToVisibility}}">

                                    <ItemsControl ItemsSource="{Binding WaitingMinifigs}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Background="Transparent" BorderBrush="Transparent"
                                                        HorizontalContentAlignment="Stretch"
                                                        Click="WaitingMinifig_Click"
                                                        Tag="{Binding}"
                                                        Padding="4" Margin="0,1"
                                                        ToolTip="Oeffnet die Figur-Detail-Ansicht (Status, Teileliste, Verschieben/Zerlegen).">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="40"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Image Grid.Column="0"
                                                               Source="{Binding ImageUrl, Converter={StaticResource NullToImageSource}}"
                                                               Width="36" Height="36"
                                                               Stretch="Uniform"
                                                               b:ImageZoom.IsEnabled="True"/>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                                                    Margin="6,0">
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontSize="{DynamicResource MicroFontSize}"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding BricklinkId}"
                                                                       FontFamily="Consolas"
                                                                       FontSize="{DynamicResource MicroFontSize}"
                                                                       Foreground="Gray"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                                                    MinWidth="70">
                                                            <TextBlock Text="{Binding ProgressLabel}"
                                                                       FontSize="{DynamicResource MicroFontSize}"
                                                                       HorizontalAlignment="Right"/>
                                                            <ProgressBar Height="4" Width="64"
                                                                         Minimum="0" Maximum="1"
                                                                         Value="{Binding ProgressFraction, Mode=OneWay}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding MoreLabel}"
                                               FontSize="{DynamicResource MicroFontSize}"
                                               FontStyle="Italic" Foreground="Gray"
                                               Margin="2,4,0,0"
                                               Visibility="{Binding HasMore,
                                                   Converter={StaticResource BoolToVisibility}}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="3" Text="{Binding SummaryText}"
                   FontSize="{DynamicResource MicroFontSize}"
                   Foreground="Gray" Margin="0,4,0,0"/>
    </Grid>
</UserControl>
