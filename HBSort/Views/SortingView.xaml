<UserControl x:Class="HBSort.Views.SortingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:HBSort.Views"
             xmlns:b="clr-namespace:HBSort.Behaviors">
    <!--
        Sortier-Tab-Layout (UX X.19 Teil 3a refactor).

        Outer-Grid: 1 Row, 5 Spalten (Col / Splitter / Col / Splitter / Col).
        Jede der 3 Inhalts-Spalten ist ein eigenes Subgrid mit 3 Zeilen
        (oben / Splitter / unten), sodass die Hoehen pro Spalte unabhaengig
        verschiebbar sind.

        Persistierung (UX X.19 Teil 3b): die Splitter-Verhaeltnisse werden
        beim DragCompleted in AppSettings.SortingTabLayout gespeichert und
        beim Loaded auf die GridDefinitions angewendet (siehe Code-Behind).

        UX X.31 Block B (v0.1.18): Wrapper-Grid mit BinInstructionOverlay
        als Sibling auf ZIndex=100 - Overlay erscheint ueber dem ganzen
        Sortier-Tab nach erfolgreichem Persist.
    -->
    <Grid>
        <Grid x:Name="MainQuadrantsGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" x:Name="LeftCol"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*" x:Name="MidCol"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*" x:Name="RightCol"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Vertikale Splitter zwischen den drei Spalten ===== -->
        <GridSplitter Grid.Column="1"
                      Width="5"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="Transparent"
                      ShowsPreview="True"
                      ResizeBehavior="PreviousAndNext"
                      Cursor="SizeWE"
                      DragCompleted="VerticalSplitter1_DragCompleted"/>
        <GridSplitter Grid.Column="3"
                      Width="5"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="Transparent"
                      ShowsPreview="True"
                      ResizeBehavior="PreviousAndNext"
                      Cursor="SizeWE"
                      DragCompleted="VerticalSplitter2_DragCompleted"/>

        <!-- ============================================================ -->
        <!-- ===== SPALTE 1: Webcam (oben) + Brickognize (unten) ===== -->
        <!-- ============================================================ -->
        <Grid Grid.Column="0">
            <!-- Tester-Feedback 2026-06-08: Col1 bewusst symmetrisch (50:50), waehrend
                 Col2/Col3 weiter oben dominant sind (65:35). Webcam und Brickognize-
                 Vorschlaege gleichberechtigt, damit der Vorschlaege-Bereich beim
                 First-Run genuegend Platz fuer Treffer-Karten hat.
                 Default-Spiegelung im Code-Behind (DefaultCol1TopRatio = 0.50). -->
            <Grid.RowDefinitions>
                <RowDefinition Height="50*" x:Name="Col1TopRow"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="50*" x:Name="Col1BotRow"/>
            </Grid.RowDefinitions>

            <GridSplitter Grid.Row="1"
                          Height="5"
                          HorizontalAlignment="Stretch" VerticalAlignment="Center"
                          Background="Transparent"
                          ShowsPreview="True"
                          ResizeBehavior="PreviousAndNext"
                          Cursor="SizeNS"
                          DragCompleted="Col1HorizontalSplitter_DragCompleted"/>

            <!-- ===== OBEN: Webcam-Bereich ===== -->
            <Border Grid.Row="0"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Image Grid.Row="0"
                           Source="{Binding ScanViewModel.CurrentFrame}"
                           Stretch="Uniform"
                           MinHeight="240" MaxHeight="600"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                           ToolTip="Live-Bild deiner USB-Webcam. Halte hier Teile oder Figuren rein."/>

                    <TextBlock Grid.Row="0"
                               Text="Kein Kamerabild verfuegbar"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="16" Foreground="Gray"
                               Visibility="{Binding ScanViewModel.IsCameraRunning,
                                   Converter={StaticResource InverseBoolToVisibility}}"/>

                    <StackPanel Grid.Row="1" Margin="8">
                        <Button Content="Scannen (Leertaste)"
                                Command="{Binding ScanViewModel.PerformScanCommand}"
                                IsEnabled="{Binding ScanViewModel.CanScan}"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,4"
                                ToolTip="Druecke die Leertaste oder klick hier, um zu scannen."/>

                        <TextBlock Text="{Binding ScanViewModel.ScanStatusText}"
                                   Foreground="Gray" FontSize="12"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== UNTEN: Brickognize-Vorschlaege ===== -->
            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                    BorderThickness="1" CornerRadius="4"
                    Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="BRICKOGNIZE-VORSCHLAEGE"
                               FontSize="13" FontWeight="SemiBold"
                               Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="1"
                               Text="Hier erscheinen die Brickognize-Vorschlaege nach einem Scan"
                               Foreground="Gray" FontStyle="Italic"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding ScanViewModel.HasResults,
                                   Converter={StaticResource InverseBoolToVisibility}}"/>

                    <Grid Grid.Row="1"
                          Visibility="{Binding ScanViewModel.HasResults, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding ScanViewModel.ResultHeadlineText}"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                            <Button Grid.Column="1"
                                    Content="Manuelle Suche..."
                                    Visibility="{Binding ScanViewModel.ShowSearchFallback, Converter={StaticResource BoolToVisibility}}"
                                    Click="SearchFallback_Click"
                                    ToolTip="Oeffnet eine manuelle Suche fuer den Fall, dass Brickognize nichts erkannt hat."/>
                        </Grid>

                        <Border Grid.Row="1" Margin="0,0,0,8"
                                Padding="8"
                                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                BorderThickness="1" CornerRadius="4"
                                Visibility="{Binding ScanViewModel.HasColors,
                                     Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="Erkannte Farbe(n)"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,6"/>
                                <ItemsControl ItemsSource="{Binding ScanViewModel.RecognizedColors}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,12,0"
                                                    Padding="6,4"
                                                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="20" Height="20"
                                                            Background="{Binding SwatchBrush}"
                                                            BorderBrush="Black" BorderThickness="1"
                                                            Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding DisplayLabel}"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding ScoreText}"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"
                                                               Foreground="Gray"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!--
                            UX X.15 Teil 2: Klick-Trennung Bild-Zoom vs. Auswahl.
                            Image -> Zoom-Overlay; "Uebernehmen"-Button -> SelectCardAsync.
                        -->
                        <ItemsControl Grid.Row="2" ItemsSource="{Binding ScanViewModel.ResultCards}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" Columns="3"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4"
                                            Padding="6" Margin="4"
                                            Background="Transparent">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush"
                                                        Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsTopHit}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#4CAF50"/>
                                                        <Setter Property="BorderThickness" Value="3"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#4CAF50"/>
                                                        <Setter Property="BorderThickness" Value="3"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Image Grid.Row="0"
                                                   Source="{Binding ImageUrl, Converter={StaticResource NullToImageSource}}"
                                                   Stretch="Uniform"
                                                   MaxHeight="200"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   b:ImageZoom.IsEnabled="True"
                                                   ToolTip="Vergroessern"/>

                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding Name}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       Margin="0,8,0,0"/>

                                            <Grid Grid.Row="2" Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding TypeLabel}"
                                                           Foreground="Gray"
                                                           FontSize="10"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding ScoreText}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"/>
                                            </Grid>

                                            <TextBlock Grid.Row="3"
                                                       Text="{Binding HighlightLabel}"
                                                       FontSize="10"
                                                       Foreground="#4CAF50"
                                                       FontWeight="SemiBold" Margin="0,4,0,0"/>

                                            <!-- UX X.30 Block D Bug-Fix (v0.1.17): Hotkey-Indikator
                                                 jetzt im Button-Content selbst statt als separater
                                                 schwarzer Badge. Sauberer und User sieht den Hotkey
                                                 genau dort wo er klicken wuerde. -->
                                            <Button Grid.Row="4"
                                                    Content="{Binding UebernehmenButtonLabel}"
                                                    Tag="{Binding Rank}"
                                                    Click="SelectCard_Click"
                                                    Margin="0,6,0,0"
                                                    Padding="0,4"
                                                    HorizontalAlignment="Stretch"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    ToolTip="Diese Erkennung uebernehmen (Tastatur: Zahl 1, 2 oder 3)"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================================================ -->
        <!-- ===== SPALTE 2: MinifigDetail/PartLookup + Tab-Reihe ===== -->
        <!-- ============================================================ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="65*" x:Name="Col2TopRow"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="35*" x:Name="Col2BotRow"/>
            </Grid.RowDefinitions>

            <GridSplitter Grid.Row="1"
                          Height="5"
                          HorizontalAlignment="Stretch" VerticalAlignment="Center"
                          Background="Transparent"
                          ShowsPreview="True"
                          ResizeBehavior="PreviousAndNext"
                          Cursor="SizeNS"
                          DragCompleted="Col2HorizontalSplitter_DragCompleted"/>

            <!-- ===== OBEN: Aktive Figur (MinifigDetail/PartLookup) ===== -->
            <Border Grid.Row="0"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                    BorderThickness="1" CornerRadius="4">
                <Grid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ScanViewModel.HasPendingMinifig}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ScanViewModel.HasPendingPart}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Scanne eine Figur oder ein Teil"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="Gray"/>
                        <TextBlock Text="Druecke Leertaste oder klicke 'Scannen'"
                                   FontSize="10"
                                   Foreground="Gray"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <ContentControl Padding="6"
                                    DataContext="{Binding ScanViewModel.PendingMinifig}"
                                    Visibility="{Binding DataContext.ScanViewModel.HasPendingMinifig,
                                        RelativeSource={RelativeSource AncestorType=Grid},
                                        Converter={StaticResource BoolToVisibility}}">
                        <views:MinifigDetailView/>
                    </ContentControl>

                    <ContentControl Content="{Binding ScanViewModel.PendingPart}"
                                    Padding="6"
                                    Visibility="{Binding ScanViewModel.HasPendingPart,
                                        Converter={StaticResource BoolToVisibility}}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate>
                                <views:PartLookupView/>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </Grid>
            </Border>

            <!-- ===== UNTEN: TabControl mit 3 Ansichten =====
                 Tab-Auswahl wird via MainViewModel.BottomRightSelectedTabIndex
                 an AppSettings persistiert. -->
            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                    BorderThickness="1" CornerRadius="4"
                    Padding="0">
                <TabControl x:Name="BottomRightTabs"
                            SelectedIndex="{Binding BottomRightSelectedTabIndex, Mode=TwoWay}"
                            BorderThickness="0"
                            Background="Transparent">

                    <TabItem Header="Live-Stats"
                             ToolTip="Heutige + 7-Tage-Stats + aktueller Bestand + Streak.">
                        <ContentControl Content="{Binding LiveStats}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <views:LiveStatsView/>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                    </TabItem>

                    <TabItem Header="Wartende-Detail"
                             ToolTip="Liste aller wartenden Figuren mit den fehlenden Teilen pro Figur.">
                        <ContentControl Content="{Binding WaitingDetail}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <views:WaitingDetailView/>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                    </TabItem>

                    <TabItem Header="Letzte Scans"
                             ToolTip="Top-50 Scan-Events chronologisch absteigend.">
                        <ContentControl Content="{Binding RecentScans}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <views:RecentScansView/>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- ============================================================ -->
        <!-- ===== SPALTE 3: BuildSuggestions + MinifigPriceView ===== -->
        <!-- ============================================================ -->
        <Grid Grid.Column="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="65*" x:Name="Col3TopRow"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="35*" x:Name="Col3BotRow"/>
            </Grid.RowDefinitions>

            <GridSplitter Grid.Row="1"
                          Height="5"
                          HorizontalAlignment="Stretch" VerticalAlignment="Center"
                          Background="Transparent"
                          ShowsPreview="True"
                          ResizeBehavior="PreviousAndNext"
                          Cursor="SizeNS"
                          DragCompleted="Col3HorizontalSplitter_DragCompleted"/>

            <!-- ===== OBEN: BuildSuggestionsView ("Was kann ich bauen?") ===== -->
            <Border Grid.Row="0"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                    BorderThickness="1" CornerRadius="4"
                    Padding="0">
                <ContentControl Content="{Binding BuildSuggestions}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <views:BuildSuggestionsView/>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </Border>

            <!-- ===== UNTEN: MinifigPriceView (BL-Preise) ===== -->
            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                    BorderThickness="1" CornerRadius="4"
                    Padding="8">
                <ContentControl Content="{Binding ScanViewModel.PriceInfo}"
                                Visibility="{Binding ScanViewModel.HasMinifigPriceInfo,
                                    Converter={StaticResource BoolToVisibility}}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <views:MinifigPriceView/>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </Border>
        </Grid>
        </Grid>

        <!-- UX X.32 v0.1.19-beta.4 Block E: Sammel-Popup-Overlays sind nach
             MainWindow.xaml gewandert, damit sie tab-uebergreifend sichtbar
             sind (auch wenn Bulk-Move aus der Lagerliste sie ausloest). -->
    </Grid>
</UserControl>
