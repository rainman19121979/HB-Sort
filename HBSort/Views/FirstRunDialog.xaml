<Window x:Class="HBSort.Views.FirstRunDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Willkommen bei HB-Sort"
        ToolTipService.IsEnabled="{DynamicResource TooltipsEnabled}"
        Icon="../Resources/app.ico"
        Width="640" Height="640"
        MinWidth="540" MinHeight="540"
        WindowStartupLocation="CenterOwner">
    <!--
        UX X.34 v0.1.20-beta.2: First-Run-Onboarding-Dialog.
        Erscheint beim ersten App-Start auf einer frischen Installation
        (BL-Catalog leer und/oder keine Lagerfaecher angelegt). Zwei
        Pflicht-Schritte (Catalog + Lagerfaecher) plus ein optionaler
        Hinweis (BL-Tokens spaeter).
    -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 0: Header -->
            <RowDefinition Height="*"/>     <!-- 1: Schritte -->
            <RowDefinition Height="Auto"/>  <!-- 2: Buttons -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <!-- v0.1.24-beta.1 Phase 3 (Aufgabe I): FontSize von 22 auf
                 DialogHeaderFontSize (20) harmonisiert. Welcome-Headline
                 bleibt Bold statt SemiBold weil First-Run-Dialog absichtlich
                 etwas mehr Aufmerksamkeit zieht. -->
            <TextBlock Text="Willkommen bei HB-Sort!"
                       FontSize="{StaticResource DialogHeaderFontSize}" FontWeight="Bold"/>
            <TextBlock Text="Bevor du sortieren kannst, ein paar kurze Einrichtungsschritte:"
                       TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Schritte -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Schritt 1: BL-Catalog (PFLICHT) -->
                <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                        BorderThickness="1" CornerRadius="6"
                        Padding="14" Margin="0,0,0,8">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding CatalogStatusIcon}"
                                       FontSize="20" FontWeight="Bold"
                                       VerticalAlignment="Top"/>
                            <TextBlock Text="1. BrickLink-Catalog laden (Pflicht)"
                                       FontWeight="SemiBold" FontSize="15"/>
                        </DockPanel>
                        <TextBlock TextWrapping="Wrap" FontSize="12"
                                   Foreground="Gray" Margin="0,6,0,8"
                                   Text="HBSort holt einmalig ca. 12 MB Stammdaten (Items, Farben, Subsets) aus dem BrickStore-Datenbank-Projekt auf GitHub. Dauert je nach Verbindung 30-90 Sekunden. Ohne diese Daten kann HBSort gescannte Teile nicht zuordnen."/>

                        <Button Content="Catalog jetzt laden"
                                Command="{Binding LoadCatalogCommand}"
                                IsEnabled="{Binding CatalogButtonEnabled}"
                                HorizontalAlignment="Left"
                                Padding="14,6"
                                Style="{StaticResource AccentButtonStyle}"/>

                        <ProgressBar Value="{Binding CatalogProgress}"
                                     Maximum="100" Height="6" Margin="0,8,0,0"
                                     IsIndeterminate="False"
                                     Visibility="{Binding CatalogLoading, Converter={StaticResource BoolToVisibility}}"/>

                        <TextBlock Text="{Binding CatalogStatusText}"
                                   FontSize="11" Foreground="Gray"
                                   TextWrapping="Wrap" Margin="0,6,0,0"/>

                        <Border Background="#FFF4E5" BorderBrush="#E65100"
                                BorderThickness="1" CornerRadius="4"
                                Padding="8,6" Margin="0,8,0,0"
                                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding ErrorMessage}"
                                       Foreground="#5D2E00" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Schritt 2: Lagerfaecher (nur Hinweis, kein Action-Button -
                     User legt Bins in Ruhe nach "Loslegen" an, in den Settings). -->
                <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                        BorderThickness="1" CornerRadius="6"
                        Padding="14" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="2. Lagerfaecher anlegen (empfohlen)"
                                   FontWeight="SemiBold" FontSize="15"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12"
                                   Foreground="Gray" Margin="0,6,0,0"
                                   Text="Du brauchst physische Boxen die HBSort als 'Lagerfaecher' verwaltet. Empfehlung: starte mit 10-30 Boxen je nach Sammlungsgroesse."/>
                        <TextBlock TextWrapping="Wrap" FontSize="12"
                                   Foreground="Gray" Margin="0,6,0,0"
                                   Text="Nach 'Loslegen' kannst du sie unter Einstellungen > Lagerfaecher > 'Bulk anlegen' in einem Rutsch erzeugen (z.B. Box01-Box30)."/>
                    </StackPanel>
                </Border>

                <!-- Schritt 3: Tokens (optional) -->
                <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                        BorderThickness="1" CornerRadius="6"
                        Padding="14" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="3. BrickLink-Tokens (optional)"
                                   FontWeight="SemiBold" FontSize="15"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12"
                                   Foreground="Gray" Margin="0,6,0,0"
                                   Text="Fuer Live-Preise und Verkaufsempfehlungen. Brauchst du nicht zum Sortieren - kannst du jederzeit unter Einstellungen > BrickLink > API-Zugang einrichten."/>
                    </StackPanel>
                </Border>

                <!-- Hinweis Brickognize -->
                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="Gray"
                           Margin="0,8,0,0"
                           Text="Tipp: Brickognize (die Erkennungs-API fuer Webcam-Scans) braucht keinen Setup - die ist sofort einsatzbereit, sobald du Catalog + Lagerfaecher hast."/>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Spaeter erinnern" IsCancel="True"
                    Click="Dismiss_Click"
                    Width="140" Margin="0,0,8,0"
                    ToolTip="Schliesst den Dialog. Beim naechsten Start erscheint er wieder solange das Setup nicht komplett ist."/>
            <Button Content="Loslegen"
                    Click="Start_Click"
                    IsEnabled="{Binding StartButtonEnabled}"
                    Width="120"
                    Style="{StaticResource AccentButtonStyle}"
                    IsDefault="True"
                    ToolTip="Schliesst den Dialog und merkt sich dass das Setup fertig ist - er erscheint dann nicht mehr beim Start."/>
        </StackPanel>
    </Grid>
</Window>
