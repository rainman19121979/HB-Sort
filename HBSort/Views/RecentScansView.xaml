<UserControl x:Class="HBSort.Views.RecentScansView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:HBSort.Behaviors">
    <!--
        Letzte-Scans-Tab. DataContext = RecentScansViewModel.
        UX X.20 Teil 2: Pro Eintrag ein kleines Item-Bild links - laed
        async ueber den PartImageProvider, daher kann das Bild beim
        Erscheinen ploetzlich auftauchen.
    -->
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="LETZTE SCANS"
                   FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- UX X.20 Teil 2: Item-Thumbnail links, async geladen.
                                     b:ImageZoom fuer Vergroesserung. NullToImageSource
                                     verhindert Trace-Warnung bei noch leerer ImageUrl. -->
                                <Image Grid.Column="0"
                                       Source="{Binding ImageUrl, Converter={StaticResource NullToImageSource}}"
                                       Width="28" Height="28" Stretch="Uniform"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"
                                       b:ImageZoom.IsEnabled="True"/>

                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding TimeLabel}" FontSize="11"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding DateLabel}" FontSize="9"
                                               Foreground="Gray"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Description}"
                                           TextWrapping="Wrap" FontSize="11"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{Binding ConfidenceLabel}"
                                           FontSize="10" Foreground="Gray"
                                           VerticalAlignment="Center"
                                           Margin="4,0,0,0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
