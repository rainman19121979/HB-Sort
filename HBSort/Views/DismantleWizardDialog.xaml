<Window x:Class="HBSort.Views.DismantleWizardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:b="clr-namespace:HBSort.Behaviors"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Figur zerlegen"
        Icon="../Resources/app.ico"
        Width="720" Height="640"
        MinWidth="500" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock>
                <Run Text="Figur "/>
                <Run Text="&quot;"/>
                <Run Text="{Binding MinifigName, Mode=OneWay}" FontWeight="SemiBold"/>
                <Run Text="&quot;"/>
                <Run Text=" zerlegen"/>
            </TextBlock>
            <TextBlock Foreground="Gray" FontSize="11">
                <Run Text="BL:"/>
                <Run Text="{Binding BricklinkId, Mode=OneWay}" FontFamily="Consolas"/>
            </TextBlock>
            <TextBlock Text="Was passiert mit den Teilen? Markierte Teile werden als Einzelteile in das gewaehlte Fach uebernommen. Die Figur selbst wird geloescht."
                       Foreground="Gray" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"/>
        </StackPanel>

        <Separator Grid.Row="1" Margin="0,8"/>

        <!-- Teile-Liste -->
        <Border Grid.Row="2"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="1" CornerRadius="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Parts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                    BorderThickness="0,0,0,1" Padding="8,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsKept, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              ToolTip="Markieren: Teil als Einzelteil uebernehmen. Unmarkiert: Teil verwerfen."/>
                                    <Image Grid.Column="1" Source="{Binding ImageUrl}"
                                           Width="40" Height="40" Stretch="Uniform"
                                           Margin="8,0,0,0"
                                           b:ImageZoom.IsEnabled="True"/>
                                    <Border Grid.Column="2" Width="16" Height="16"
                                            Background="{Binding SwatchBrush}"
                                            BorderBrush="Black" BorderThickness="1"
                                            Margin="8,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding DisplayLine}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               Margin="6,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding WasCollected}" Value="False">
                                                        <Setter Property="Foreground" Value="Gray"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                        <ComboBox ItemsSource="{Binding DataContext.AvailableBins,
                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding TargetBin, Mode=TwoWay}"
                                                  DisplayMemberPath="Label"
                                                  IsEnabled="{Binding IsKept}"/>
                                        <TextBlock Text="{Binding SmartHint}"
                                                   FontSize="10" FontStyle="Italic"
                                                   Foreground="#2196F3"
                                                   Margin="0,2,0,0"
                                                   Visibility="{Binding HasSmartHint,
                                                       Converter={StaticResource BoolToVisibility}}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="5"
                                               Text="{Binding StatusLabel}"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0"
                                               FontStyle="Italic"
                                               FontSize="11" Foreground="Gray"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Bulk-Aktionen -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Alle ankreuzen" Click="SelectAll_Click"
                    Padding="8,2" Margin="0,0,4,0"/>
            <Button Grid.Column="1" Content="Alle abwaehlen" Click="DeselectAll_Click"
                    Padding="8,2"/>
            <TextBlock Grid.Column="3" Text="Default-Fach:" VerticalAlignment="Center"
                       Foreground="Gray" Margin="0,0,6,0" FontSize="11"/>
            <ComboBox Grid.Column="4"
                      ItemsSource="{Binding AvailableBins}"
                      SelectedItem="{Binding DefaultBin, Mode=TwoWay}"
                      DisplayMemberPath="Label"/>
            <Button Grid.Column="5" Content="Auf alle anwenden" Click="ApplyDefault_Click"
                    Padding="8,2" Margin="6,0,0,0"/>
        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Abbrechen" IsCancel="True" Width="100" Margin="0,0,8,0"
                    Click="Cancel_Click"/>
            <Button Content="Bestaetigen" IsDefault="True" Width="120"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="Confirm_Click"/>
        </StackPanel>
    </Grid>
</Window>
