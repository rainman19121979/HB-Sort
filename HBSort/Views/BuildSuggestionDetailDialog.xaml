<Window x:Class="HBSort.Views.BuildSuggestionDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:b="clr-namespace:HBSort.Behaviors"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Bauvorschlag - Figur anlegen"
        ToolTipService.IsEnabled="{DynamicResource TooltipsEnabled}"
        Icon="../Resources/app.ico"
        Width="720" Height="700"
        MinWidth="600" MinHeight="500"
        WindowStartupLocation="CenterOwner">
    <!--
        Detail-Dialog fuer einen Bauvorschlag aus dem "Was kann ich bauen?"-Tab.
        Zeigt die Minifig + Required-Parts + Vorhanden-Status + Lagerfach-Auswahl.
        Beim "Figur anlegen"-Klick wird IMinifigPersistenceService.PersistAndStoreAsync
        aufgerufen, der den Reverse-Match selbst macht (Floating-Parts werden konsumiert
        und Quantity verbucht).
    -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 0: Header (Bild + Name) -->
            <RowDefinition Height="Auto"/>  <!-- 1: Verfuegbarkeits-Hint -->
            <RowDefinition Height="*"/>     <!-- 2: Teile-Liste -->
            <RowDefinition Height="Auto"/>  <!-- 3: Bin-Auswahl + Notizen -->
            <RowDefinition Height="Auto"/>  <!-- 4: Buttons -->
        </Grid.RowDefinitions>

        <!-- Header: Bild links, Titel + Meta rechts -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1" CornerRadius="4"
                    Width="110" Height="110"
                    HorizontalAlignment="Left">
                <Image Source="{Binding ImageUrl, Converter={StaticResource NullToImageSource}}" Stretch="Uniform" Margin="4"
                       b:ImageZoom.IsEnabled="True"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}"
                           FontSize="{StaticResource DialogHeaderFontSize}"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"/>
                <TextBlock FontSize="12" Foreground="Gray" Margin="0,4,0,0">
                    <Run Text="BL:"/>
                    <Run Text="{Binding BricklinkId, Mode=OneWay}" FontFamily="Consolas"/>
                    <Run Text="  -  Jahr:"/>
                    <Run Text="{Binding YearReleased, Mode=OneWay, TargetNullValue=?}"/>
                </TextBlock>
            </StackPanel>
        </Grid>

        <!-- Verfuegbarkeits-Banner -->
        <Border Grid.Row="1"
                Background="{StaticResource InfoBoxBackground}" BorderBrush="{StaticResource StatusInfoBrush}"
                BorderThickness="1" CornerRadius="4"
                Padding="10" Margin="0,0,0,12">
            <TextBlock Text="{Binding AvailabilityLabel}" FontSize="13"/>
        </Border>

        <!-- Teile-Liste -->
        <Border Grid.Row="2"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="1" CornerRadius="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Parts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                    BorderThickness="0,0,0,1" Padding="8,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding DisplayLine}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding StatusLabel}"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0"
                                               FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource StatusWarningBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFullyAvailable}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource StatusSuccessBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Bin-Auswahl + Notizen -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="Neues Lagerfach:" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="0" Grid.Column="1"
                      ItemsSource="{Binding AvailableBins}"
                      SelectedItem="{Binding SelectedBin}"
                      DisplayMemberPath="Label"/>

            <TextBlock Grid.Row="1" Grid.Column="0"
                       Text="Notizen (optional):" VerticalAlignment="Center"
                       Margin="0,8,0,0"/>
            <TextBox Grid.Row="1" Grid.Column="1"
                     Text="{Binding UserNotes, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,8,0,0"/>
        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Abbrechen" IsCancel="True"
                    Width="100" Margin="0,0,8,0"
                    Click="Cancel_Click"/>
            <Button Content="Figur anlegen"
                    IsEnabled="{Binding CanCreate}"
                    Width="160"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="Create_Click"
                    IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
