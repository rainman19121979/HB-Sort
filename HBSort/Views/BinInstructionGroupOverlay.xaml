<UserControl x:Class="HBSort.Views.BinInstructionGroupOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <!--
        UX X.32 Block C (v0.1.19): Sammel-Popup nach Direkt-Zerlegen oder
        Reverse-Match >=2. Zeigt eine Liste von "Lege X (Y Stueck) in BinZ"-
        Anweisungen plus Bilder. Schliesst per Klick irgendwo, Enter,
        Leertaste oder Esc - KEIN Auto-Dismiss-Timer (User-Spec: aktiv
        wegklicken).

        Spannt das ganze Fenster ab, mittig zentriert. ZIndex=101 in
        SortingView - ueber dem Einzel-Overlay falls beide aktiv waeren.
    -->
    <Grid x:Name="OverlayRoot"
          Background="#80000000"
          MouseLeftButtonUp="OverlayBackground_MouseLeftButtonUp"
          ToolTip="Klick irgendwo zum Schliessen">
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                BorderBrush="{DynamicResource SystemAccentColorLight2Brush}"
                BorderThickness="2"
                CornerRadius="8"
                Padding="24"
                MaxWidth="700" MaxHeight="600"
                MouseLeftButtonUp="OverlayPanel_MouseLeftButtonUp">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="6" Opacity="0.4"/>
            </Border.Effect>

            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top"
                           Text="Lege folgende Teile in die jeweiligen Faecher:"
                           FontSize="16" FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16"/>

                <Button DockPanel.Dock="Bottom"
                        Content="Verstanden (Enter)"
                        IsDefault="True"
                        HorizontalAlignment="Center"
                        Padding="32,8"
                        Margin="0,16,0,0"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="Ok_Click"
                        ToolTip="Druecke Enter / Leertaste oder klicke um fortzufahren."/>

                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="450">
                    <ItemsControl ItemsSource="{Binding ScanViewModel.BinInstructionGroup.Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Image Grid.Column="0"
                                           Source="{Binding ImageUrl, Converter={StaticResource NullToImageSource}}"
                                           Width="48" Height="48"
                                           Stretch="Uniform"/>

                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Margin="8,0">
                                        <TextBlock Text="{Binding ItemLabel}"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding QuantityText}"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                   FontSize="11"/>
                                    </StackPanel>

                                    <Border Grid.Column="2"
                                            Background="{DynamicResource SystemAccentColorLight2Brush}"
                                            CornerRadius="4"
                                            Padding="12,6"
                                            VerticalAlignment="Center"
                                            MinWidth="100">
                                        <TextBlock Text="{Binding BinLabel}"
                                                   Foreground="White"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
