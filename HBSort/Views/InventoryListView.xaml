<UserControl x:Class="HBSort.Views.InventoryListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019">
    <!--
        Phase X.2: Lagerliste als BrickStore-Style DataGrid.
        DataContext = InventoryListViewModel.
    -->

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header + Phase 7: BSX-Export-Aktionen -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="LAGERLISTE"
                       FontSize="18" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>

            <!-- Mitte: BSX-Export-Aktionen (nur sichtbar wenn es komplette Figuren gibt) -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="0,0,12,0"
                        Visibility="{Binding HasAnyCompletes, Converter={StaticResource BoolToVisibility}}">
                <Button Content="Alle Komplette" Padding="6,2" Margin="0,0,4,0"
                        Command="{Binding SelectAllCompleteCommand}"
                        ToolTip="Alle komplette Figuren in der aktuellen Sicht auswaehlen"/>
                <Button Content="Keine" Padding="6,2" Margin="0,0,4,0"
                        Command="{Binding DeselectAllCompleteCommand}"
                        ToolTip="Auswahl aufheben"/>
                <Button Click="ExportSelected_Click" Padding="8,2"
                        Style="{StaticResource AccentButtonStyle}"
                        IsEnabled="{Binding HasSelectedCompletes}"
                        ToolTip="Ausgewaehlte komplette Figuren als BSX exportieren">
                    <TextBlock>
                        <Run Text="Exportieren ("/><Run Text="{Binding SelectedCompleteCount, Mode=OneWay}"/><Run Text=")"/>
                    </TextBlock>
                </Button>
            </StackPanel>

            <Button Grid.Column="2" Content="Aktualisieren"
                    Command="{Binding LoadCommand}" Padding="8,2"/>
        </Grid>

        <!-- Filter -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Suche:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="Gray"/>
            <TextBox Grid.Column="1"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ui:ControlHelper.PlaceholderText="Name, BL-ID oder Farbe..."/>
            <TextBlock Grid.Column="2" Text="Fach:" VerticalAlignment="Center" Margin="12,0,6,0"
                       Foreground="Gray"/>
            <ComboBox Grid.Column="3"
                      ItemsSource="{Binding AvailableBins}"
                      SelectedItem="{Binding FilterByBin, Mode=TwoWay}"
                      DisplayMemberPath="Label"
                      ui:ControlHelper.PlaceholderText="(alle Faecher)"/>
            <TextBlock Grid.Column="5" Text="Status:" VerticalAlignment="Center" Margin="0,0,8,0"
                       Foreground="Gray"/>
            <CheckBox Grid.Column="6" Content="Komplett"
                      IsChecked="{Binding ShowComplete, Mode=TwoWay}"
                      VerticalAlignment="Center" Margin="0,0,12,0"/>
            <CheckBox Grid.Column="7" Content="Wartend"
                      IsChecked="{Binding ShowWaiting, Mode=TwoWay}"
                      VerticalAlignment="Center" Margin="0,0,12,0"/>
            <CheckBox Grid.Column="8" Content="Einzelteile"
                      IsChecked="{Binding ShowFloating, Mode=TwoWay}"
                      VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button Grid.Column="9" Content="Reset" Click="Reset_Click" Padding="8,2"/>
        </Grid>

        <!-- DataGrid -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding ItemsView}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  AlternatingRowBackground="#F8F8F8"
                  SelectionMode="Single"
                  RowHeight="48">
            <DataGrid.Columns>
                <!-- Phase 7: Multi-Select-Checkbox fuer BSX-Export. Nur fuer komplette
                     Minifigs sichtbar; andere Zeilen (Wartend / Einzelteil) zeigen die
                     Checkbox per DataTrigger versteckt. -->
                <DataGridTemplateColumn Header="Auswahl" Width="60" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Click="CompleteSelect_Click"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      ToolTip="Fuer BSX-Export auswaehlen">
                                <CheckBox.Style>
                                    <Style TargetType="CheckBox">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Complete">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </CheckBox.Style>
                            </CheckBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="#" Binding="{Binding RowNumber}" Width="40"
                                    IsReadOnly="True"/>

                <!-- Status: farbiger Badge -->
                <DataGridTemplateColumn Header="Status" Width="100" SortMemberPath="StatusLabel">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding StatusBrush}"
                                    CornerRadius="3" Padding="6,2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusLabel}"
                                           Foreground="White" FontWeight="SemiBold"
                                           FontSize="11"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Bild -->
                <DataGridTemplateColumn Header="Bild" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Source="{Binding ImageUrl}"
                                   Width="40" Height="40" Stretch="Uniform"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Teile-Id" Binding="{Binding ItemId}" Width="100"
                                    FontFamily="Consolas"/>
                <DataGridTextColumn Header="Beschreibung" Binding="{Binding Description}" Width="*"/>

                <DataGridTextColumn Header="Zustand" Binding="{Binding Condition}" Width="60"/>

                <!-- Farbe: Swatch + Name (Swatch nur fuer Einzelteile) -->
                <DataGridTemplateColumn Header="Farbe" Width="160" SortMemberPath="ColorName">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="14" Height="14"
                                        Background="{Binding ColorSwatch}"
                                        BorderBrush="Black" BorderThickness="1"
                                        Margin="0,0,6,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Type}" Value="Minifig">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <TextBlock Text="{Binding ColorName}" FontSize="12"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Anzahl" Binding="{Binding Quantity}" Width="70"/>
                <DataGridTextColumn Header="Lagerfach" Binding="{Binding StorageBinLabel}" Width="120"/>
                <DataGridTextColumn Header="Fortschritt" Binding="{Binding ProgressLabel}" Width="90"/>
                <DataGridTextColumn Header="Teiletyp" Binding="{Binding ItemTypeLabel}" Width="100"/>

                <!-- Aktionen -->
                <DataGridTemplateColumn Header="Aktionen" Width="160">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Details"
                                        Click="Details_Click" Tag="{Binding}"
                                        Padding="6,2" Margin="0,0,4,0"/>
                                <Button Content="Loeschen"
                                        Click="Delete_Click" Tag="{Binding}"
                                        Padding="6,2"
                                        Background="#D32F2F" Foreground="White"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Footer -->
        <Border Grid.Row="3" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                Padding="8,4" CornerRadius="3" Margin="0,8,0,0">
            <TextBlock Text="{Binding SummaryText}" FontSize="12" FontWeight="SemiBold"/>
        </Border>
    </Grid>
</UserControl>
