<UserControl x:Class="HBSort.Views.InventoryListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:b="clr-namespace:HBSort.Behaviors">
    <!--
        Phase X.2: Lagerliste als BrickStore-Style DataGrid.
        DataContext = InventoryListViewModel.
    -->

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>     <!-- 0: Header (Titel + Aktualisieren) -->
            <RowDefinition Height="Auto"/>     <!-- 1: Filter-Zeile -->
            <RowDefinition Height="Auto"/>     <!-- 2: Phase 7 Multi-Select-Action-Bar -->
            <RowDefinition Height="*"/>        <!-- 3: DataGrid -->
            <RowDefinition Height="Auto"/>     <!-- 4: Footer -->
        </Grid.RowDefinitions>

        <!-- Header: Titel + Wanted-List-Export + Aktualisieren -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="LAGERLISTE"
                       FontSize="18" FontWeight="SemiBold"/>
            <Button Grid.Column="1" Content="Wanted-List exportieren"
                    Click="WantedListExport_Click"
                    Padding="8,2" Margin="0,0,8,0"
                    ToolTip="BrickLink-Wanted-List-XML aus den fehlenden Teilen aller wartenden Figuren erzeugen"/>
            <Button Grid.Column="2" Content="Aktualisieren"
                    Command="{Binding LoadCommand}" Padding="8,2"
                    ToolTip="Liest Lagerliste aus der DB neu ein."/>
        </Grid>

        <!-- Filter -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Suche:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="Gray"/>
            <TextBox Grid.Column="1"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ui:ControlHelper.PlaceholderText="Name, BL-ID oder Farbe..."
                     ToolTip="Filtert live nach Name, BL-ID, Farbe oder Lagerfach-Label."/>
            <TextBlock Grid.Column="2" Text="Fach:" VerticalAlignment="Center" Margin="12,0,6,0"
                       Foreground="Gray"/>
            <ComboBox Grid.Column="3"
                      ItemsSource="{Binding AvailableBins}"
                      SelectedItem="{Binding FilterByBin, Mode=TwoWay}"
                      DisplayMemberPath="Label"
                      ui:ControlHelper.PlaceholderText="(alle Faecher)"
                      ToolTip="Beschraenkt die Liste auf ein einzelnes Lagerfach."/>
            <TextBlock Grid.Column="5" Text="Status:" VerticalAlignment="Center" Margin="0,0,8,0"
                       Foreground="Gray"/>
            <CheckBox Grid.Column="6" Content="Komplett"
                      IsChecked="{Binding ShowComplete, Mode=TwoWay}"
                      VerticalAlignment="Center" Margin="0,0,12,0"
                      ToolTip="Zeigt alle Figuren mit Status Komplett."/>
            <CheckBox Grid.Column="7" Content="Wartend"
                      IsChecked="{Binding ShowWaiting, Mode=TwoWay}"
                      VerticalAlignment="Center" Margin="0,0,12,0"
                      ToolTip="Zeigt alle Figuren denen noch Teile fehlen."/>
            <CheckBox Grid.Column="8" Content="Einzelteile"
                      IsChecked="{Binding ShowFloating, Mode=TwoWay}"
                      VerticalAlignment="Center" Margin="0,0,12,0"
                      ToolTip="Zeigt alle Floating-Parts (Einzelteile ohne Figur-Zuordnung)."/>
            <Button Grid.Column="9" Content="Reset" Click="Reset_Click" Padding="8,2"
                    ToolTip="Setzt Suche und Filter zurueck."/>
        </Grid>

        <!-- Phase 7 + UX X.6: BSX-Export Multi-Select-Action-Bar.
             Sichtbar wenn entweder komplette Figuren ODER Einzelteile da sind.
             "Alle" markiert beide Typen; Wartende bleiben ignoriert. -->
        <Border Grid.Row="2"
                Background="#F1F8E9" BorderBrush="#558B2F"
                BorderThickness="1" CornerRadius="3"
                Padding="8,6" Margin="0,0,0,8"
                Visibility="{Binding HasAnyExportable, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center">
                    <Run Text="Komplette Figuren und Einzelteile bereit zum Export."
                         Foreground="#33691E"/>
                    <Run Text="Auswahl:" Foreground="#33691E"/>
                    <Run Text="{Binding SelectedExportableCount, Mode=OneWay}"
                         FontWeight="SemiBold" Foreground="#33691E"/>
                    <Run Text="markiert" Foreground="#33691E"/>
                </TextBlock>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Alle"
                            Command="{Binding SelectAllExportableCommand}"
                            Padding="8,2" Margin="0,0,4,0"
                            ToolTip="Alle sichtbaren kompletten Figuren UND Einzelteile auswaehlen"/>
                    <Button Content="Keine"
                            Command="{Binding DeselectAllExportableCommand}"
                            Padding="8,2" Margin="0,0,8,0"
                            ToolTip="Auswahl aufheben"/>
                    <Button Content="Exportieren"
                            Click="ExportSelected_Click"
                            IsEnabled="{Binding HasSelectedExportables}"
                            Padding="12,2"
                            Background="#558B2F" Foreground="White"
                            FontWeight="SemiBold"
                            ToolTip="Markierte Figuren + Einzelteile als BSX-XML exportieren"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- DataGrid -->
        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding ItemsView}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  AlternatingRowBackground="#F8F8F8"
                  SelectionMode="Single"
                  RowHeight="48">
            <DataGrid.Columns>
                <!-- Phase 7 + UX X.6: Multi-Select-Checkbox fuer BSX-Export.
                     Sichtbar bei Komplett-Figuren UND Einzelteilen; Wartende
                     bleiben bewusst ohne Checkbox (saubere Optik - "kann nicht
                     exportiert werden weil unkomplett"). -->
                <DataGridTemplateColumn Header="Aus..." Width="60" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <!--
                                UX X.13b (Bugfix): Click-Handler weg. Selektion
                                laeuft jetzt ueber den IsSelected-Setter im
                                ViewModel-Item -> SelectionChanged-Event ->
                                Parent-VM-RecalculateSelection. WPF-DataGrid
                                mit IsReadOnly=True frisst den CheckBox-Click-
                                Event nicht zuverlaessig; der Property-Pfad
                                triggert dagegen unabhaengig von Maus/Tastatur/
                                Code-Set immer.
                            -->
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      ToolTip="Fuer BSX-Export auswaehlen">
                                <CheckBox.Style>
                                    <Style TargetType="CheckBox">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Complete">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Floating">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </CheckBox.Style>
                            </CheckBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="#" Binding="{Binding RowNumber}" Width="40"
                                    IsReadOnly="True"/>

                <!-- Status: farbiger Badge -->
                <DataGridTemplateColumn Header="Status" Width="100" SortMemberPath="StatusLabel">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding StatusBrush}"
                                    CornerRadius="3" Padding="6,2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    ToolTip="{Binding StatusTooltip}">
                                <TextBlock Text="{Binding StatusLabel}"
                                           Foreground="White" FontWeight="SemiBold"
                                           FontSize="11"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Bild -->
                <DataGridTemplateColumn Header="Bild" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Source="{Binding ImageUrl, Converter={StaticResource NullToImageSource}}"
                                   Width="40" Height="40" Stretch="Uniform"
                                   b:ImageZoom.IsEnabled="True"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Teile-Id" Binding="{Binding ItemId}" Width="100"
                                    FontFamily="Consolas"/>
                <DataGridTextColumn Header="Beschreibung" Binding="{Binding Description}" Width="*"/>

                <DataGridTextColumn Header="Zustand" Binding="{Binding Condition}" Width="60"/>

                <!-- Farbe: Swatch + Name (Swatch nur fuer Einzelteile) -->
                <DataGridTemplateColumn Header="Farbe" Width="160" SortMemberPath="ColorName">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="14" Height="14"
                                        Background="{Binding ColorSwatch}"
                                        BorderBrush="Black" BorderThickness="1"
                                        Margin="0,0,6,0"
                                        ToolTip="{Binding ColorName}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Type}" Value="Minifig">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <TextBlock Text="{Binding ColorName}" FontSize="12"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Anzahl" Binding="{Binding Quantity}" Width="70"/>
                <DataGridTextColumn Header="Lagerfach" Binding="{Binding StorageBinLabel}" Width="120"/>
                <DataGridTemplateColumn Header="Fortschritt" Width="90" SortMemberPath="ProgressLabel">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ProgressLabel}"
                                       VerticalAlignment="Center"
                                       ToolTip="{Binding ProgressTooltip}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Teiletyp" Binding="{Binding ItemTypeLabel}" Width="100"/>

                <!-- Aktionen -->
                <DataGridTemplateColumn Header="Aktionen" Width="160">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Details"
                                        Click="Details_Click" Tag="{Binding}"
                                        Padding="6,2" Margin="0,0,4,0"
                                        ToolTip="Oeffnet die Detail-Ansicht dieses Eintrags."/>
                                <Button Content="Loeschen"
                                        Click="Delete_Click" Tag="{Binding}"
                                        Padding="6,2"
                                        Background="#D32F2F" Foreground="White"
                                        ToolTip="Entfernt diesen Eintrag dauerhaft (mit Bestaetigung)."/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Footer -->
        <Border Grid.Row="4" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                Padding="8,4" CornerRadius="3" Margin="0,8,0,0">
            <TextBlock Text="{Binding SummaryText}" FontSize="12" FontWeight="SemiBold"/>
        </Border>
    </Grid>
</UserControl>
