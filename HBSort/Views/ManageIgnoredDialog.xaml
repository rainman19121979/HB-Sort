<Window x:Class="HBSort.Views.ManageIgnoredDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:b="clr-namespace:HBSort.Behaviors"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Ignorierte Bauvorschlaege verwalten"
        ToolTipService.IsEnabled="{DynamicResource TooltipsEnabled}"
        Icon="../Resources/app.ico"
        Width="520" Height="520"
        MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 0: Erklaerung -->
            <RowDefinition Height="*"/>      <!-- 1: Liste / Leer-Hinweis -->
            <RowDefinition Height="Auto"/>   <!-- 2: Footer -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Diese Figuren werden nicht mehr als Bauvorschlag angezeigt. Klicke 'Wiederherstellen' um eine einzelne wieder freizugeben."
                   TextWrapping="Wrap" FontSize="12"
                   Margin="0,0,0,12"/>

        <!-- Leer-Hinweis (nur wenn Items.Count = 0) -->
        <TextBlock Grid.Row="1"
                   Text="{Binding EmptyText}"
                   Foreground="Gray" FontSize="12"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVisibility}}"/>

        <!-- Liste der ignorierten Figuren -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                BorderThickness="1" CornerRadius="4"
                                Padding="8" Margin="0,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0"
                                       Source="{Binding ImageUrl, Converter={StaticResource NullToImageSource}}"
                                       Width="48" Height="48" Stretch="Uniform"
                                       b:ImageZoom.IsEnabled="True"/>
                                <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                               FontSize="12" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock FontSize="10" Foreground="Gray">
                                        <Run Text="BL:"/>
                                        <Run Text="{Binding BricklinkId, Mode=OneWay}" FontFamily="Consolas"/>
                                    </TextBlock>
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Content="Wiederherstellen"
                                        Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Padding="10,4"
                                        VerticalAlignment="Center"
                                        ToolTip="Diese Figur wieder als Bauvorschlag zulassen."/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Content="Alle wiederherstellen"
                    Command="{Binding RestoreAllCommand}"
                    IsEnabled="{Binding HasItems}"
                    Padding="10,4"
                    HorizontalAlignment="Left"
                    ToolTip="Loescht die komplette Ignorier-Liste."/>
            <Button Grid.Column="1"
                    Content="Schliessen"
                    IsDefault="True" IsCancel="True"
                    Style="{StaticResource AccentButtonStyle}"
                    Width="120" Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
