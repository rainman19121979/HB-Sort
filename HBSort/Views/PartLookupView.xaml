<UserControl x:Class="HBSort.Views.PartLookupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:HBSort.Behaviors">
    <!--
        Phase 5: Detailansicht eines erkannten Teils (Modus B).
        DataContext = PartLookupViewModel.
    -->

    <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
            BorderThickness="1" CornerRadius="4"
            Padding="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Header -->
                <RowDefinition Height="Auto"/>  <!-- Trenner -->
                <RowDefinition Height="*"/>     <!-- Wartende-Liste -->
                <RowDefinition Height="Auto"/>  <!-- Trenner + Alternativen-Header -->
                <RowDefinition Height="Auto"/>  <!-- Floating-Combo + Buttons (zusammen in einer Zeile) -->
            </Grid.RowDefinitions>

            <!-- ===== HEADER ===== -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0"
                       Source="{Binding ImageUrl, Converter={StaticResource NullToImageSource}}"
                       Stretch="Uniform"
                       Width="100" Height="100"
                       HorizontalAlignment="Left" VerticalAlignment="Top"
                       b:ImageZoom.IsEnabled="True"/>

                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock Text="ERKANNTES TEIL"
                               FontSize="10"
                               Foreground="Gray" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding PartName}"
                               FontSize="13" FontWeight="SemiBold"
                               TextWrapping="Wrap"/>

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="BL:"
                                   Foreground="Gray"
                                   FontSize="10"/>
                        <TextBlock Grid.Column="1" Text="{Binding BlPartNo}"
                                   FontFamily="Consolas"
                                   FontSize="10"/>
                    </Grid>

                    <!-- Color-Zeile mit Swatch + Korrektur-Dropdown -->
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Farbe:"
                                   Foreground="Gray" VerticalAlignment="Center"
                                   FontSize="10"/>
                        <Border Grid.Column="1" Width="20" Height="20"
                                Background="{Binding SwatchBrush}"
                                BorderBrush="Black" BorderThickness="1"
                                Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding ColorDisplayLabel}"
                                   VerticalAlignment="Center"
                                   FontSize="10"/>
                    </Grid>

                    <!-- Korrektur-Dropdown unter der Color-Zeile -->
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Korrektur:"
                                   Foreground="Gray" VerticalAlignment="Center"
                                   FontSize="9"/>
                        <ComboBox Grid.Column="1" MinWidth="200"
                                  ItemsSource="{Binding AvailableColors}"
                                  SelectedItem="{Binding SelectedColor}"
                                  DisplayMemberPath="Name"
                                  ToolTip="Nur Farben in denen das Teil bei BL existiert"
                                  IsEnabled="{Binding IsLoadingColors,
                                       Converter={StaticResource InverseBoolToVisibility}}"
                                  SelectionChanged="Color_SelectionChanged"/>
                        <ProgressBar Grid.Column="2" Width="60" Height="6"
                                     IsIndeterminate="True" Margin="6,0,0,0"
                                     Visibility="{Binding IsLoadingColors,
                                         Converter={StaticResource BoolToVisibility}}"/>
                    </Grid>

                    <!-- Anzahl -->
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Anzahl:"
                                   Foreground="Gray" VerticalAlignment="Center"
                                   FontSize="10"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Anzahl Teile (Default 1, fuer Mehrfach-Scans)"/>
                    </Grid>
                </StackPanel>
            </Grid>

            <Separator Grid.Row="1" Margin="0,8"/>

            <!-- ===== WARTENDE FIGUREN + BL-CATALOG (scrollbar damit Buttons unten immer sichtbar) ===== -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock FontSize="10" FontWeight="SemiBold"
                               Margin="0,0,0,6">
                        <Run Text="PASSENDE WARTENDE FIGUREN"/>
                        <Run Text="("/><Run Text="{Binding WaitingMatches.Count, Mode=OneWay}"/><Run Text=")"/>
                    </TextBlock>

                <TextBlock Text="Keine wartende Figur braucht dieses Teil in dieser Farbe."
                           Foreground="Gray" FontStyle="Italic"
                           Visibility="{Binding HasWaitingMatches,
                                Converter={StaticResource InverseBoolToVisibility}}"/>

                <ItemsControl ItemsSource="{Binding WaitingMatches}"
                              Visibility="{Binding HasWaitingMatches,
                                  Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                    BorderThickness="1" CornerRadius="4"
                                    Padding="6" Margin="0,2,0,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Image Grid.Column="0" Source="{Binding ImageUrl, Converter={StaticResource NullToImageSource}}"
                                           Width="60" Height="60" Stretch="Uniform"
                                           b:ImageZoom.IsEnabled="True"/>

                                    <!--
                                        Mittlere Spalte: Figur-Name + Fortschritt. Das Lagerfach
                                        wandert in ein eigenes Badge (Spalte 3), damit es deutlich
                                        sichtbar ist - vorher war es in Klammern hinter dem Namen
                                        und leicht zu uebersehen.
                                    -->
                                    <StackPanel Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding MinifigName, Mode=OneWay}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding ProgressLabel}"
                                                   FontSize="10"
                                                   Foreground="Gray"/>
                                    </StackPanel>

                                    <!--
                                        v0.1.24-beta.13 (V5 Fortsetzung): Reservierungs-Badge.
                                        Sichtbar wenn QuantityReservedFromBl > 0 - dann sagt es
                                        dem User dass Zuordnen die Reservierung aufloest
                                        (kein Standard-"in-Fach-legen"-Schritt sondern V5-Logik
                                        mit BL-Shop-Auffuellung).
                                    -->
                                    <Border Grid.Column="2"
                                            Background="#0277BD"
                                            CornerRadius="4"
                                            Padding="6,2"
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            ToolTip="Diese Figur hat das Teil aus dem BL-Shop reserviert. Zuordnen loest die Reservierung auf."
                                            Visibility="{Binding HasBlReservation, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="Reservierung — zuordnen loest auf"
                                                   Foreground="White" FontWeight="SemiBold"
                                                   FontSize="10"/>
                                    </Border>

                                    <!--
                                        UX X.19 Teil 1: Lagerfach-Badge. Helles Blau passt zur
                                        InfoBoxBackground-Konvention aus Audit W-4. Das Badge ist
                                        die wichtigste Info fuer den User: er muss das gerade
                                        gescannte Teil ja in genau dieses Fach legen.
                                    -->
                                    <Border Grid.Column="3"
                                            Background="{StaticResource InfoBoxBackground}"
                                            BorderBrush="{StaticResource StatusInfoBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="8,4"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            ToolTip="In dieses Fach gehoert die Figur - dort das gerade gescannte Teil ablegen.">
                                        <TextBlock FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource StatusInfoBrush}">
                                            <Run Text="📦"/>
                                            <Run Text="{Binding StorageBinLabel, Mode=OneWay, FallbackValue='kein Fach'}"/>
                                        </TextBlock>
                                    </Border>

                                    <Button Grid.Column="4" Content="Zuordnen"
                                            Click="Assign_Click"
                                            Tag="{Binding}"
                                            Padding="8,4"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource AccentButtonStyle}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ===== BL-CATALOG-TREFFER (Cache) ===== -->
                <TextBlock FontSize="10" FontWeight="SemiBold"
                           Margin="0,12,0,4"
                           Visibility="{Binding HasBlCatalogMatches,
                               Converter={StaticResource BoolToVisibility}}">
                    <Run Text="MOEGLICHE BL-FIGUREN MIT DIESEM TEIL"/>
                    <Run Text="("/><Run Text="{Binding BlCatalogMatches.Count, Mode=OneWay}"/><Run Text=")"/>
                </TextBlock>
                <ItemsControl ItemsSource="{Binding BlCatalogMatches}"
                              Visibility="{Binding HasBlCatalogMatches,
                                  Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                    BorderThickness="1" CornerRadius="4"
                                    Padding="6" Margin="0,2,0,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" Source="{Binding ImageUrl, Converter={StaticResource NullToImageSource}}"
                                           Width="48" Height="48" Stretch="Uniform"
                                           b:ImageZoom.IsEnabled="True"/>
                                    <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding MinifigName}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock FontSize="9"
                                                   Foreground="Gray" FontFamily="Consolas">
                                            <Run Text="BL:"/>
                                            <Run Text="{Binding BlMinifigId, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding QuantityLabel}"
                                               FontStyle="Italic"
                                               VerticalAlignment="Center" Margin="8,0"/>
                                    <Button Grid.Column="3" Content="Diese Figur anlegen"
                                            Click="CollectFromBlCatalog_Click"
                                            Tag="{Binding}"
                                            Padding="8,4"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource AccentButtonStyle}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--
                    ===== KOMPONENTEN DES TEILS (Combined Part, v0.1.25) =====
                    Zeigt bei einem montierten Torso die Einzelteile (bare Torso +
                    Arme + Haende). Daten kommen aus dem lokalen bl_cache.db -
                    KEIN BL-Call. Nur sichtbar wenn Komponenten existieren
                    (atomare Teile -> kein Expander). Default aufgeklappt damit
                    der User die Info beim Torso-Scan sofort sieht.
                    Reine Info-Anzeige: keine Buttons, keine Aktionen.
                -->
                <Expander Header="Komponenten dieses Teils"
                          Margin="0,12,0,0"
                          IsExpanded="True"
                          Visibility="{Binding HasComponents,
                              Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl ItemsSource="{Binding Components}"
                                  Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                        BorderThickness="1" CornerRadius="4"
                                        Padding="6" Margin="0,2,0,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Bild (klickbar via ImageZoom, ux-patterns.md §9) -->
                                        <Image Grid.Column="0"
                                               Source="{Binding ImageUrl, Converter={StaticResource NullToImageSource}}"
                                               Width="48" Height="48" Stretch="Uniform"
                                               b:ImageZoom.IsEnabled="True"/>

                                        <!-- Name + BL-ID + ggf. Grund-Teil-Badge -->
                                        <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding ItemName}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"/>
                                                <!--
                                                    Grund-Teil-Kennzeichnung (Konzept 6.2):
                                                    der bedruckte Rumpf selbst. Badge nur bei
                                                    IsBaseItem sichtbar.
                                                -->
                                                <Border Background="{StaticResource InfoBoxBackground}"
                                                        BorderBrush="{StaticResource StatusInfoBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="6,1"
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        ToolTip="Das ist das Grund-Teil (der bedruckte Rumpf) - Arme und Haende stecken zusaetzlich darin."
                                                        Visibility="{Binding IsBaseItem,
                                                            Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="Grund-Teil"
                                                               FontSize="9" FontWeight="SemiBold"
                                                               Foreground="{StaticResource StatusInfoBrush}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock FontSize="9"
                                                       Foreground="Gray" FontFamily="Consolas">
                                                <Run Text="BL:"/>
                                                <Run Text="{Binding ItemNo, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Farb-Swatch + Farb-Name -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                    VerticalAlignment="Center" Margin="8,0">
                                            <Border Width="16" Height="16"
                                                    Background="{Binding SwatchBrush}"
                                                    BorderBrush="Black" BorderThickness="1"
                                                    Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding ColorName}"
                                                       FontSize="10"
                                                       Foreground="Gray"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Menge -->
                                        <TextBlock Grid.Column="3" Text="{Binding QuantityLabel}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Margin="8,0,4,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>
                </StackPanel>
            </ScrollViewer>

            <!--
                UX X.20 Teil 4: Lagerfach-Bereich prominenter. Vorher waren
                Smart-Storage-Hint und Dropdown optisch entkoppelt; jetzt in
                EINEM Border mit InfoBox-Hintergrund (helles Blau). Damit ist
                klar dass Hinweis und Auswahl thematisch zusammengehoeren -
                und der User uebersieht das Dropdown nicht mehr.
                Grid.Row=3 (alter Alternativen-Header) zusammengefuehrt mit
                dem alten Grid.Row=4 (Eingabezeile).
            -->
            <Border Grid.Row="3" Grid.RowSpan="2"
                    Margin="0,12,0,0"
                    Background="{StaticResource InfoBoxBackground}"
                    BorderBrush="{StaticResource StatusInfoBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10">
                <StackPanel>
                    <TextBlock FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource StatusInfoBrush}"
                               Margin="0,0,0,2">
                        <Run Text="📦"/>
                        <Run Text="Als Einzelteil lagern in:"/>
                    </TextBlock>

                    <!--
                        Smart-Storage-Hint (UX X.7). Steht jetzt im selben
                        Container und teilt sich die Akzentfarbe.
                    -->
                    <TextBlock Text="{Binding MatchingFloatingBinHintText}"
                               FontSize="10"
                               Foreground="{StaticResource StatusInfoBrush}"
                               FontStyle="Italic"
                               Margin="0,0,0,6"
                               Visibility="{Binding HasMatchingFloatingBin,
                                    Converter={StaticResource BoolToVisibility}}"/>

                    <!--
                        UX X.33 v0.1.19-beta.7 Block K: Warnung wenn alle
                        Faecher belegt sind. Service liefert dann null statt
                        eines beliebigen Fachs.
                    -->
                    <Border Background="#FFF4E5" BorderBrush="#E65100"
                            BorderThickness="1" CornerRadius="4" Padding="8"
                            Margin="0,0,0,6"
                            Visibility="{Binding HasNoFreeBinWarning, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <Button Content="Lagerfach-Verwaltung"
                                    DockPanel.Dock="Right"
                                    Click="OpenBinManagement_Click"
                                    MinHeight="28" Padding="8,2"
                                    Margin="8,0,0,0"
                                    ToolTip="Oeffnet die Einstellungen mit dem Lagerfach-Tab."/>
                            <TextBlock Text="{Binding NoFreeBinWarning}"
                                       TextWrapping="Wrap" VerticalAlignment="Center"
                                       FontWeight="SemiBold" FontSize="11"
                                       Foreground="#E65100"/>
                        </DockPanel>
                    </Border>

                    <!-- Eingabezeile: groesseres Dropdown + Anzahl + Aktionen. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!--
                            MinHeight=34 macht das Dropdown ~1.3x hoeher als
                            ModernWpf-Default (rund 26px) - aktive Eingabe-
                            Erwartung optisch betonen.
                        -->
                        <ComboBox Grid.Column="0" MinWidth="180" MinHeight="34"
                                  FontSize="13"
                                  ItemsSource="{Binding AvailableBins}"
                                  SelectedItem="{Binding SelectedFloatingBin}"
                                  DisplayMemberPath="DisplayText"
                                  ToolTip="Wo soll das Teil hin? Suffix wie '(5 Einzelteile)' zeigt die aktuelle Belegung."/>
                        <TextBlock Grid.Column="1" Text="Anzahl:"
                                   VerticalAlignment="Center" Margin="12,0,6,0"
                                   Foreground="Gray"
                                   FontSize="11"/>
                        <TextBox Grid.Column="2" MinHeight="34"
                                 FontSize="13"
                                 Text="{Binding FloatingQuantity, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Wieviele Stueck dieses Teils legst du gerade ab?"/>
                        <Button Grid.Column="3" Content="Lagern" Width="100" MinHeight="34"
                                Margin="8,0,0,0"
                                Click="StoreFloating_Click"
                                Style="{StaticResource AccentButtonStyle}"
                                ToolTip="Teil als Einzelteil im gewaehlten Fach lagern"/>
                        <Button Grid.Column="4" Content="Verwerfen" Width="100" MinHeight="34"
                                Margin="8,0,0,0"
                                Click="Discard_Click"
                                ToolTip="Scan verwerfen ohne zu speichern"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
