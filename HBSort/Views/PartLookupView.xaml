<UserControl x:Class="HBSort.Views.PartLookupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Phase 5: Detailansicht eines erkannten Teils (Modus B).
        DataContext = PartLookupViewModel.
    -->

    <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
            BorderThickness="1" CornerRadius="4"
            Padding="{DynamicResource BorderPadding}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Header -->
                <RowDefinition Height="Auto"/>  <!-- Trenner -->
                <RowDefinition Height="*"/>     <!-- Wartende-Liste -->
                <RowDefinition Height="Auto"/>  <!-- Trenner + Alternativen-Header -->
                <RowDefinition Height="Auto"/>  <!-- Floating-Combo + Buttons (zusammen in einer Zeile) -->
            </Grid.RowDefinitions>

            <!-- ===== HEADER ===== -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0"
                       Source="{Binding ImageUrl}"
                       Stretch="Uniform"
                       Width="100" Height="100"
                       HorizontalAlignment="Left" VerticalAlignment="Top"/>

                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock Text="ERKANNTES TEIL"
                               FontSize="{DynamicResource DetailFontSize}"
                               Foreground="Gray" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding PartName}"
                               FontSize="{DynamicResource HeaderFontSize}" FontWeight="SemiBold"
                               TextWrapping="Wrap"/>

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="BL:"
                                   Foreground="Gray"
                                   FontSize="{DynamicResource DetailFontSize}"/>
                        <TextBlock Grid.Column="1" Text="{Binding BlPartNo}"
                                   FontFamily="Consolas"
                                   FontSize="{DynamicResource DetailFontSize}"/>
                    </Grid>

                    <!-- Color-Zeile mit Swatch + Korrektur-Dropdown -->
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Farbe:"
                                   Foreground="Gray" VerticalAlignment="Center"
                                   FontSize="{DynamicResource DetailFontSize}"/>
                        <Border Grid.Column="1" Width="20" Height="20"
                                Background="{Binding SwatchBrush}"
                                BorderBrush="Black" BorderThickness="1"
                                Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding ColorDisplayLabel}"
                                   VerticalAlignment="Center"
                                   FontSize="{DynamicResource DetailFontSize}"/>
                    </Grid>

                    <!-- Korrektur-Dropdown unter der Color-Zeile -->
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Korrektur:"
                                   Foreground="Gray" VerticalAlignment="Center"
                                   FontSize="{DynamicResource MicroFontSize}"/>
                        <ComboBox Grid.Column="1" MinWidth="200"
                                  ItemsSource="{Binding AvailableColors}"
                                  SelectedItem="{Binding SelectedColor}"
                                  DisplayMemberPath="Name"
                                  ToolTip="Nur Farben in denen das Teil bei BL existiert"
                                  IsEnabled="{Binding IsLoadingColors,
                                       Converter={StaticResource InverseBoolToVisibility}}"
                                  SelectionChanged="Color_SelectionChanged"/>
                        <ProgressBar Grid.Column="2" Width="60" Height="6"
                                     IsIndeterminate="True" Margin="6,0,0,0"
                                     Visibility="{Binding IsLoadingColors,
                                         Converter={StaticResource BoolToVisibility}}"/>
                    </Grid>

                    <!-- Anzahl -->
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Anzahl:"
                                   Foreground="Gray" VerticalAlignment="Center"
                                   FontSize="{DynamicResource DetailFontSize}"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Anzahl Teile (Default 1, fuer Mehrfach-Scans)"/>
                    </Grid>
                </StackPanel>
            </Grid>

            <Separator Grid.Row="1" Margin="0,8"/>

            <!-- ===== WARTENDE FIGUREN + BL-CATALOG (scrollbar damit Buttons unten immer sichtbar) ===== -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock FontSize="{DynamicResource DetailFontSize}" FontWeight="SemiBold"
                               Margin="0,0,0,6">
                        <Run Text="PASSENDE WARTENDE FIGUREN"/>
                        <Run Text="("/><Run Text="{Binding WaitingMatches.Count, Mode=OneWay}"/><Run Text=")"/>
                    </TextBlock>

                <TextBlock Text="Keine wartende Figur braucht dieses Teil in dieser Farbe."
                           Foreground="Gray" FontStyle="Italic"
                           Visibility="{Binding HasWaitingMatches,
                                Converter={StaticResource InverseBoolToVisibility}}"/>

                <ItemsControl ItemsSource="{Binding WaitingMatches}"
                              Visibility="{Binding HasWaitingMatches,
                                  Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                    BorderThickness="1" CornerRadius="4"
                                    Padding="6" Margin="0,2,0,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Image Grid.Column="0" Source="{Binding ImageUrl}"
                                           Width="60" Height="60" Stretch="Uniform"/>

                                    <StackPanel Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center">
                                        <TextBlock FontSize="{DynamicResource BodyFontSize}"
                                                   FontWeight="SemiBold" TextWrapping="Wrap">
                                            <Run Text="{Binding MinifigName, Mode=OneWay}"/>
                                            <Run Text="{Binding BinLabel, Mode=OneWay}" Foreground="Gray"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding ProgressLabel}"
                                                   FontSize="{DynamicResource DetailFontSize}"
                                                   Foreground="Gray"/>
                                    </StackPanel>

                                    <Button Grid.Column="2" Content="Zuordnen"
                                            Click="Assign_Click"
                                            Tag="{Binding}"
                                            Padding="8,4"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource AccentButtonStyle}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ===== BL-CATALOG-TREFFER (Cache) ===== -->
                <TextBlock FontSize="{DynamicResource DetailFontSize}" FontWeight="SemiBold"
                           Margin="0,12,0,4"
                           Visibility="{Binding HasBlCatalogMatches,
                               Converter={StaticResource BoolToVisibility}}">
                    <Run Text="MOEGLICHE BL-FIGUREN MIT DIESEM TEIL"/>
                    <Run Text="("/><Run Text="{Binding BlCatalogMatches.Count, Mode=OneWay}"/><Run Text=")"/>
                </TextBlock>
                <ItemsControl ItemsSource="{Binding BlCatalogMatches}"
                              Visibility="{Binding HasBlCatalogMatches,
                                  Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                    BorderThickness="1" CornerRadius="4"
                                    Padding="6" Margin="0,2,0,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" Source="{Binding ImageUrl}"
                                           Width="48" Height="48" Stretch="Uniform"/>
                                    <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding MinifigName}"
                                                   FontSize="{DynamicResource BodyFontSize}"
                                                   FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock FontSize="{DynamicResource MicroFontSize}"
                                                   Foreground="Gray" FontFamily="Consolas">
                                            <Run Text="BL:"/>
                                            <Run Text="{Binding BlMinifigId, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding QuantityLabel}"
                                               FontStyle="Italic"
                                               VerticalAlignment="Center" Margin="8,0"/>
                                    <Button Grid.Column="3" Content="Diese Figur anlegen"
                                            Click="CollectFromBlCatalog_Click"
                                            Tag="{Binding}"
                                            Padding="8,4"
                                            VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== ALTERNATIVEN-HEADER ===== -->
            <StackPanel Grid.Row="3" Margin="0,12,0,0">
                <Separator/>
                <TextBlock Text="ALTERNATIVEN" Margin="0,8,0,4"
                           FontSize="{DynamicResource DetailFontSize}" FontWeight="SemiBold"/>
                <TextBlock Text="Als Einzelteil lagern in:"
                           FontSize="{DynamicResource DetailFontSize}" Foreground="Gray"/>
            </StackPanel>

            <!--
                Lagern + Verwerfen in einer Zeile, damit beide Buttons
                immer zusammen sichtbar sind und der User nicht scrollen muss.
                Grid.Row="5" entfaellt dadurch.
            -->
            <Grid Grid.Row="4" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" MinWidth="140"
                          ItemsSource="{Binding AvailableBins}"
                          SelectedItem="{Binding SelectedFloatingBin}"
                          DisplayMemberPath="Label"/>
                <TextBlock Grid.Column="1" Text="Anzahl:"
                           VerticalAlignment="Center" Margin="12,0,6,0"
                           Foreground="Gray"
                           FontSize="{DynamicResource DetailFontSize}"/>
                <TextBox Grid.Column="2"
                         Text="{Binding FloatingQuantity, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Anzahl"/>
                <Button Grid.Column="3" Content="Lagern" Width="90"
                        Margin="8,0,0,0"
                        Click="StoreFloating_Click"
                        Style="{StaticResource AccentButtonStyle}"
                        ToolTip="Teil als Einzelteil im gewaehlten Fach lagern"/>
                <Button Grid.Column="4" Content="Verwerfen" Width="90"
                        Margin="8,0,0,0"
                        Click="Discard_Click"
                        ToolTip="Scan verwerfen ohne zu speichern"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
