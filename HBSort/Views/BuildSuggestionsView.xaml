<UserControl x:Class="HBSort.Views.BuildSuggestionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:HBSort.Behaviors">
    <!--
        Bauvorschlaege auf Basis der Floating-Parts.
        DataContext = BuildSuggestionsViewModel.
        Kein Mindest-Match-Schwellenwert mehr - alle baubaren Vorschlaege werden
        angezeigt, sortiert nach Match-% absteigend. Top-N-Limit greift weiterhin
        (siehe BuildSuggestionsViewModel.MaxSuggestions).
    -->
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="WAS KANN ICH BAUEN?"
                   FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Suggestions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!--
                            Klick auf den Border oeffnet den Detail-Dialog
                            (siehe BuildSuggestionsView.xaml.cs::Suggestion_MouseDown).
                            Tag traegt das ViewModel-Objekt, damit der Handler die
                            ausgewaehlte Suggestion identifizieren kann.
                        -->
                        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                BorderThickness="1" CornerRadius="4"
                                Padding="6" Margin="0,2"
                                Cursor="Hand"
                                Background="Transparent"
                                Tag="{Binding}"
                                MouseLeftButtonUp="Suggestion_MouseDown"
                                ToolTip="Klicken um diese Figur als wartende Figur anzulegen">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!--
                                    ImageZoom auf dem Bild: Klick auf das Bild
                                    selbst oeffnet das grosse Vorschau-Overlay.
                                    Das Border drumherum hat Suggestion_MouseDown,
                                    der den Detail-Dialog oeffnet - Klick auf den
                                    Rest der Karte oeffnet weiterhin den Dialog,
                                    nur das Bild ist zoombar.
                                -->
                                <Image Grid.Column="0" Source="{Binding ImageUrl, Converter={StaticResource NullToImageSource}}"
                                       Width="44" Height="44" Stretch="Uniform"
                                       b:ImageZoom.IsEnabled="True"/>
                                <StackPanel Grid.Column="1" Margin="6,0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                               FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock FontSize="10" Foreground="Gray">
                                        <Run Text="BL:"/>
                                        <Run Text="{Binding BricklinkId, Mode=OneWay}" FontFamily="Consolas"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding MissingLabel}" FontSize="10"
                                               Foreground="Gray"/>
                                </StackPanel>
                                <Border Grid.Column="2"
                                        Background="{Binding MatchBrush}"
                                        CornerRadius="4" Padding="6,2"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding MatchLabel}"
                                               Foreground="White" FontWeight="SemiBold"
                                               FontSize="11"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="2" Text="{Binding SummaryText}"
                   Foreground="Gray" FontSize="11" Margin="0,4,0,0"/>
    </Grid>
</UserControl>
