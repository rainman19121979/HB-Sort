<UserControl x:Class="HBSort.Views.BuildSuggestionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:HBSort.Behaviors">
    <!--
        Bauvorschlaege auf Basis der Floating-Parts.
        DataContext = BuildSuggestionsViewModel.
        Kein Mindest-Match-Schwellenwert mehr - alle baubaren Vorschlaege werden
        angezeigt, sortiert nach Match-% absteigend. Top-N-Limit greift weiterhin
        (siehe BuildSuggestionsViewModel.MaxSuggestions).
    -->
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 0: Header + Checkbox -->
            <RowDefinition Height="*"/>      <!-- 1: ScrollViewer mit beiden Sektionen -->
            <RowDefinition Height="Auto"/>   <!-- 2: SummaryText -->
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="WAS KANN ICH BAUEN?"
                       FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <!-- v0.1.24-beta.8 Phase 3: BL-Inventar-Toggle. Sichtbar nur wenn
                 der User ueberhaupt synchronisiert hat (HasAnyBlInventory).
                 Default aus (IncludeBlInventory=false) -> Standardverhalten
                 unveraendert. -->
            <CheckBox Grid.Column="1"
                      Content="BL-Inventar beruecksichtigen"
                      IsChecked="{Binding IncludeBlInventory, Mode=TwoWay}"
                      Visibility="{Binding HasAnyBlInventory, Converter={StaticResource BoolToVisibility}}"
                      ToolTip="Zeigt zusaetzlich Figuren die mit deinem BrickLink-Shop-Bestand vervollstaendigt werden koennen."/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Suggestions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                BorderThickness="1" CornerRadius="4"
                                Padding="6" Margin="0,2"
                                Cursor="Hand"
                                Background="Transparent"
                                Tag="{Binding}"
                                MouseLeftButtonUp="Suggestion_MouseDown"
                                ToolTip="Klicken um diese Figur als wartende Figur anzulegen">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Source="{Binding ImageUrl, Converter={StaticResource NullToImageSource}}"
                                       Width="44" Height="44" Stretch="Uniform"
                                       b:ImageZoom.IsEnabled="True"/>
                                <StackPanel Grid.Column="1" Margin="6,0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                               FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock FontSize="10" Foreground="Gray">
                                        <Run Text="BL:"/>
                                        <Run Text="{Binding BricklinkId, Mode=OneWay}" FontFamily="Consolas"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding MissingLabel}" FontSize="10"
                                               Foreground="Gray"/>
                                </StackPanel>
                                <!-- v0.1.24-beta.8 Phase 3 (Fix 5): BL-Shop-Badge
                                     fuer Erweiterungen. Nur sichtbar wenn das Item
                                     ueber den BL-Pfad kommt (IsBlShopAddition). -->
                                <Border Grid.Column="2"
                                        Background="#0277BD"
                                        CornerRadius="4" Padding="6,2"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        ToolTip="Diese Figur ist nur mit Teilen aus deinem BrickLink-Shop komplett baubar."
                                        Visibility="{Binding IsBlShopAddition, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding BlShopBadgeLabel}"
                                               Foreground="White" FontWeight="SemiBold"
                                               FontSize="10"/>
                                </Border>
                                <Border Grid.Column="3"
                                        Background="{Binding MatchBrush}"
                                        CornerRadius="4" Padding="6,2"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding MatchLabel}"
                                               Foreground="White" FontWeight="SemiBold"
                                               FontSize="11"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="2" Text="{Binding SummaryText}"
                   Foreground="Gray" FontSize="11" Margin="0,4,0,0"/>
    </Grid>
</UserControl>
