<Window x:Class="HBSort.Views.BsxExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:b="clr-namespace:HBSort.Behaviors"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="BSX-Export"
        ToolTipService.IsEnabled="{DynamicResource TooltipsEnabled}"
        Icon="../Resources/app.ico"
        Width="680" Height="700"
        MinWidth="520" MinHeight="540"
        WindowStartupLocation="CenterOwner">
    <!--
        Phase 7 + UX X.6: BSX-Export-Dialog. Zeigt zwei getrennte Listen
        (Komplette Figuren + Einzelteile) und exportiert beide in eine
        gemeinsame BSX-Datei. Cleanup-Block laesst beide entfernen.
    -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 0: Headline -->
            <RowDefinition Height="*"/>     <!-- 1: Listen (Komplett + Einzelteile) -->
            <RowDefinition Height="Auto"/>  <!-- 2: Optionen -->
            <RowDefinition Height="Auto"/>  <!-- 3: Speicherort -->
            <RowDefinition Height="Auto"/>  <!-- 4: Cleanup-Block (nach Export) -->
            <RowDefinition Height="Auto"/>  <!-- 5: Buttons -->
        </Grid.RowDefinitions>

        <!-- Kopf -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock x:Name="HeaderText"
                       FontSize="18" FontWeight="SemiBold"
                       Text="BSX-Export"/>
            <TextBlock x:Name="SubText"
                       FontSize="12" Foreground="Gray"
                       Margin="0,2,0,0"
                       Text="Wird beim Initialisieren gesetzt."/>
        </StackPanel>

        <!-- Zwei Listen untereinander, mit Headern. ScrollViewer drumherum. -->
        <Border Grid.Row="1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="1" CornerRadius="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Sektion: Komplette Figuren (nur sichtbar wenn welche da sind) -->
                    <Border x:Name="MinifigSectionHeader"
                            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                            Padding="8,4">
                        <TextBlock x:Name="MinifigSectionTitle"
                                   FontWeight="SemiBold" FontSize="12"
                                   Text="Komplette Figuren"/>
                    </Border>
                    <ItemsControl x:Name="MinifigList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                        BorderThickness="0,0,0,1" Padding="8,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Image Grid.Column="0" Source="{Binding ImageUrl}"
                                               Width="36" Height="36" Stretch="Uniform"
                                               b:ImageZoom.IsEnabled="True"/>
                                        <StackPanel Grid.Column="1" Margin="6,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock FontSize="11" Foreground="Gray">
                                                <Run Text="BL:"/>
                                                <Run Text="{Binding BricklinkId, Mode=OneWay}" FontFamily="Consolas"/>
                                                <Run Text=" • Fach:"/>
                                                <Run Text="{Binding BinLabel, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Sektion: Einzelteile -->
                    <Border x:Name="FloatingSectionHeader"
                            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                            Padding="8,4" Margin="0,4,0,0">
                        <TextBlock x:Name="FloatingSectionTitle"
                                   FontWeight="SemiBold" FontSize="12"
                                   Text="Einzelteile"/>
                    </Border>
                    <ItemsControl x:Name="FloatingList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                        BorderThickness="0,0,0,1" Padding="8,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Image Grid.Column="0" Source="{Binding ImageUrl}"
                                               Width="36" Height="36" Stretch="Uniform"
                                               b:ImageZoom.IsEnabled="True"/>
                                        <StackPanel Grid.Column="1" Margin="6,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock FontSize="11" Foreground="Gray">
                                                <Run Text="BL:"/>
                                                <Run Text="{Binding BricklinkId, Mode=OneWay}" FontFamily="Consolas"/>
                                                <Run Text=" • Farbe:"/>
                                                <Run Text="{Binding ColorLabel, Mode=OneWay}"/>
                                                <Run Text=" • Anzahl:"/>
                                                <Run Text="{Binding Quantity, Mode=OneWay}" FontWeight="SemiBold"/>
                                                <Run Text=" • Fach:"/>
                                                <Run Text="{Binding BinLabel, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Optionen -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Condition:"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="ConditionCombo"
                      Margin="0,0,16,4">
                <ComboBoxItem Content="Used (U)" Tag="U" IsSelected="True"/>
                <ComboBoxItem Content="New (N)"  Tag="N"/>
            </ComboBox>

            <TextBlock Grid.Row="0" Grid.Column="2" Text="Status:"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox Grid.Row="0" Grid.Column="3" x:Name="StatusCombo"
                      Margin="0,0,0,4">
                <ComboBoxItem Content="Include (I)" Tag="I" IsSelected="True"/>
                <ComboBoxItem Content="Exclude (X)" Tag="X"/>
            </ComboBox>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Remark:"
                       VerticalAlignment="Center" Margin="0,4,8,0"/>
            <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                     x:Name="RemarkBox" Margin="0,4,0,0"
                     ToolTip="Optional. Wird in das Remarks-Feld jeder Item-Zeile geschrieben. Leer = HBSort {Datum}."/>
        </Grid>

        <!-- Speicherort -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Speichern unter:"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" x:Name="PathBox"
                     IsReadOnly="True" VerticalAlignment="Center"/>
            <Button Grid.Column="2" Content="Aendern..."
                    Margin="8,0,0,0" Padding="10,2"
                    Click="BrowsePath_Click"/>
        </Grid>

        <!-- Cleanup-Block (nach Export sichtbar) -->
        <Border Grid.Row="4" x:Name="CleanupPanel"
                Visibility="Collapsed"
                Background="#E8F5E9" BorderBrush="#2E7D32"
                BorderThickness="1" CornerRadius="4"
                Padding="12" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock x:Name="CleanupHeader"
                           FontWeight="SemiBold" FontSize="13"
                           Margin="0,0,0,4"/>
                <TextBlock x:Name="CleanupBody"
                           TextWrapping="Wrap" FontSize="12"
                           Margin="0,0,0,8"/>
                <CheckBox x:Name="ReleaseBinsCheckbox"
                          IsChecked="True"
                          Margin="0,0,0,8">
                    <TextBlock x:Name="ReleaseBinsLabel"
                               TextWrapping="Wrap"/>
                </CheckBox>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Beibehalten" Width="120" Margin="0,0,8,0"
                            Click="KeepFigures_Click"/>
                    <Button Content="Entfernen" Width="120"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="RemoveFigures_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Buttons (vor Export) -->
        <StackPanel Grid.Row="5" x:Name="ActionPanel"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Abbrechen" IsCancel="True" Width="120"
                    Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Exportieren" Width="120"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="Export_Click"/>
        </StackPanel>
    </Grid>
</Window>
