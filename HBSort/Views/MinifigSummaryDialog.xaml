<Window x:Class="HBSort.Views.MinifigSummaryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Wartende Figur"
        Icon="../Resources/app.ico"
        Width="600" Height="640"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>     <!-- 0: Header -->
            <RowDefinition Height="Auto"/>     <!-- 1: Notizen -->
            <RowDefinition Height="*"/>        <!-- 2: Teileliste -->
            <RowDefinition Height="Auto"/>     <!-- 3: Verschieben-Combo (nur Waiting) -->
            <RowDefinition Height="Auto"/>     <!-- 4: Phase 8 - Verkaufsempfehlung (nur Complete + Provider!=None) -->
            <RowDefinition Height="Auto"/>     <!-- 5: Buttons -->
        </Grid.RowDefinitions>

        <!-- Header: Bild + Name + BL-ID + Bin -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0" Source="{Binding ImageUrl}"
                   Width="100" Height="100" Stretch="Uniform"
                   VerticalAlignment="Top"/>

            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}"
                           FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Margin="0,4,0,0" FontSize="12">
                    <Run Text="BL:" Foreground="Gray"/>
                    <Run Text="{Binding BricklinkId, Mode=OneWay}" FontFamily="Consolas"/>
                </TextBlock>
                <TextBlock Margin="0,2,0,0" FontSize="12">
                    <Run Text="Fach:" Foreground="Gray"/>
                    <Run Text="{Binding BinLabel, Mode=OneWay}" FontWeight="SemiBold"/>
                </TextBlock>
                <TextBlock Margin="0,2,0,0" FontSize="12">
                    <Run Text="Fortschritt:" Foreground="Gray"/>
                    <Run Text="{Binding ProgressLabel, Mode=OneWay}"/>
                </TextBlock>
                <ProgressBar Margin="0,4,0,0" Height="8"
                             Minimum="0" Maximum="1"
                             Value="{Binding ProgressFraction, Mode=OneWay}"/>

                <!-- Phase 6: KOMPLETT-Badge bei Status=Complete -->
                <TextBlock Text="✓ KOMPLETT"
                           Foreground="#2E7D32" FontWeight="Bold" FontSize="14"
                           Visibility="{Binding IsComplete, Converter={StaticResource BoolToVisibility}}"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Notizen -->
        <TextBlock Grid.Row="1" Margin="0,12,0,4"
                   Text="{Binding NotesDisplay}"
                   Foreground="Gray" FontStyle="Italic"
                   TextWrapping="Wrap"
                   Visibility="{Binding HasNotes, Converter={StaticResource BoolToVisibility}}"/>

        <!-- Teileliste mit Sammel-Status -->
        <Border Grid.Row="2" Margin="0,8,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="1" CornerRadius="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Parts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                    BorderThickness="0,0,0,1" Padding="8,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsCompleted, Mode=OneWay}"
                                              VerticalAlignment="Center"
                                              Tag="{Binding}"
                                              Click="PartCheckBox_Click"
                                              ToolTip="Klick: Teil als gefunden markieren / Markierung aufheben."/>
                                    <Image Grid.Column="1" Source="{Binding ImageUrl}"
                                           Width="40" Height="40" Stretch="Uniform"
                                           Margin="8,0,0,0"/>
                                    <Border Grid.Column="2" Width="16" Height="16"
                                            Background="{Binding SwatchBrush}"
                                            BorderBrush="Black" BorderThickness="1"
                                            Margin="8,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="3" Margin="6,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PartName}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock FontSize="11" Foreground="Gray">
                                            <Run Text="BL:" />
                                            <Run Text="{Binding PartNumber, Mode=OneWay}" FontFamily="Consolas"/>
                                            <Run Text=" • "/>
                                            <Run Text="{Binding ColorName, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="4"
                                               Text="{Binding QuantityLabel}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Margin="6,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Verschieben: Lagerfach-Auswahl (Phase 6: nur fuer wartende Figuren) -->
        <Grid Grid.Row="3" Margin="0,12,0,0"
              Visibility="{Binding IsWaiting, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Verschieben nach:"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox Grid.Column="1" x:Name="MoveTargetCombo"
                      ItemsSource="{Binding AvailableBins}"
                      DisplayMemberPath="Label"
                      SelectedItem="{Binding MoveTarget}"/>
        </Grid>

        <!-- Phase 8: Verkaufsempfehlung (nur sichtbar wenn Status=Complete + Provider!=None) -->
        <Border Grid.Row="4" Margin="0,12,0,0"
                Background="#F5F5F5" BorderBrush="#BDBDBD"
                BorderThickness="1" CornerRadius="4"
                Padding="12"
                Visibility="{Binding ShowSalesRecommendation, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Verkaufsempfehlung"
                               FontWeight="SemiBold" FontSize="13"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Neu laden"
                            Padding="8,2"
                            Command="{Binding ReloadPricesCommand}"
                            IsEnabled="{Binding IsLoadingPrices, Converter={StaticResource InverseBoolToVisibility}, ConverterParameter=true}"/>
                </Grid>

                <!-- Lade-Anzeige -->
                <TextBlock Text="Lade Preise..." Foreground="Gray" FontStyle="Italic" FontSize="11"
                           Visibility="{Binding IsLoadingPrices, Converter={StaticResource BoolToVisibility}}"/>

                <!-- Fehler-Anzeige -->
                <TextBlock Text="{Binding PriceErrorText}" Foreground="#C62828" FontSize="11"
                           TextWrapping="Wrap" Margin="0,0,0,4"/>

                <!-- Daten-Anzeige -->
                <StackPanel Visibility="{Binding HasSalesRecommendation, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding SalesRecommendation.ProviderInfo}"
                               Foreground="Gray" FontSize="11" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding MinifigPriceLabel}" FontFamily="Consolas" FontSize="12"/>
                    <TextBlock Text="{Binding PartsPriceLabel}" FontFamily="Consolas" FontSize="12"/>
                    <TextBlock Text="{Binding SalesAdviceText}"
                               FontWeight="SemiBold" FontSize="13"
                               Margin="0,8,0,0"
                               Foreground="{Binding SalesAdviceBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">

            <!-- Loeschen: immer sichtbar -->
            <Button Content="Loeschen" Width="120" Margin="0,0,8,0"
                    Click="Delete_Click"
                    Background="#D32F2F" Foreground="White"
                    ToolTip="Figur komplett aus der DB entfernen. Floating-Parts mit Origin-Verbindung bleiben erhalten."/>

            <!-- Zerlegen: nur bei Status=Waiting -->
            <Button Content="Zerlegen" Width="120" Margin="0,0,8,0"
                    Click="GiveUp_Click"
                    Visibility="{Binding IsWaiting, Converter={StaticResource BoolToVisibility}}"
                    ToolTip="Figur zerlegen: gesammelte Teile wandern als Einzelteile in den Pool, die Figur selbst wird geloescht."/>

            <!-- Wieder oeffnen: nur bei Status=Complete (Phase 6) -->
            <Button Content="Wieder oeffnen" Width="130" Margin="0,0,8,0"
                    Click="Reopen_Click"
                    Visibility="{Binding IsComplete, Converter={StaticResource BoolToVisibility}}"
                    ToolTip="Status zurueck auf Wartend setzen, falls man sich vertan hat."/>

            <!-- Verschieben: nur bei Status=Waiting -->
            <Button Content="Verschieben" Width="120" Margin="0,0,8,0"
                    Click="Move_Click"
                    Visibility="{Binding IsWaiting, Converter={StaticResource BoolToVisibility}}"
                    ToolTip="Figur in das oben gewaehlte Fach verschieben."/>

            <!-- Schliessen: immer sichtbar -->
            <Button Content="Schliessen" IsCancel="True" Width="120"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
