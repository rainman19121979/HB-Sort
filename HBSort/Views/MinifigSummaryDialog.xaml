<Window x:Class="HBSort.Views.MinifigSummaryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Wartende Figur"
        Icon="../Resources/app.ico"
        Width="600" Height="640"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: Bild + Name + BL-ID + Bin -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0" Source="{Binding ImageUrl}"
                   Width="100" Height="100" Stretch="Uniform"
                   VerticalAlignment="Top"/>

            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}"
                           FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Margin="0,4,0,0" FontSize="12">
                    <Run Text="BL:" Foreground="Gray"/>
                    <Run Text="{Binding BricklinkId, Mode=OneWay}" FontFamily="Consolas"/>
                </TextBlock>
                <TextBlock Margin="0,2,0,0" FontSize="12">
                    <Run Text="Fach:" Foreground="Gray"/>
                    <Run Text="{Binding BinLabel, Mode=OneWay}" FontWeight="SemiBold"/>
                </TextBlock>
                <TextBlock Margin="0,2,0,0" FontSize="12">
                    <Run Text="Fortschritt:" Foreground="Gray"/>
                    <Run Text="{Binding ProgressLabel, Mode=OneWay}"/>
                </TextBlock>
                <ProgressBar Margin="0,4,0,0" Height="8"
                             Minimum="0" Maximum="1"
                             Value="{Binding ProgressFraction, Mode=OneWay}"/>
            </StackPanel>
        </Grid>

        <!-- Notizen -->
        <TextBlock Grid.Row="1" Margin="0,12,0,4"
                   Text="{Binding NotesDisplay}"
                   Foreground="Gray" FontStyle="Italic"
                   TextWrapping="Wrap"
                   Visibility="{Binding HasNotes, Converter={StaticResource BoolToVisibility}}"/>

        <!-- Teileliste mit Sammel-Status -->
        <Border Grid.Row="2" Margin="0,8,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="1" CornerRadius="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Parts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                    BorderThickness="0,0,0,1" Padding="8,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsCompleted, Mode=OneWay}"
                                              VerticalAlignment="Center"
                                              Tag="{Binding}"
                                              Click="PartCheckBox_Click"
                                              ToolTip="Klick: Teil als gefunden markieren / Markierung aufheben."/>
                                    <Image Grid.Column="1" Source="{Binding ImageUrl}"
                                           Width="40" Height="40" Stretch="Uniform"
                                           Margin="8,0,0,0"/>
                                    <Border Grid.Column="2" Width="16" Height="16"
                                            Background="{Binding SwatchBrush}"
                                            BorderBrush="Black" BorderThickness="1"
                                            Margin="8,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="3" Margin="6,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PartName}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock FontSize="11" Foreground="Gray">
                                            <Run Text="BL:" />
                                            <Run Text="{Binding PartNumber, Mode=OneWay}" FontFamily="Consolas"/>
                                            <Run Text=" • "/>
                                            <Run Text="{Binding ColorName, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="4"
                                               Text="{Binding QuantityLabel}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Margin="6,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Verschieben: Lagerfach-Auswahl -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Verschieben nach:"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox Grid.Column="1" x:Name="MoveTargetCombo"
                      ItemsSource="{Binding AvailableBins}"
                      DisplayMemberPath="Label"
                      SelectedItem="{Binding MoveTarget}"/>
        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Loeschen" Width="120" Margin="0,0,8,0"
                    Click="Delete_Click"
                    Background="#D32F2F" Foreground="White"
                    ToolTip="Figur komplett aus der DB entfernen. Floating-Parts mit Origin-Verbindung bleiben erhalten."/>
            <Button Content="Zerlegen" Width="120" Margin="0,0,8,0"
                    Click="GiveUp_Click"
                    ToolTip="Figur zerlegen: gesammelte Teile wandern als Einzelteile in den Pool, die Figur selbst wird geloescht."/>
            <Button Content="Verschieben" Width="120" Margin="0,0,8,0"
                    Click="Move_Click"
                    ToolTip="Figur in das oben gewaehlte Fach verschieben."/>
            <Button Content="Schliessen" IsCancel="True" Width="120"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
