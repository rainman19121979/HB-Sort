<Window x:Class="HBSort.Views.BinDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Inhalt eines Faches"
        Width="600" Height="700"
        MinWidth="400" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="Auto"/>  <!-- Trenner -->
            <RowDefinition Height="*"/>     <!-- Inhalt -->
            <RowDefinition Height="Auto"/>  <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock>
                <Run Text="Inhalt von "/>
                <Run Text="&quot;" />
                <Run Text="{Binding BinLabel, Mode=OneWay}" FontWeight="SemiBold"/>
                <Run Text="&quot;" />
            </TextBlock>
            <TextBlock Margin="0,4,0,0">
                <Run Text="Status:" Foreground="Gray"/>
                <Run Text="{Binding StatusText, Mode=OneWay}"/>
            </TextBlock>
            <TextBlock>
                <Run Text="Erstellt:" Foreground="Gray"/>
                <Run Text="{Binding CreatedAtText, Mode=OneWay}"/>
            </TextBlock>
        </StackPanel>

        <Separator Grid.Row="1" Margin="0,8"/>

        <!-- Inhalts-Listen (scrollbar) -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Empty-State -->
                <TextBlock Text="(keine Inhalte)"
                           Foreground="Gray" FontStyle="Italic"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"/>

                <!-- FIGUREN -->
                <StackPanel Margin="0,0,0,12">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Minifigs.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4">
                        <Run Text="FIGUREN ("/><Run Text="{Binding Minifigs.Count, Mode=OneWay}"/><Run Text=")"/>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding Minifigs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                        BorderThickness="0,0,0,1" Padding="0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Image Grid.Column="0" Source="{Binding ImageUrl}"
                                               Width="60" Height="60" Stretch="Uniform"/>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock TextWrapping="Wrap">
                                                <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                                <Run Text=" ("/><Run Text="{Binding BricklinkId, Mode=OneWay}" FontFamily="Consolas"/><Run Text=")"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding DisplayLine}"
                                                       Foreground="Gray" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- EINZELTEILE -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FloatingParts.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4">
                        <Run Text="EINZELTEILE ("/><Run Text="{Binding FloatingParts.Count, Mode=OneWay}"/><Run Text=")"/>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding FloatingParts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                        BorderThickness="0,0,0,1" Padding="0,6,8,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Image Grid.Column="0" Source="{Binding ImageUrl}"
                                               Width="50" Height="50" Stretch="Uniform"/>
                                        <Border Grid.Column="1" Width="20" Height="20"
                                                Background="{Binding ColorSwatch}"
                                                BorderBrush="Black" BorderThickness="1"
                                                Margin="8,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="2" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayLine}" FontWeight="SemiBold"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock FontSize="11" Foreground="Gray" Margin="0,2,0,0">
                                                <Run Text="BL-Color:"/>
                                                <Run Text="{Binding ColorId, Mode=OneWay}" FontFamily="Consolas"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" Text="{Binding QuantityLabel}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Schliessen" IsDefault="True" IsCancel="True" Width="120"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
