<Window x:Class="HBSort.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:vm="clr-namespace:HBSort.ViewModels"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Einstellungen"
        Icon="../Resources/app.ico"
        Width="1100" Height="720"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ToolTipService.IsEnabled="{DynamicResource TooltipsEnabled}">
    <!--
        CenterOwner: Fenster erscheint mittig Ã¼ber dem Hauptfenster.
        ResizeMode="NoResize": Feste GrÃ¶ÃŸe, kein Resize-Handle.
        Phase 1.5: Auf Tabs umgebaut, neuer Tab "Katalog".
    -->

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" x:Name="MainTabControl">

            <!-- ====================================== -->
            <!-- TAB 1: ERKENNUNG (UX X.11)
                 Kamera-Auswahl, Erkennungs-Schwellwerte, Timing, Sound.
                 War frueher der "Allgemein"-Tab; aufgeteilt damit das Thema
                 fokussiert bleibt. Der Tooltips-Toggle wandert in den
                 separaten "Darstellung"-Tab. -->
            <!-- ====================================== -->
            <TabItem Header="Erkennung">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>

                        <!-- === KAMERA === -->
                        <TextBlock Text="Kamera" FontSize="16" FontWeight="SemiBold"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Kamera:" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AvailableCameras}"
                                      SelectedIndex="{Binding SelectedCameraIndex}"
                                      HorizontalAlignment="Stretch"
                                      ToolTip="Waehle die USB-Kamera fuer die Erkennung."/>
                        </Grid>

                        <Separator/>

                        <!-- === SCHWELLWERTE === -->
                        <TextBlock Text="Erkennungs-Schwellwerte" FontSize="16" FontWeight="SemiBold"/>

                        <TextBlock Text="Diese Werte bestimmen, wie sicher sich die Erkennung sein muss:"
                                   Foreground="Gray" TextWrapping="Wrap" FontSize="12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <!-- Auto-Akzeptanz -->
                            <TextBlock Grid.Row="0" Text="Auto-Akzeptanz:"
                                       VerticalAlignment="Center"
                                       ToolTip="Ab diesem Score wird das Ergebnis automatisch uebernommen + BL-Lookup sofort gestartet. Niedrige Scores fuehren zur Top-3-Auswahl, der BL-Call passiert erst bei manuellem Klick."/>
                            <Slider Grid.Row="0" Grid.Column="1"
                                    Minimum="0.5" Maximum="1.0"
                                    Value="{Binding ScoreThresholdAuto}"
                                    TickFrequency="0.05" IsSnapToTickEnabled="True"
                                    ToolTip="Empfohlen: 0.95 (nur sehr sichere Treffer auto-akzeptieren)"/>
                            <TextBlock Grid.Row="0" Grid.Column="2"
                                       Text="{Binding ScoreThresholdAuto, StringFormat='{}{0:P0}'}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>

                            <!-- Auswahl-Anzeige -->
                            <TextBlock Grid.Row="1" Text="Auswahl zeigen ab:"
                                       VerticalAlignment="Center" Margin="0,8,0,0"
                                       ToolTip="Unter diesem Score wird immer die Auswahl-UI gezeigt"/>
                            <Slider Grid.Row="1" Grid.Column="1" Margin="0,8,0,0"
                                    Minimum="0.3" Maximum="1.0"
                                    Value="{Binding ScoreThresholdShowSelection}"
                                    TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,8,0,0"
                                       Text="{Binding ScoreThresholdShowSelection, StringFormat='{}{0:P0}'}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>

                            <!-- Minimum -->
                            <TextBlock Grid.Row="2" Text="Mindest-Score:"
                                       VerticalAlignment="Center" Margin="0,8,0,0"
                                       ToolTip="Unter diesem Score gilt das Ergebnis als nicht erkannt"/>
                            <Slider Grid.Row="2" Grid.Column="1" Margin="0,8,0,0"
                                    Minimum="0.1" Maximum="0.8"
                                    Value="{Binding ScoreThresholdMin}"
                                    TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Margin="0,8,0,0"
                                       Text="{Binding ScoreThresholdMin, StringFormat='{}{0:P0}'}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>

                        <Separator/>

                        <!-- === TIMING === -->
                        <TextBlock Text="Timing" FontSize="16" FontWeight="SemiBold"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Scan-Cooldown:"
                                       VerticalAlignment="Center"
                                       ToolTip="Pause zwischen zwei Scans (verhindert Doppelscans)"/>
                            <Slider Grid.Column="1"
                                    Minimum="500" Maximum="3000"
                                    Value="{Binding ScanCooldownMs}"
                                    TickFrequency="100" IsSnapToTickEnabled="True"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding ScanCooldownMs, StringFormat='{}{0} ms'}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>

                        <Separator/>

                        <TextBlock Text="Sortier-Workflow" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Beim Scannen einer Figur:"
                                   Margin="0,4,0,4"/>
                        <RadioButton Content="Nichts vorab abgehakt - ich klicke an was ich habe"
                                     GroupName="DefaultPartsCollectedGroup"
                                     IsChecked="{Binding DefaultPartsNothingCollected, Mode=TwoWay}"
                                     Margin="0,2,0,2"
                                     ToolTip="Gewohnheitspfad fuer User die einzelne Teile sammeln und bestaetigen."/>
                        <RadioButton Content="Alles vorab abgehakt - ich klicke ab was fehlt"
                                     GroupName="DefaultPartsCollectedGroup"
                                     IsChecked="{Binding DefaultPartsAllCollected, Mode=TwoWay}"
                                     Margin="0,2,0,2"
                                     ToolTip="Geeignet wenn du die meisten Teile schon hast und nur fehlende rausnimmst."/>
                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="Gray"
                                   Margin="0,4,0,8">
                            Diese Einstellung gilt fuer das Anlegen einer neu gescannten Figur.
                            Du kannst die Auswahl pro Figur immer noch manuell anpassen.
                        </TextBlock>

                        <!-- UX X.31 (v0.1.18): Maximum Complete-Figuren pro Lagerfach -->
                        <TextBlock Text="Maximale Complete-Figuren pro Lagerfach:"
                                   FontWeight="SemiBold" Margin="0,12,0,4"/>
                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="Gray"
                                   Margin="0,0,0,4">
                            Bestimmt wie viele zusammengebaute Figuren sich ein Fach teilen
                            duerfen. Beim Vorschlag fuers Einlagern wird so lange ins gleiche
                            Fach gestapelt, bis dieses Limit erreicht ist; danach schlaegt
                            die App ein neues freies Fach vor. Default: 5. Min 1, Max 999.
                        </TextBlock>
                        <TextBox Text="{Binding MaxCompleteFiguresPerBin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Width="80" HorizontalAlignment="Left"
                                 ToolTip="Wieviele komplette Figuren duerfen sich ein Fach teilen? Default 5."/>

                        <!-- UX X.32 v0.1.19-beta.4: Maximum wartende Figuren pro Lagerfach -->
                        <TextBlock Text="Maximale wartende Figuren pro Lagerfach:"
                                   FontWeight="SemiBold" Margin="0,12,0,4"/>
                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="Gray"
                                   Margin="0,0,0,4">
                            Bestimmt wie viele wartende (noch unfertige) Figuren sich ein
                            Fach teilen duerfen. Bei 1 bekommt jede wartende Figur ihr
                            eigenes Fach (strikt). Bei groesseren Werten landen mehrere
                            wartende Figuren parallel im gleichen Fach. Default: 3. Min 1, Max 999.
                        </TextBlock>
                        <TextBox Text="{Binding MaxWaitingFiguresPerBin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Width="80" HorizontalAlignment="Left"
                                 ToolTip="Wieviele wartende Figuren duerfen sich ein Fach teilen? Default 3."/>

                        <!-- UX X.33 v0.1.19-beta.7 Block M: Maximale Teile-Kategorien pro
                             Lagerfach entfernt - die alte Heuristik wurde durch das user-
                             pflegbare CategoryToBinMapping (Tab "Lagerfaecher" -> Sektion
                             "Kategorien-Zuordnung") abgeloest. -->

                        <Separator/>

                        <TextBlock Text="Sonstiges" FontSize="16" FontWeight="SemiBold"/>

                        <CheckBox Content="Sound-Effekte aktivieren"
                                  IsChecked="{Binding SoundEnabled}"
                                  ToolTip="Spielt einen kurzen Ton bei jedem Scan ab. Standard: aus."/>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ====================================== -->
            <!-- TAB 2: DARSTELLUNG (UX X.11)
                 Aktuell nur der Tooltips-Toggle. Bewusst eigener Tab statt
                 Unter-Sektion des Erkennungs-Tabs - Darstellungs-Settings
                 sind ein anderes Thema und sollen in zukuenftigen Iterationen
                 hier ergaenzt werden koennen (z.B. Theme-Wahl, Akzentfarbe).
                 Darstellungsdichte (Compact/Normal/Comfortable) wurde in
                 dieser Iteration entfernt - das Compact-Profil ist jetzt
                 fester Stand. -->
            <!-- ====================================== -->
            <TabItem Header="Darstellung">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>

                        <TextBlock Text="Tooltips" FontSize="16" FontWeight="SemiBold"/>

                        <CheckBox Content="Tooltips anzeigen"
                                  IsChecked="{Binding ShowTooltips}"
                                  Margin="0,4,0,0"
                                  ToolTip="Zeigt erklaerende Hinweise wenn du mit der Maus ueber Buttons und Felder faehrst."/>
                        <TextBlock Text="Tooltips ueberall in der App. Standard: an. Wirkt sofort, kein Neustart noetig."
                                   Foreground="Gray" FontSize="11" FontStyle="Italic"
                                   Margin="24,0,0,0"/>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Hinweis: Frueher gab es hier einen Tab "Katalog" fuer die
                 Rebrickable catalog.db. Wurde 2026-05-02 entfernt; Stammdaten
                 kommen jetzt aus bl_cache.db, sichtbar im Tab "BrickLink"
                 unter "BL-Catalog-Daten". -->

            <!-- ============================================================ -->
            <!-- TAB: BRICKLINK (UX X.11)
                 Vereint die alten 3 Tabs "BrickLink-API" + "BL-Catalog-Daten"
                 + "Preise" in einem scrollbaren Tab. Vier Sektionen:
                 1) API-Zugang (Tokens, Test, IP-Whitelist)
                 2) API-Nutzung (Counter + Schwellwerte)
                 3) Preise (Provider, Filter, Korrekturen, Lade-Modi)
                 4) Catalog-Daten (BrickStore-Bulk-Import)

                 Cache-Sektionen (BL-Daten-Cache, Preis-Cache-Verwaltung,
                 TTL-Felder) wandern in den separaten "Cache"-Tab in
                 Commit 4. Die alten 3 Tabs bleiben in dieser Iteration
                 noch sichtbar - werden in Commit 5 entfernt. -->
            <!-- ============================================================ -->
            <TabItem Header="BrickLink">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>

                        <!-- ===== SEKTION 1: API-Zugang ===== -->
                        <TextBlock Text="API-Zugang"
                                   FontSize="15" FontWeight="SemiBold"
                                   Margin="0,0,0,4"/>

                        <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="12" Margin="0,0,0,8">
                            Du brauchst einen BrickLink-Verkaeufer-Account und eine
                            registrierte Consumer-Application. Die Tokens werden mit
                            Windows-DPAPI verschluesselt in settings.json gespeichert.
                        </TextBlock>

                        <TextBlock>
                            <Hyperlink NavigateUri="https://www.bricklink.com/v2/api/register_consumer.page"
                                       RequestNavigate="Hyperlink_RequestNavigate">
                                BL-Consumer-Registrierung oeffnen
                            </Hyperlink>
                        </TextBlock>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Consumer Key:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,4,4"
                                     Text="{Binding BricklinkConsumerKey, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="1" Text="Consumer Secret:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,4,4"
                                     Text="{Binding BricklinkConsumerSecret, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="2" Text="Token Value:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,4,4"
                                     Text="{Binding BricklinkTokenValue, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="3" Text="Token Secret:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,4,4"
                                     Text="{Binding BricklinkTokenSecret, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <TextBlock Foreground="Gray" FontSize="11" FontStyle="Italic" Margin="0,4,0,8">
                            Hinweis: Tokens sind als reiner Text sichtbar - das Fenster ist
                            nur lokal und die Werte werden beim Speichern verschluesselt.
                        </TextBlock>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="Tokens speichern"
                                    Command="{Binding SaveBricklinkTokensCommand}"
                                    Width="160" Margin="0,0,8,0"/>
                            <Button Content="Verbindung testen"
                                    Command="{Binding TestBricklinkConnectionCommand}"
                                    Width="160" Margin="0,0,8,0"/>
                            <Button Content="Loeschen"
                                    Command="{Binding ClearBricklinkTokensCommand}"
                                    Width="120"/>
                        </StackPanel>

                        <TextBlock Text="Status" FontSize="13" FontWeight="SemiBold" Margin="0,12,0,0"/>
                        <TextBlock Text="{Binding BricklinkStatusText}" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding BricklinkTestResultText}"
                                   Margin="0,2,0,0" FontStyle="Italic"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>

                        <TextBlock Text="IP-Whitelist" FontSize="13" FontWeight="SemiBold" Margin="0,12,0,0"/>
                        <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="12" Margin="0,4,0,0">
                            Deine externe IP muss im BL-Consumer-Profile in der
                            "Allowed IP"-Liste eingetragen sein, sonst antwortet die API mit HTTP 403.
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Aktuelle IP anzeigen"
                                    Command="{Binding ShowExternalIpCommand}"
                                    Width="200" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding BricklinkExternalIp}"
                                       VerticalAlignment="Center"
                                       FontFamily="Consolas"/>
                        </StackPanel>

                        <Separator Margin="0,16,0,16"/>

                        <!-- ===== SEKTION 2: API-Nutzung ===== -->
                        <TextBlock Text="API-Nutzung"
                                   FontSize="15" FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Letzte 24h (rolling):"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding RateLimitCalls24h}"/>

                            <TextBlock Grid.Row="1" Text="Heute (seit 00:00):" Margin="0,2,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,2,0,0"
                                       Text="{Binding RateLimitCallsToday}"/>

                            <TextBlock Grid.Row="2" Text="Letzte Stunde:" Margin="0,2,0,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,2,0,0"
                                       Text="{Binding RateLimitCallsThisHour}"/>

                            <TextBlock Grid.Row="3" Text="Status:" Margin="0,2,0,0"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,2,0,0"
                                       Text="{Binding RateLimitStateText}" FontWeight="SemiBold"/>

                            <TextBlock Grid.Row="4" Text="Aelteste Call im Window:" Margin="0,2,0,0"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,2,0,0"
                                       Text="{Binding RateLimitOldestCallText}"/>
                        </Grid>

                        <TextBlock Text="Schwellwerte" FontSize="13" FontWeight="SemiBold" Margin="0,12,0,0"/>
                        <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="12" Margin="0,4,0,0">
                            Soft = gelber Toast bei Erreichen. Hard = keine API-Calls mehr (nur Cache).
                            BL-Limit (fix): 5000 Calls / 24h.
                        </TextBlock>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Soft-Threshold:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Text="{Binding BricklinkSoftThreshold, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Bei diesem Stand kommt eine gelbe Warnung. Default 1000."/>

                            <TextBlock Grid.Row="1" Text="Hard-Threshold:" VerticalAlignment="Center" Margin="0,4,0,0"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,4,0,0"
                                     Text="{Binding BricklinkHardThreshold, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Hard-Stop: ab hier nur noch Cache, keine API-Calls. Default 4500, max 4900."/>

                            <TextBlock Grid.Row="2" Text="BL-Limit (fix):" VerticalAlignment="Center" Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,4,0,0"
                                       Text="{Binding BricklinkRealLimit}" Foreground="Gray"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Schwellwerte speichern"
                                    Command="{Binding SaveRateLimitThresholdsCommand}"
                                    Width="220"/>
                            <TextBlock Text="{Binding RateLimitSaveMessage}"
                                       VerticalAlignment="Center" Margin="12,0,0,0"
                                       FontStyle="Italic" Foreground="Gray"/>
                        </StackPanel>

                        <Separator Margin="0,16,0,16"/>

                        <!-- ===== SEKTION 3: Preise (ohne Cache-Sektionen) ===== -->
                        <TextBlock Text="Preise"
                                   FontSize="15" FontWeight="SemiBold"
                                   Margin="0,0,0,4"/>

                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="Gray" Margin="0,0,0,8"
                                   Text="Bestimmt, woher die Preise fuer die Verkaufsempfehlung im Detail-Dialog kommen."/>

                        <RadioButton Content="Keine Preise"
                                     GroupName="PriceProviderBl"
                                     IsChecked="{Binding IsPriceProviderNone, Mode=OneWay}"
                                     Click="PriceProviderNone_Click"
                                     Margin="0,0,0,4"/>
                        <RadioButton Content="BrickLink-API (benoetigt BL-Tokens, siehe oben)"
                                     GroupName="PriceProviderBl"
                                     IsChecked="{Binding IsPriceProviderBricklink, Mode=OneWay}"
                                     Click="PriceProviderBricklink_Click"
                                     Margin="0,0,0,12"/>

                        <StackPanel Visibility="{Binding IsPriceProviderBricklink, Converter={StaticResource BoolToVisibility}}">

                            <TextBlock Text="BL-API-Filter" FontSize="13" FontWeight="SemiBold"
                                       Margin="0,4,0,6"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Guide-Typ:"
                                           VerticalAlignment="Center" Margin="0,0,0,4"/>
                                <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,4"
                                          SelectedValue="{Binding PriceGuideType, Mode=TwoWay}"
                                          SelectedValuePath="Tag">
                                    <ComboBoxItem Content="Sold (was wirklich verkauft wurde)" Tag="sold"/>
                                    <ComboBoxItem Content="Stock (aktuelle Angebote)" Tag="stock"/>
                                </ComboBox>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Spalte:"
                                           VerticalAlignment="Center" Margin="0,0,0,4"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,4"
                                          SelectedValue="{Binding PricePriceColumn, Mode=TwoWay}"
                                          SelectedValuePath="Tag">
                                    <ComboBoxItem Content="Min" Tag="min"/>
                                    <ComboBoxItem Content="Avg" Tag="avg"/>
                                    <ComboBoxItem Content="Qty-Avg (Default)" Tag="qty_avg"/>
                                    <ComboBoxItem Content="Max" Tag="max"/>
                                </ComboBox>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Waehrung:"
                                           VerticalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,4"
                                         MaxLength="3"
                                         Text="{Binding PriceCurrency, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <!-- UX X.34 v0.1.20: Region/Land Either-Or-Filter.
                                 RadioButton-Gruppe statt zwei separater Felder -
                                 BL-API erwartet nur eines von beiden, vorher haben
                                 wir beide gleichzeitig geschickt was zu wenig/keinen
                                 Daten gefuehrt hat (insb. bei Sold + DE). -->
                            <TextBlock Text="Region/Land-Filter" FontSize="13" FontWeight="SemiBold"
                                       Margin="0,8,0,6"/>
                            <StackPanel Margin="0,0,0,8">
                                <RadioButton GroupName="PriceFilter"
                                             IsChecked="{Binding IsFilterModeGlobal, Mode=OneWay}"
                                             Click="PriceFilterGlobal_Click"
                                             Content="Global (keine Filterung) - groesste Datenbasis"
                                             Margin="0,0,0,6"
                                             ToolTip="Alle Verkaufstransaktionen weltweit. Empfohlen bei seltenen Items oder generell."/>

                                <RadioButton GroupName="PriceFilter"
                                             IsChecked="{Binding IsFilterModeRegion, Mode=OneWay}"
                                             Click="PriceFilterRegion_Click"
                                             Margin="0,0,0,4"
                                             ToolTip="Filter auf eine Region (mehrere Laender). Mittelweg zwischen lokal und global.">
                                    <RadioButton.Content>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Region:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <ComboBox Width="180"
                                                      IsEnabled="{Binding IsFilterModeRegion}"
                                                      SelectedValue="{Binding PriceRegion, Mode=TwoWay}"
                                                      SelectedValuePath="Tag"
                                                      ToolTip="Region-Werte gemaess offizieller BL-API. 'eu' = nur EU-Mitgliedsstaaten (VAT-pflichtig), 'europe' = ganz Europa inkl. UK/CH.">
                                                <ComboBoxItem Content="europe" Tag="europe"/>
                                                <ComboBoxItem Content="eu (nur EU-Mitglieder)" Tag="eu"/>
                                                <ComboBoxItem Content="north_america" Tag="north_america"/>
                                                <ComboBoxItem Content="south_america" Tag="south_america"/>
                                                <ComboBoxItem Content="asia" Tag="asia"/>
                                                <ComboBoxItem Content="middle_east" Tag="middle_east"/>
                                                <ComboBoxItem Content="africa" Tag="africa"/>
                                                <ComboBoxItem Content="oceania" Tag="oceania"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </RadioButton.Content>
                                </RadioButton>

                                <RadioButton GroupName="PriceFilter"
                                             IsChecked="{Binding IsFilterModeCountry, Mode=OneWay}"
                                             Click="PriceFilterCountry_Click"
                                             ToolTip="Filter auf ein spezifisches Land (z.B. DE, US, GB). Engste Filterung - bei seltenen Items oft 0 Treffer.">
                                    <RadioButton.Content>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Land:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBox Width="60"
                                                     MaxLength="2"
                                                     IsEnabled="{Binding IsFilterModeCountry}"
                                                     Text="{Binding PriceCountryCode, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="ISO-Country-Code (DE, US, GB, ...)."/>
                                        </StackPanel>
                                    </RadioButton.Content>
                                </RadioButton>
                            </StackPanel>
                            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="Gray"
                                       Margin="0,0,0,12"
                                       Text="Hinweis: bei Sold + Land bedeutet Filter 'Verkaeufe DURCH Verkaeufer aus diesem Land' - das sind oft wenige. Bei wenig Daten weniger eng filtern (Region statt Land oder Global)."/>

                            <!-- UX X.34 v0.1.20: VAT-Modus. Default Brutto matcht
                                 die BL-Webseite-Preise; Vorgaengerverhalten war
                                 implizit Netto und hat gemischte Aggregate
                                 erzeugt (Privat brutto, gewerblich netto). -->
                            <TextBlock Text="VAT-Modus" FontSize="13" FontWeight="SemiBold"
                                       Margin="0,4,0,6"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="VAT-Behandlung:"
                                           VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding VatModeOptions}"
                                          SelectedValuePath="Mode"
                                          DisplayMemberPath="Label"
                                          SelectedValue="{Binding PriceVatMode, Mode=TwoWay}"
                                          ToolTip="Brutto (Y, Default): Preise inkl. VAT, matcht die BrickLink-Webseite. Netto (N): VAT abgezogen - gemischte Aggregate, nur fuer eigene VAT-Verkaeufer-Erloesabschaetzung. Norwegen (O): 25% VAT - Spezial-Fall."/>
                            </Grid>
                            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="Gray"
                                       Margin="0,0,0,12"
                                       Text="Brutto matcht die Preise auf der BL-Webseite. Aenderung wird beim naechsten Preis-Lookup wirksam (Cache-Refresh fuer den jeweiligen Eintrag)."/>

                            <TextBlock Text="Korrekturfaktoren" FontSize="13" FontWeight="SemiBold"
                                       Margin="0,4,0,6"/>
                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="Gray"
                                       Margin="0,0,0,6"
                                       Text="Negative Werte = Abschlag vom BL-Preis (z.B. -10 = 10% weniger)."/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Komplett-Figur (%):"
                                           VerticalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,8,4"
                                         Text="{Binding PriceCorrectionMinifigPercent, UpdateSourceTrigger=PropertyChanged, StringFormat=N1}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                           Text="{Binding MinifigPreviewLabel}"
                                           Foreground="{StaticResource StatusInfoBrush}" FontStyle="Italic"
                                           FontSize="11" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Einzelteile-Summe (%):"
                                           VerticalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,8,4"
                                         Text="{Binding PriceCorrectionPartsPercent, UpdateSourceTrigger=PropertyChanged, StringFormat=N1}"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                                           Text="{Binding PartsPreviewLabel}"
                                           Foreground="{StaticResource StatusInfoBrush}" FontStyle="Italic"
                                           FontSize="11"/>
                            </Grid>

                            <TextBlock Text="Preise laden" FontSize="13" FontWeight="SemiBold"
                                       Margin="0,4,0,6"/>
                            <TextBlock Text="Wann werden die Preise im Sortier-Tab oben rechts geladen?"
                                       FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                                       Margin="0,0,0,6"/>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="Komplett-Figur-Preis:"
                                           VerticalAlignment="Center" Margin="0,0,0,4"/>
                                <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,4"
                                          ItemsSource="{Binding PriceLoadModeOptions}"
                                          SelectedValuePath="Value"
                                          DisplayMemberPath="Label"
                                          SelectedValue="{Binding PriceAutoLoadCompletePrice, Mode=TwoWay}"
                                          ToolTip="Auto: jede Anzeige einer Figur loest 1 API-Aufruf an BrickLink aus.&#x0a;Manual: User klickt 'Preis laden' wenn gewollt (spart API-Calls)."/>

                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Text="Einzelteile-Preise:"
                                           VerticalAlignment="Center" Margin="0,0,0,4"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,4"
                                          ItemsSource="{Binding PriceLoadModeOptions}"
                                          SelectedValuePath="Value"
                                          DisplayMemberPath="Label"
                                          SelectedValue="{Binding PriceAutoLoadPartsPrice, Mode=TwoWay}"
                                          ToolTip="Auto: jede Anzeige einer Figur loest pro Teil-Typ einen API-Aufruf aus (z.B. 8 Teile = 8 Aufrufe).&#x0a;Manual: User klickt 'Teile-Preise laden' wenn gewollt (deutlich sparsamer)."/>
                            </Grid>

                            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="Gray"
                                       Margin="0,4,0,0">
                                <Run Text="Auto:"/>
                                Preise werden sofort beim Scannen einer Figur geladen.
                                <LineBreak/>
                                <Run Text="Manuell:"/>
                                Preise werden erst auf Klick geladen (spart API-Calls).
                            </TextBlock>

                            <!-- UX X.34 v0.1.20: Warnung bei Auto-Mode + API-Limit.
                                 Sichtbar wenn mindestens einer der beiden AutoLoad-
                                 Werte auf Auto steht. Hintergrund: Komplett = 1
                                 Call/Figur, Einzelteile = 1 Call PRO TEIL-TYP. Bei
                                 vielen Figuren oder schwacher Internet-Verbindung
                                 ist Manual sparsamer. -->
                            <Border Background="#FFF4E5" BorderBrush="#E65100"
                                    BorderThickness="1" CornerRadius="4"
                                    Padding="10" Margin="0,8,0,0"
                                    Visibility="{Binding ShowAutoLoadApiWarning, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Foreground="#E65100"
                                               Text="⚠ Hinweis zu Auto-Modus"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="#5D2E00" Margin="0,4,0,0">
                                        Jedes Anzeigen einer Figur loest API-Aufrufe an BrickLink aus
                                        (Limit: 5000 / 24h).
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" Foreground="#5D2E00" Margin="0,6,0,0">
                                        <Run FontWeight="SemiBold" Text="Komplett-Preis Auto:"/>
                                        <Run Text="1 API-Aufruf pro Figur."/>
                                        <LineBreak/>
                                        <Run FontWeight="SemiBold" Text="Einzelteile-Preis Auto:"/>
                                        <Run Text="1 API-Aufruf"/>
                                        <Run FontWeight="SemiBold" Text="pro Teil-Typ"/>
                                        <Run Text="(z.B. 8 Teile = 8 Aufrufe)."/>
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" Foreground="#5D2E00" Margin="0,6,0,0"
                                               Text="Bei vielen Figuren oder schwacher Internet-Verbindung empfiehlt sich der Manual-Modus mit gezieltem 'Preis laden'-Klick."/>
                                </StackPanel>
                            </Border>

                            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="Gray"
                                       FontStyle="Italic" Margin="0,8,0,0"
                                       Text="(Cache-Gueltigkeit + Cache-Verwaltung: siehe Tab &quot;Cache&quot;.)"/>
                        </StackPanel>

                        <Border Background="{StaticResource InfoBoxBackground}" BorderBrush="{StaticResource StatusInfoBrush}"
                                BorderThickness="1" CornerRadius="4"
                                Padding="12" Margin="0,16,0,0"
                                Visibility="{Binding IsPriceProviderNone, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock TextWrapping="Wrap" FontSize="12">
                                <Run Text="Hinweis:" FontWeight="SemiBold"/>
                                Bei "Keine Preise" wird im Detail-Dialog kompletter Figuren keine
                                Verkaufsempfehlung angezeigt. Alle anderen Funktionen bleiben
                                unveraendert.
                            </TextBlock>
                        </Border>

                        <Separator Margin="0,16,0,16"/>

                        <!-- ===== SEKTION 4: Catalog-Daten ===== -->
                        <TextBlock Text="Catalog-Daten"
                                   FontSize="15" FontWeight="SemiBold"
                                   Margin="0,0,0,4"/>

                        <Border Background="{StaticResource WarningBoxBackground}" BorderBrush="{StaticResource StatusWarningBrush}"
                                BorderThickness="1" CornerRadius="4"
                                Padding="12" Margin="0,4,0,12">
                            <TextBlock TextWrapping="Wrap" FontSize="12">
                                <Run FontWeight="Bold">Datenquelle &amp; Lizenz</Run>
                                <LineBreak/><LineBreak/>
                                BL-Catalog-Daten (Item-Stammdaten und Inventories) sind
                                Eigentum von BrickLink (bricklink.com). Diese Anwendung
                                nutzt die Aufbereitung dieser Daten durch BrickStore von
                                Robert Griebl (brickstore.dev, GPL-3,
                                github.com/rgriebl/brickstore-database).
                                <LineBreak/><LineBreak/>
                                LEGO ist eine Marke der LEGO-Gruppe, die diese Software
                                weder sponsert noch unterstuetzt.
                            </TextBlock>
                        </Border>

                        <TextBlock Text="BrickStore-Daten importieren"
                                   FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>

                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                                   Foreground="Gray" FontSize="12">
                            Importiert ca. 18.750 Minifig-Stammdaten und ihre
                            vollstaendigen Teilelisten. Dauer: 1-3 Minuten.
                            Empfohlen: Quartal-weise neu importieren.
                        </TextBlock>

                        <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4"
                                Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock>
                                    <Run Text="Items im Cache:" Foreground="Gray"/>
                                    <Run Text="{Binding BlCacheItemsCount, Mode=OneWay}" FontWeight="SemiBold"/>
                                </TextBlock>
                                <TextBlock>
                                    <Run Text="Subsets im Cache:" Foreground="Gray"/>
                                    <Run Text="{Binding BlCacheSubsetsCount, Mode=OneWay}" FontWeight="SemiBold"/>
                                </TextBlock>
                                <TextBlock>
                                    <Run Text="Cache-Groesse:" Foreground="Gray"/>
                                    <Run Text="{Binding BlCacheSizeLabel, Mode=OneWay}" FontWeight="SemiBold"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Button Content="Von GitHub importieren (empfohlen)"
                                Padding="12,8" HorizontalAlignment="Left"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="ImportFromGitHub_Click"
                                IsEnabled="{Binding IsNotImporting}"
                                ToolTip="Laed downloads.zip von github.com/rgriebl/brickstore-database und importiert direkt. Internet-Verbindung noetig (~12 MB)."
                                Margin="0,0,0,8"/>

                        <Expander Header="Aus lokalem Ordner importieren (optional)"
                                  Margin="0,8,0,0">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock TextWrapping="Wrap" Foreground="Gray"
                                           FontSize="11" Margin="0,0,0,8">
                                    Ordner muss enthalten: items/M.xml, items/P.xml, M/*.xml
                                </TextBlock>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding LocalImportFolder, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,8,0"/>
                                    <Button Grid.Column="1" Content="..." Width="40"
                                            Click="BrowseImportFolder_Click"/>
                                </Grid>
                                <Button Content="Aus lokalem Ordner importieren"
                                        Padding="12,8" HorizontalAlignment="Left"
                                        Click="ImportFromFolder_Click"
                                        IsEnabled="{Binding IsNotImporting}"
                                        Margin="0,8,0,0"/>
                            </StackPanel>
                        </Expander>

                        <!-- UX X.28 (v0.1.15): Auto-BL-Import. Default AUS - User
                             muss explizit aktivieren. Beim App-Start wird dann
                             alle X Tage im Hintergrund neu importiert. -->
                        <Separator Margin="0,16,0,8"/>

                        <TextBlock Text="Automatischer Import"
                                   FontSize="14" FontWeight="SemiBold"
                                   Margin="0,0,0,4"/>

                        <TextBlock TextWrapping="Wrap" Foreground="Gray"
                                   FontSize="11" Margin="0,0,0,8">
                            Wenn aktiviert, prueft HB-Sort beim App-Start ob die
                            BrickLink-Daten aelter als das Intervall sind und
                            laed sie dann im Hintergrund neu. Manueller Import
                            oben funktioniert immer unabhaengig davon.
                        </TextBlock>

                        <TextBlock FontSize="11" Foreground="Gray" Margin="0,0,0,4">
                            <Run Text="Letzte Aktualisierung: "/>
                            <Run Text="{Binding LastBlImportText, Mode=OneWay}"/>
                        </TextBlock>
                        <!-- UX X.29 (v0.1.16): "Letzte Pruefung" nur wenn sie
                             neuer ist als die letzte echte Aktualisierung -
                             d.h. die letzten Pruefungen waren "schon aktuell"
                             und haben keine Daten geaendert. -->
                        <TextBlock FontSize="11" Foreground="Gray" Margin="0,0,0,4"
                                   Visibility="{Binding ShowLastBlImportCheck, Converter={StaticResource BoolToVisibility}}"
                                   ToolTip="Hier wurde geprueft, aber die Quelle hat seitdem nichts geaendert.">
                            <Run Text="Letzte Pruefung: "/>
                            <Run Text="{Binding LastBlImportCheckText, Mode=OneWay}"/>
                            <Run Text=" (Daten waren unveraendert)" Foreground="Gray" FontStyle="Italic"/>
                        </TextBlock>

                        <CheckBox Content="Automatisch im Hintergrund aktualisieren"
                                  IsChecked="{Binding AutoBlImport}"
                                  Margin="0,4,0,8"
                                  ToolTip="Aktualisiert die BrickLink-Stammdaten regelmaessig im Hintergrund."/>

                        <StackPanel Orientation="Horizontal"
                                    IsEnabled="{Binding AutoBlImport}"
                                    Margin="24,0,0,8">
                            <TextBlock Text="Intervall:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding AutoBlImportIntervalOptions}"
                                      SelectedItem="{Binding AutoBlImportIntervalDays}"
                                      Width="80"
                                      ToolTip="Wie oft die BrickLink-Daten automatisch neu geladen werden (in Tagen).">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <Run Text="{Binding Mode=OneWay}"/>
                                            <Run Text=" Tage"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Margin="0,16,0,0"
                                    Visibility="{Binding IsImporting, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding ImportStatus}"
                                       FontSize="12" FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>
                            <ProgressBar Height="6" Margin="0,6,0,4"
                                         Minimum="0" Maximum="100"
                                         Value="{Binding ImportProgress, Mode=OneWay}"/>
                            <TextBlock FontSize="11" Foreground="Gray"
                                       HorizontalAlignment="Right"
                                       Text="{Binding ImportProgress, Mode=OneWay, StringFormat={}{0:F0}%}"/>
                            <TextBlock FontSize="11" Foreground="Gray"
                                       FontStyle="Italic" Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       Text="Import laeuft im Hintergrund. Die App ist nicht eingefroren - bitte warten."/>
                        </StackPanel>

                        <TextBlock Text="{Binding ImportResultText}"
                                   TextWrapping="Wrap" FontSize="12"
                                   Foreground="DarkGreen"
                                   Margin="0,16,0,0"
                                   Visibility="{Binding HasImportResult, Converter={StaticResource BoolToVisibility}}"/>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================================ -->
            <!-- TAB: LAGERFAECHER (Phase 4) -->
            <!-- ============================================ -->
            <TabItem Header="Lagerfaecher" DataContext="{Binding BinManager}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header + Buttons -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Lagerfach-Verwaltung" FontSize="16" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="+ Einzeln anlegen"
                                Width="160" Margin="0,0,8,0"
                                Click="BinCreateSingle_Click"/>
                        <Button Grid.Column="2" Content="+ Bulk anlegen"
                                Width="140"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="BinCreateBulk_Click"/>
                    </Grid>

                    <!-- Filter + Sort -->
                    <Grid Grid.Row="1" Margin="0,8,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Anzeigen:"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <RadioButton Grid.Column="1" Content="Alle"
                                     IsChecked="{Binding IsFilterAll, Mode=OneWay}"
                                     Click="FilterAll_Click"
                                     GroupName="BinFilter" Margin="0,0,12,0"
                                     VerticalAlignment="Center"/>
                        <RadioButton Grid.Column="2" Content="Nur frei"
                                     IsChecked="{Binding IsFilterFreeOnly, Mode=OneWay}"
                                     Click="FilterFree_Click"
                                     GroupName="BinFilter" Margin="0,0,12,0"
                                     VerticalAlignment="Center"/>
                        <RadioButton Grid.Column="3" Content="Nur belegt"
                                     IsChecked="{Binding IsFilterOccupiedOnly, Mode=OneWay}"
                                     Click="FilterOccupied_Click"
                                     GroupName="BinFilter"
                                     VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="5" Text="Sortieren nach:"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Grid.Column="6" Width="180"
                                  SelectedValue="{Binding SortMode}"
                                  SelectedValuePath="Tag">
                            <ComboBoxItem Content="Label (A-Z)" Tag="{x:Static vm:BinSortMode.LabelAsc}"/>
                            <ComboBoxItem Content="Label (Z-A)" Tag="{x:Static vm:BinSortMode.LabelDesc}"/>
                            <ComboBoxItem Content="Erstellt (neueste zuerst)" Tag="{x:Static vm:BinSortMode.CreatedNewest}"/>
                            <ComboBoxItem Content="Erstellt (aelteste zuerst)" Tag="{x:Static vm:BinSortMode.CreatedOldest}"/>
                            <ComboBoxItem Content="Belegt zuerst" Tag="{x:Static vm:BinSortMode.OccupiedFirst}"/>
                        </ComboBox>
                    </Grid>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding BinsView}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Label"
                                                Binding="{Binding Label}"
                                                Width="*"/>
                            <DataGridTextColumn Header="Status"
                                                Binding="{Binding StatusText}"
                                                Width="100"/>
                            <DataGridTextColumn Header="Figuren"
                                                Binding="{Binding MinifigCount}"
                                                Width="100"/>
                            <DataGridTextColumn Header="Einzelteile"
                                                Binding="{Binding FloatingPartCount}"
                                                Width="120"/>
                            <DataGridTextColumn Header="Erstellt"
                                                Binding="{Binding CreatedAt, StringFormat=g}"
                                                Width="120"/>
                            <DataGridTemplateColumn Header="Aktionen" Width="300">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Inhalt"
                                                    Click="BinShowDetail_Click"
                                                    Tag="{Binding}"
                                                    Margin="0,0,4,0" Padding="6,2"
                                                    ToolTip="Zeigt Figuren + Einzelteile in diesem Fach"/>
                                            <Button Content="Umbenennen"
                                                    Click="BinRename_Click"
                                                    Tag="{Binding}"
                                                    Margin="0,0,4,0" Padding="6,2"/>
                                            <Button Content="Leeren"
                                                    Click="BinEmpty_Click"
                                                    Tag="{Binding}"
                                                    Margin="0,0,4,0" Padding="6,2"/>
                                            <Button Content="Loeschen"
                                                    Click="BinDelete_Click"
                                                    Tag="{Binding}"
                                                    Padding="6,2"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Footer mit Summary + Loading -->
                    <Grid Grid.Row="3" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding SummaryText}"
                                   VerticalAlignment="Center"
                                   Foreground="Gray" FontStyle="Italic"/>
                        <ProgressBar Grid.Column="1" Width="120" Height="6"
                                     IsIndeterminate="True"
                                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ============================================================ -->
            <!-- TAB: KATEGORIEN (UX X.33 v0.1.19-beta.7 Block M)
                 User-pflegbares Mapping einer Brickognize-Kategorie auf ein
                 Lagerfach. Beim Einzelteil-Scan wird zuerst die Kategorie
                 hier nachgeschlagen - bei Treffer landet das Teil im
                 zugeordneten Fach (egal ob Stapel oder neu). Die Liste
                 fuellt sich organisch durch's Scannen: jede neue
                 Brickognize-Kategorie taucht hier auf, sobald sie zum
                 ersten Mal erkannt wurde. -->
            <!-- ============================================================ -->
            <TabItem Header="Kategorien">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Kategorien-Zuordnung" FontSize="16" FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>
                        <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="12">
                            Hier ordnest du Brickognize-Kategorien manuell festen Lagerfaechern zu.
                            Wenn du z.B. "Minifigure, Headgear" auf "Box21-3" setzt, landen ALLE
                            Helme (egal welche Teile-Nummer, egal welche Farbe) in diesem Fach.
                            <LineBreak/><LineBreak/>
                            <Run FontWeight="SemiBold">Wenn du keine Zuordnung machst</Run>
                            ("(kein Mapping)"), greift die Standard-Regel: HBSort sortiert maximal
                            eine Teile-Nummer pro Brickognize-Kategorie in ein Lagerfach. Verschiedene
                            Kategorien (z.B. Helm + Kopf + Hose) duerfen sich ein Fach teilen, aber
                            nicht zwei verschiedene Helme.
                            <LineBreak/><LineBreak/>
                            <Run FontWeight="SemiBold">Hinweis:</Run>
                            Stapel-Match (gleiche Teile-Nummer und Farbe) hat immer Vorrang -
                            identische Teile sammeln sich automatisch im gleichen Fach,
                            unabhaengig vom Mapping.
                            <LineBreak/><LineBreak/>
                            Die Liste zeigt alle Kategorien die HBSort bisher gesehen hat. Neue
                            Kategorien tauchen hier auf nachdem du Teile dieser Kategorie gescannt
                            hast.
                        </TextBlock>
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding CategoryMappings}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              IsReadOnly="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              SelectionMode="Single"
                              RowHeight="36">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Brickognize-Kategorie"
                                                Binding="{Binding Category}"
                                                Width="*"
                                                IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="Lagerfach" Width="240">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.CategoryMappingAvailableBins}"
                                                  SelectedItem="{Binding SelectedBin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  DisplayMemberPath="Label"
                                                  IsEditable="False"
                                                  ToolTip="Lagerfach fuer diese Brickognize-Kategorie. '(kein Mapping)' = Default-Regel greift."/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ============================================================ -->
            <!-- TAB: CACHE (UX X.11)
                 Vereint die alten "Bild-Cache"-, "BL-Cache"- und
                 "Preis-Cache"-Sektionen in einem scrollbaren Tab mit drei
                 optisch getrennten Sektionen. Die alten 3 Standorte bleiben
                 in dieser Iteration noch sichtbar - werden in Commit 5
                 entfernt. -->
            <!-- ============================================================ -->
            <TabItem Header="Cache">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>

                        <!-- ===== SEKTION 1: Bild-Cache ===== -->
                        <TextBlock Text="Bild-Cache"
                                   FontSize="15" FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>

                        <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="12" Margin="0,0,0,8"
                                   Text="Lokale Kopien von BrickLink- und Brickognize-Bildern. Spart wiederholte Downloads."/>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Belegt:"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CacheUsageText}"/>

                            <TextBlock Grid.Row="1" Text="Limit:" Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,4,0,0"
                                       Text="{Binding CacheLimitText}"/>
                        </Grid>

                        <TextBlock Text="Cache-Limit" FontSize="13" FontWeight="SemiBold" Margin="0,12,0,4"/>

                        <StackPanel>
                            <RadioButton Content="100 MB"
                                         IsChecked="{Binding IsLimit100Mb, Mode=OneWay}"
                                         Click="LimitRadio100_Click"
                                         GroupName="CacheLimitNew"/>
                            <RadioButton Content="1 GB (Standard)"
                                         IsChecked="{Binding IsLimit1Gb, Mode=OneWay}"
                                         Click="LimitRadio1Gb_Click"
                                         GroupName="CacheLimitNew"
                                         Margin="0,4,0,0"/>
                            <RadioButton Content="5 GB"
                                         IsChecked="{Binding IsLimit5Gb, Mode=OneWay}"
                                         Click="LimitRadio5Gb_Click"
                                         GroupName="CacheLimitNew"
                                         Margin="0,4,0,0"/>
                            <RadioButton Content="Unbegrenzt"
                                         IsChecked="{Binding IsLimitUnlimited, Mode=OneWay}"
                                         Click="LimitRadioUnlimited_Click"
                                         GroupName="CacheLimitNew"
                                         Margin="0,4,0,0"/>
                        </StackPanel>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Eigener Wert:"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding CustomLimitInput, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Cache-Limit in Megabyte (positive Ganzzahl)"/>
                            <TextBlock Grid.Column="2" Text="MB"
                                       VerticalAlignment="Center" Margin="6,0,8,0"/>
                            <Button Grid.Column="3" Content="Anwenden"
                                    Command="{Binding ApplyCustomLimitCommand}"/>
                        </Grid>

                        <Button Content="Cache jetzt leeren"
                                Width="200" HorizontalAlignment="Left"
                                Command="{Binding ClearCacheCommand}"
                                Margin="0,12,0,0"
                                ToolTip="Loescht alle Bilder und die Sidecar-DB"/>

                        <TextBlock Text="Optionen" FontSize="13" FontWeight="SemiBold" Margin="0,12,0,4"/>

                        <CheckBox Content="BrickLink-Bilder bevorzugen"
                                  IsChecked="{Binding PreferBricklinkImages}"
                                  ToolTip="Bevorzugt echte BrickLink-Teile-Fotos (farbig) statt Brickognize-Graustufen-Renderings. Fallback automatisch."/>

                        <CheckBox Content="Vorab-Cache bei Minifig-Scan"
                                  IsChecked="{Binding PreloadOnMinifigScan}"
                                  Margin="0,4,0,0"
                                  ToolTip="Laedt nach erkannter Minifigur deren Teile-Bilder im Hintergrund vor (Phase 3+)."/>

                        <Separator Margin="0,16,0,16"/>

                        <!-- ===== SEKTION 2: BL-Daten-Cache ===== -->
                        <TextBlock Text="BL-Daten-Cache"
                                   FontSize="15" FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>

                        <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="12" Margin="0,0,0,8"
                                   Text="BrickLink-Stammdaten (Items, Subsets, Colors) lokal in bl_cache.db."/>

                        <TextBlock Text="{Binding BlCacheStatsText}"
                                   FontSize="12" TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Stale-Eintraege loeschen"
                                    Command="{Binding ClearStaleBlCacheCommand}"
                                    Width="220" Margin="0,0,8,0"
                                    ToolTip="Loescht alle Items/Subsets aelter als cacheStaleDays (Default 90)."/>
                            <Button Content="Cache leeren"
                                    Command="{Binding ClearBlCacheCommand}"
                                    Width="120"
                                    ToolTip="Loescht alle Eintraege im BL-Cache (mit Bestaetigung)."/>
                        </StackPanel>

                        <Separator Margin="0,16,0,16"/>

                        <!-- ===== SEKTION 3: Preis-Cache ===== -->
                        <TextBlock Text="Preis-Cache"
                                   FontSize="15" FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>

                        <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="12" Margin="0,0,0,8"
                                   Text="BL-Preisdaten (Stale-While-Revalidate). Lange TTLs - BL-Preise aendern sich langsam."/>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="Cache-Gueltigkeit komplette Figuren (Tage):"
                                       VerticalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,4"
                                     Text="{Binding PriceCacheTtlMinifigDays, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Wie lange werden Komplett-Figur-Preise als 'frisch' angesehen. Default: 90 Tage."/>

                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Text="Cache-Gueltigkeit Einzelteile (Tage):"
                                       VerticalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,4"
                                     Text="{Binding PriceCacheTtlPartDays, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Wie lange werden Einzelteil-Preise als 'frisch' angesehen. Default: 90 Tage."/>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding PriceCacheCountText}"
                                       FontSize="12" Foreground="Gray"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Preis-Cache leeren"
                                    Command="{Binding ClearPriceCacheCommand}"
                                    Padding="8,4"/>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>


            <!-- ====================================== -->
            <!-- TAB: EXPORT (BSX-Export-Standard-Ordner)   -->
            <!-- ====================================== -->
            <!--
                Eigener Tab fuer den BSX-Export-Default-Ordner. Wurde aus dem
                Statistik-Tab herausgezogen, weil er dort schwer zu finden war.
                Aenderungen werden SOFORT gespeichert (nicht erst beim "Speichern"-
                Button), damit der naechste Export ohne Umweg den neuen Pfad nutzt.
            -->
            <TabItem Header="Export">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel MaxWidth="700" HorizontalAlignment="Left">

                        <TextBlock Text="BSX-Export"
                                   FontSize="16" FontWeight="SemiBold"
                                   Margin="0,0,0,12"/>

                        <!-- Label + read-only TextBox + zwei Buttons -->
                        <TextBlock Text="Standard-Ordner fuer BSX-Export:"
                                   Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- TextBox absichtlich read-only: Aenderung nur ueber den
                                 Ordner-Picker, sonst koennte der User einen ungueltigen
                                 Pfad eintippen ohne dass wir ihn validieren koennen. -->
                            <TextBox Grid.Column="0"
                                     Text="{Binding BsxExportFolder, Mode=OneWay}"
                                     IsReadOnly="True"
                                     VerticalAlignment="Center"
                                     ToolTip="Leer = Default-Ordner Documents\HBSort-Export\"/>
                            <Button Grid.Column="1" Content="Ordner waehlen..."
                                    Margin="8,0,0,0" Padding="10,4"
                                    Click="BrowseBsxFolder_Click"/>
                            <Button Grid.Column="2" Content="Zuruecksetzen"
                                    Margin="8,0,0,0" Padding="10,4"
                                    Click="ResetBsxFolder_Click"
                                    ToolTip="Setzt den Pfad auf den Default zurueck (Documents\HBSort-Export\)"/>
                        </Grid>

                        <!-- Hilfetext direkt darunter -->
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="Gray"
                                   Margin="0,8,0,0">
                            Hier werden BSX-Dateien standardmaessig gespeichert. Beim Export
                            kann der Ordner pro Export auch noch geaendert werden.
                        </TextBlock>

                        <!-- Anzeige des Default-Pfades, damit der User sieht
                             worauf "Zuruecksetzen" zurueckspringt. -->
                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="Gray"
                                   FontStyle="Italic" Margin="0,8,0,0">
                            <Run Text="Default-Ordner: "/>
                            <Run Text="{Binding Source={x:Static vm:SettingsViewModel.DefaultBsxExportFolder}, Mode=OneTime}"
                                 FontFamily="Consolas"/>
                        </TextBlock>

                        <!-- Hint-Box: erklaert wo der Export ausgeloest wird. -->
                        <Border Background="{StaticResource InfoBoxBackground}" BorderBrush="{StaticResource StatusInfoBrush}"
                                BorderThickness="1" CornerRadius="4"
                                Padding="12" Margin="0,16,0,0">
                            <TextBlock TextWrapping="Wrap" FontSize="12">
                                <Run Text="Hinweis:" FontWeight="SemiBold"/>
                                Komplette Figuren koennen ueber den "Exportieren"-Button
                                in der Lagerfach-Uebersicht als BSX-Datei in BrickStore
                                uebertragen werden.
                            </TextBlock>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ====================================== -->
            <!-- TAB: STATISTIK (Phase 6 / PROMPT 7)    -->
            <!-- ====================================== -->
            <TabItem Header="Statistik">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>

                        <!-- Zeitraum-Auswahl -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <RadioButton GroupName="StatsRange" Content="Heute"
                                         IsChecked="{Binding StatsRangeToday}"
                                         Margin="0,0,8,0" Padding="12,4"/>
                            <RadioButton GroupName="StatsRange" Content="7 Tage"
                                         IsChecked="{Binding StatsRange7Days}"
                                         Margin="0,0,8,0" Padding="12,4"/>
                            <RadioButton GroupName="StatsRange" Content="30 Tage"
                                         IsChecked="{Binding StatsRange30Days}"
                                         Margin="0,0,8,0" Padding="12,4"/>
                            <RadioButton GroupName="StatsRange" Content="Insgesamt"
                                         IsChecked="{Binding StatsRangeAllTime}"
                                         Padding="12,4"/>
                        </StackPanel>

                        <!-- 3 Stats-Cards nebeneinander -->
                        <UniformGrid Columns="3" Margin="0,0,0,16">
                            <Border BorderBrush="Gray" BorderThickness="1"
                                    CornerRadius="4" Padding="16" Margin="0,0,8,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Scans" Foreground="Gray" FontSize="12"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding StatsScanCount}"
                                               FontSize="32" FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border BorderBrush="Gray" BorderThickness="1"
                                    CornerRadius="4" Padding="16" Margin="4,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Komplettiert" Foreground="Gray" FontSize="12"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding StatsCompletedCount}"
                                               FontSize="32" FontWeight="SemiBold"
                                               Foreground="{StaticResource StatusSuccessBrush}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border BorderBrush="Gray" BorderThickness="1"
                                    CornerRadius="4" Padding="16" Margin="8,0,0,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Zerlegt" Foreground="Gray" FontSize="12"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding StatsDismantledCount}"
                                               FontSize="32" FontWeight="SemiBold"
                                               Foreground="{StaticResource StatusWarningBrush}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Aktueller Bestand -->
                        <Separator Margin="0,8"/>
                        <TextBlock Text="Aktueller Bestand"
                                   FontSize="14" FontWeight="SemiBold" Margin="0,8,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Wartende Figuren"/>
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       Text="{Binding CurrentWaitingCount}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Komplette Figuren"
                                       Foreground="{StaticResource StatusSuccessBrush}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       Text="{Binding CurrentCompleteCount}" FontWeight="SemiBold"
                                       Foreground="{StaticResource StatusSuccessBrush}"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Floating-Parts (lose)"/>
                            <TextBlock Grid.Row="2" Grid.Column="1"
                                       Text="{Binding CurrentFloatingCount}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Belegte Lagerfaecher"/>
                            <TextBlock Grid.Row="3" Grid.Column="1"
                                       Text="{Binding CurrentBinsUsedCount}" FontWeight="SemiBold"/>
                        </Grid>

                        <!-- Phase 7: BSX-Export-Einstellungen sind jetzt in einem eigenen
                             Tab "Export" (besser auffindbar). Hier nur noch der Hinweis. -->

                        <!-- Hint -->
                        <Border Background="{StaticResource InfoBoxBackground}" BorderBrush="{StaticResource StatusInfoBrush}"
                                BorderThickness="1" CornerRadius="4"
                                Padding="12" Margin="0,16,0,0">
                            <TextBlock TextWrapping="Wrap" FontSize="12">
                                <Run Text="Hinweis:" FontWeight="SemiBold"/>
                                Komplette Figuren koennen ueber den "Exportieren"-Button
                                in der Lagerfach-Uebersicht als BSX-Datei in BrickStore
                                uebertragen werden. Die App-Faecher sind nur temporaer
                                waehrend des Sortier-Workflows.
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ====================================== -->
            <!-- TAB: BACKUPS (UX X.29 / v0.1.16) -->
            <!-- Manuelles + automatisches Backup von userdata.db, bl_cache.db
                 und settings.json. Liste der vorhandenen Backups mit
                 Wiederherstellen-/Loeschen-Buttons. -->
            <!-- ====================================== -->
            <TabItem Header="Backups">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel MaxWidth="700">

                        <TextBlock Text="Backups"
                                   FontSize="18" FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="Gray"
                                   Margin="0,0,0,16">
                            Backups enthalten deine Lagerfaecher-Daten, den BL-Cache und
                            deine Einstellungen. Sie liegen als ZIP unter
                            %APPDATA%\HBSort\backups\.
                        </TextBlock>

                        <!-- Sektion: Automatisches Backup -->
                        <TextBlock Text="Automatisches Backup"
                                   FontSize="14" FontWeight="SemiBold"
                                   Margin="0,8,0,8"/>
                        <CheckBox Content="Automatisch beim App-Start"
                                  IsChecked="{Binding AutoBackup, Mode=TwoWay}"
                                  Margin="0,0,0,8"
                                  ToolTip="Erstellt beim App-Start ein Backup, wenn das letzte Backup laenger als das Intervall her ist."/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Intervall:"
                                       VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1"
                                      SelectedValuePath="Tag"
                                      SelectedValue="{Binding AutoBackupIntervalDays, Mode=TwoWay}"
                                      Width="200" HorizontalAlignment="Left"
                                      IsEnabled="{Binding AutoBackup}">
                                <ComboBoxItem Content="Taeglich" Tag="1"/>
                                <ComboBoxItem Content="Woechentlich" Tag="7"/>
                                <ComboBoxItem Content="Monatlich" Tag="30"/>
                            </ComboBox>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Anzahl behaltener Backups:"
                                       VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding BackupKeepCount, Mode=TwoWay}"
                                     Width="80" HorizontalAlignment="Left"
                                     ToolTip="Aelteste Backups werden geloescht wenn diese Zahl ueberschritten ist (min. 1)."/>
                        </Grid>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Letztes Backup:"
                                       VerticalAlignment="Center" Foreground="Gray"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding LastBackupDisplay}"
                                       VerticalAlignment="Center" FontStyle="Italic"/>
                        </Grid>

                        <Separator Margin="0,4,0,12"/>

                        <!-- Sektion: Manuelles Backup -->
                        <TextBlock Text="Manuelles Backup"
                                   FontSize="14" FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Backup jetzt erstellen"
                                    Click="CreateBackupNow_Click"
                                    Padding="12,4"
                                    Style="{StaticResource AccentButtonStyle}"/>
                            <TextBlock x:Name="BackupStatusText"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0"
                                       Foreground="Gray"/>
                        </StackPanel>

                        <Separator Margin="0,12,0,12"/>

                        <!-- Sektion: Vorhandene Backups -->
                        <TextBlock Text="Vorhandene Backups"
                                   FontSize="14" FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>
                        <DataGrid x:Name="BackupListGrid"
                                  ItemsSource="{Binding Backups}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  AlternatingRowBackground="#F8F8F8"
                                  Height="220"
                                  Margin="0,0,0,8">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Datum/Uhrzeit"
                                                    Binding="{Binding CreatedAtDisplay}"
                                                    Width="180"/>
                                <DataGridTextColumn Header="Groesse"
                                                    Binding="{Binding SizeDisplay}"
                                                    Width="100"/>
                                <DataGridTextColumn Header="Datei"
                                                    Binding="{Binding FileName}"
                                                    Width="*"
                                                    FontFamily="Consolas"/>
                                <DataGridTemplateColumn Header="Aktionen" Width="200">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Wiederherstellen"
                                                        Click="RestoreBackup_Click"
                                                        Tag="{Binding}"
                                                        Padding="6,2" Margin="0,0,4,0"
                                                        ToolTip="Aktuelle Daten werden ueberschrieben (mit Bestaetigung)."/>
                                                <Button Content="Loeschen"
                                                        Click="DeleteBackup_Click"
                                                        Tag="{Binding}"
                                                        Padding="6,2"
                                                        Background="#D32F2F" Foreground="White"
                                                        ToolTip="Backup-Datei dauerhaft loeschen."/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="{Binding BackupsSummary}"
                                   FontSize="11" Foreground="Gray"
                                   Margin="0,0,0,8"/>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ====================================== -->
            <!-- TAB: UPDATES (Auto-Update Konfiguration) -->
            <!-- UX-Iteration X.23: Velopack-basierter Auto-Update-Mechanismus.
                 Toggle, manueller Check-Button, Status-Anzeige. -->
            <!-- ====================================== -->
            <TabItem Header="Updates">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel MaxWidth="600">

                        <TextBlock Text="Updates"
                                   FontSize="18" FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>

                        <TextBlock TextWrapping="Wrap" Foreground="Gray"
                                   FontSize="12" Margin="0,0,0,16">
                            HB-Sort kann sich ueber GitHub Releases automatisch
                            aktualisieren - aber nur wenn die App ueber den
                            Setup.exe-Installer installiert wurde. Bei Portable-
                            ZIP-Nutzung sind alle Update-Funktionen deaktiviert
                            und du musst neue Versionen manuell herunterladen.
                        </TextBlock>

                        <!-- Aktueller Status -->
                        <Border BorderBrush="{StaticResource StatusInfoBrush}"
                                BorderThickness="1" CornerRadius="4"
                                Background="{StaticResource InfoBoxBackground}"
                                Padding="12" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold"
                                           FontSize="13"
                                           Margin="0,0,0,4">
                                    <Run Text="Installation: "/>
                                    <Run Text="{Binding UpdateInstallStateText, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock FontSize="12" Foreground="Gray">
                                    <Run Text="Aktuelle Version: "/>
                                    <Run Text="{Binding CurrentVersionText, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock FontSize="12" Foreground="Gray">
                                    <Run Text="Letzte Pruefung: "/>
                                    <Run Text="{Binding LastUpdateCheckText, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Auto-Check-Toggle -->
                        <CheckBox Content="Beim App-Start nach Updates suchen"
                                  IsChecked="{Binding AutoCheckForUpdates}"
                                  IsEnabled="{Binding IsUpdateInstalled}"
                                  Margin="0,0,0,8"
                                  ToolTip="Wenn aktiv, prueft HB-Sort beim Starten einmal im Hintergrund auf neue Versionen. Kein automatischer Download - der 'Jetzt updaten'-Button unten wird dann aktiv."/>

                        <TextBlock Text="Wenn deaktiviert: nur manuelles Pruefen via Button unten."
                                   FontSize="11" Foreground="Gray"
                                   Margin="24,0,0,16"/>

                        <!-- Manueller Check -->
                        <Button Content="Jetzt nach Updates suchen"
                                Command="{Binding CheckForUpdatesCommand}"
                                IsEnabled="{Binding IsUpdateInstalled}"
                                HorizontalAlignment="Left"
                                Padding="12,6"
                                Margin="0,0,0,8"/>

                        <TextBlock Text="{Binding UpdateCheckStatusText}"
                                   FontSize="12"
                                   Foreground="{Binding UpdateCheckStatusBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,16"
                                   Visibility="{Binding HasUpdateCheckStatus, Converter={StaticResource BoolToVisibility}}"/>

                        <!-- UX X.26 (v0.1.13): prominenter "Jetzt updaten"-Button.
                             Sichtbarkeit an HasUpdateAvailable - erscheint nur
                             wenn der Background-Check (oder manueller Check oben)
                             ein Update gefunden hat. AccentButton-Style hebt ihn
                             als primaere Aktion hervor.
                             Ersetzt das frueher geplante Header-Update-Badge,
                             das nach 6 fehlgeschlagenen Sichtbarkeits-Iterationen
                             (v0.1.5..v0.1.12) komplett entfernt wurde. -->
                        <Border Background="{StaticResource InfoBoxBackground}"
                                BorderBrush="{StaticResource StatusInfoBrush}"
                                BorderThickness="1" CornerRadius="4"
                                Padding="12" Margin="0,8,0,16"
                                Visibility="{Binding HasUpdateAvailable, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8">
                                    <Run Text="Update verfuegbar: v"/>
                                    <Run Text="{Binding AvailableUpdateVersion, Mode=OneWay}"/>
                                </TextBlock>
                                <Button Command="{Binding ApplyUpdateCommand}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Padding="14,8"
                                        HorizontalAlignment="Left"
                                        ToolTip="Laedt die neue Version herunter und startet die App neu. Deine Daten unter %APPDATA%\HBSort bleiben erhalten.">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="14" VerticalAlignment="Center"
                                                   Margin="0,0,6,0"/>
                                        <TextBlock VerticalAlignment="Center">
                                            <Run Text="Jetzt auf v"/>
                                            <Run Text="{Binding AvailableUpdateVersion, Mode=OneWay}"/>
                                            <Run Text=" updaten"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Separator Margin="0,8,0,8"/>

                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="Gray">
                            Updates werden ueber Velopack + GitHub Releases verteilt.
                            Beim Update-Restart bleiben deine Daten unter
                            %APPDATA%\HBSort\ (settings.json, Datenbanken, Logs)
                            unveraendert - nur die App selbst wird ausgetauscht.
                        </TextBlock>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ====================================== -->
            <!-- TAB: HOTKEYS (UX X.29 Block F / v0.1.16) -->
            <!-- Read-only-Tabelle aller statischen Tastatur-Shortcuts. -->
            <!-- ====================================== -->
            <TabItem Header="Hotkeys">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel MaxWidth="700">

                        <TextBlock Text="Tastatur-Shortcuts"
                                   FontSize="18" FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="Gray"
                                   Margin="0,0,0,16">
                            Alle festen Shortcuts in HB-Sort. User-konfigurierbare Hotkeys
                            sind aktuell nicht vorgesehen. Vollstaendige Erlaeuterung in der
                            integrierten Hilfe (F1) → Kapitel "Tastatur-Shortcuts".
                        </TextBlock>

                        <DataGrid ItemsSource="{Binding HotkeyEntries}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  AlternatingRowBackground="#F8F8F8"
                                  RowHeight="32">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Hotkey"
                                                    Binding="{Binding Key}"
                                                    Width="180"
                                                    FontFamily="Consolas"
                                                    FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="Aktion"
                                                    Binding="{Binding Action}"
                                                    Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ====================================== -->
            <!-- TAB: INFO (Logo, Beschreibung, Disclaimer) -->
            <!-- ====================================== -->
            <TabItem Header="Info">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel HorizontalAlignment="Center" MaxWidth="600">

                        <!-- Logo -->
                        <Image Source="../Resources/logo.png"
                               Width="200" Height="240"
                               HorizontalAlignment="Center"
                               Margin="0,16,0,16"/>

                        <!-- App-Name -->
                        <TextBlock Text="HB-Sort"
                                   FontSize="28" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>

                        <!-- Untertitel -->
                        <TextBlock Text="Sortier-Werkzeug fuer Klemmbausteine"
                                   FontSize="14" Foreground="Gray"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0"/>

                        <!-- Version (gesetzt via Code-Behind) -->
                        <TextBlock x:Name="AboutVersionText"
                                   FontSize="12" Foreground="Gray"
                                   HorizontalAlignment="Center"
                                   Margin="0,2,0,16"/>

                        <Separator Margin="0,8"/>

                        <!-- Beschreibung -->
                        <TextBlock TextWrapping="Wrap"
                                   FontSize="12"
                                   Margin="0,8,0,16">
                            HB-Sort erkennt Klemmbaustein-Minifiguren und Teile per
                            USB-Kamera (Brickognize-API), schlaegt deren BrickLink-IDs
                            vor und verwaltet einen Lagerfach-basierten Workflow zur
                            Sortierung von Sammlungen oder Wuhlkisten.
                        </TextBlock>

                        <!-- Markenrechte -->
                        <Border Background="{StaticResource WarningBoxBackground}" BorderBrush="{StaticResource StatusWarningBrush}"
                                BorderThickness="1" CornerRadius="4"
                                Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Markenrechte / Disclaimer"
                                           FontWeight="SemiBold" FontSize="13"
                                           Margin="0,0,0,4"/>
                                <TextBlock TextWrapping="Wrap" FontSize="11">
                                    LEGO ist eine eingetragene Marke der LEGO Gruppe,
                                    die diese Software weder sponsert noch
                                    unterstuetzt. HB-Sort ist ein unabhaengiges
                                    Werkzeug ohne offizielle Verbindung zur LEGO
                                    Gruppe.
                                    <LineBreak/><LineBreak/>
                                    BrickLink-Catalog-Daten sind Eigentum von
                                    BrickLink (bricklink.com). Diese Anwendung nutzt
                                    die Aufbereitung dieser Daten durch BrickStore von
                                    Robert Griebl (brickstore.dev, GPL-3,
                                    github.com/rgriebl/brickstore-database).
                                    <LineBreak/><LineBreak/>
                                    Brickognize ist ein Service von brickognize.com.
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Copyright -->
                        <TextBlock Text="(c) 2026 Holger Kessler - HB-Bricks"
                                   FontSize="11" Foreground="Gray"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0"/>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- Buttons unten -->
        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Abbrechen" IsCancel="True"
                    Width="100" Margin="0,0,8,0"
                    Click="Cancel_Click"/>
            <Button Content="Speichern" IsDefault="True"
                    Width="100"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
