<UserControl x:Class="HBSort.Views.BlInventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:b="clr-namespace:HBSort.Behaviors">
    <!--
        v0.1.24-beta.7 Phase 2: Tab "BrickLink Inventar".
        DataContext = BlInventoryViewModel.

        Layout: Header oben, Filter darunter, dann zweispaltiger Bereich
        (DataGrid links, Detail-Panel rechts), Footer unten.
    -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 0: Header (Titel + Sync) -->
            <RowDefinition Height="Auto"/>   <!-- 1: Filter -->
            <RowDefinition Height="*"/>      <!-- 2: Grid (Liste + Detail) -->
            <RowDefinition Height="Auto"/>   <!-- 3: Footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="BRICKLINK INVENTAR"
                       FontSize="18" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="Synchronisiere..."
                       VerticalAlignment="Center"
                       Foreground="Gray" FontStyle="Italic"
                       Margin="0,0,8,0"
                       Visibility="{Binding IsSyncing, Converter={StaticResource BoolToVisibility}}"/>
            <Button Grid.Column="2"
                    Content="Inventar synchronisieren"
                    Command="{Binding SyncCommand}"
                    Padding="12,4"
                    ToolTip="Holt das komplette BrickLink-Store-Inventar von der BL-API und speichert es lokal. Snapshot-Replace mit Erhalt der Reservierungen."/>
        </Grid>

        <!-- Filter -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Suche:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="Gray"/>
            <TextBox Grid.Column="1"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ui:ControlHelper.PlaceholderText="Artikelnummer, Name oder Farbe..."
                     ToolTip="Filtert live nach Artikelnummer, Catalog-Name/Beschreibung und Farbe."/>
            <TextBlock Grid.Column="2" Text="Typ:" VerticalAlignment="Center" Margin="12,0,6,0" Foreground="Gray"/>
            <ComboBox Grid.Column="3"
                      ItemsSource="{Binding ItemTypeOptions}"
                      SelectedValue="{Binding FilterByItemType, Mode=TwoWay}"
                      SelectedValuePath="Value"
                      DisplayMemberPath="Label"
                      ToolTip="Filtert auf Part / Minifig / Set."/>
            <TextBlock Grid.Column="4" Text="Zustand:" VerticalAlignment="Center" Margin="12,0,6,0" Foreground="Gray"/>
            <ComboBox Grid.Column="5"
                      ItemsSource="{Binding ConditionOptions}"
                      SelectedValue="{Binding FilterByCondition, Mode=TwoWay}"
                      SelectedValuePath="Value"
                      DisplayMemberPath="Label"
                      ToolTip="Filtert auf Neu / Gebraucht."/>
            <Button Grid.Column="7" Content="Reset"
                    Command="{Binding ResetFiltersCommand}"
                    Padding="8,2"
                    ToolTip="Setzt Suche und Filter zurueck."/>
        </Grid>

        <!-- Liste + Detail: zweispaltig. Liste ist Hauptbereich, Detail
             340px breit am rechten Rand. Detail wird ueber DataTrigger
             auf HasSelectedRow ein-/ausgeblendet. -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Empty-State (zentriert, ueber dem ganzen Bereich) -->
            <Border Grid.ColumnSpan="2"
                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1" CornerRadius="6"
                    Padding="24" MaxWidth="640"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Noch kein BrickLink-Inventar synchronisiert."
                               FontSize="15" FontWeight="SemiBold"
                               Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" FontSize="13"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                               Text="Bitte zuerst in den Einstellungen die BrickLink-Tokens hinterlegen und synchronisieren. Alternativ kannst du den Sync-Knopf oben rechts direkt nutzen, sobald die Tokens gespeichert sind."/>
                </StackPanel>
            </Border>

            <!-- DataGrid -->
            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1" CornerRadius="4"
                    Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
                <DataGrid x:Name="InventoryGrid"
                          ItemsSource="{Binding ItemsView}"
                          SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          AlternatingRowBackground="#F6F8FA"
                          SelectionMode="Single"
                          RowHeight="44"
                          BorderThickness="0">
                    <DataGrid.Columns>
                        <!-- Thumbnail. Lazy ueber BlInventoryRow.ImageUrl: das
                             DataContextChanged-Event feuert sobald eine Row in
                             den Viewport scrollt (DataGrid-Virtualisierung
                             recyclet Container, dabei aendert sich der
                             DataContext des Image-Elements). -->
                        <DataGridTemplateColumn Header="Bild" Width="48" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding ImageUrl, Converter={StaticResource NullToImageSource}}"
                                           Width="32" Height="32" Stretch="Uniform"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           DataContextChanged="Thumbnail_DataContextChanged"
                                           Loaded="Thumbnail_Loaded"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Artikelnummer" Binding="{Binding ItemNo}" Width="110"
                                            FontFamily="Consolas"/>
                        <DataGridTextColumn Header="Typ" Binding="{Binding ItemTypeLabel}" Width="70"/>
                        <DataGridTextColumn Header="Farbe" Binding="{Binding ColorName}" Width="130"/>
                        <DataGridTextColumn Header="Beschreibung" Binding="{Binding DescriptionDisplay}" Width="*"/>
                        <DataGridTextColumn Header="Menge" Binding="{Binding Quantity}" Width="64">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Reserviert" Binding="{Binding ReservedDisplay}" Width="80"
                                            ToolTipService.ToolTip="Lokal eingeplante Menge (Phase 3 schreibt das; aktuell durchgehend leer).">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Foreground" Value="#D32F2F"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Verfuegbar" Binding="{Binding Available}" Width="86">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Preis" Binding="{Binding UnitPriceDisplay}" Width="100"
                                            FontFamily="Consolas">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Zustand" Binding="{Binding ConditionLabel}" Width="86"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Detail-Panel rechts: feste Breite 340px, immer sichtbar
                 (sobald Inventar vorhanden). Inhalt switched zwischen
                 Placeholder und Full-Detail je nach HasSelectedRow -
                 dadurch bleibt das Layout stabil und es kommt kein
                 Layout-Sprung beim ersten Klick auf eine Zeile. -->
            <Border Grid.Column="1"
                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1" CornerRadius="4"
                    Margin="12,0,0,0" Padding="16"
                    Width="340"
                    Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
                <Grid>
                    <!-- Placeholder wenn nichts selektiert -->
                    <TextBlock Text="Lot auswaehlen fuer Details"
                               FontSize="13"
                               FontStyle="Italic"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedRow}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Detail-Inhalt wenn Selection vorhanden -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedRow}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                    <StackPanel DataContext="{Binding SelectedRow}">
                        <!-- Grosses Bild oben, klickbar ueber ImageZoom-Behavior. -->
                        <Border Width="160" Height="160"
                                Background="White"
                                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                BorderThickness="1" CornerRadius="4"
                                HorizontalAlignment="Center" Margin="0,0,0,12">
                            <Image Source="{Binding ImageUrl, Converter={StaticResource NullToImageSource}}"
                                   Stretch="Uniform"
                                   b:ImageZoom.IsEnabled="True"/>
                        </Border>

                        <!-- Catalog-Name als Ueberschrift (faellt auf Description zurueck) -->
                        <TextBlock Text="{Binding DescriptionDisplay}"
                                   FontSize="14" FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"/>

                        <!-- Feldweise Detail. 2-Spalten-Grid, Label links, Wert rechts. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Artikelnummer:" Foreground="Gray"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ItemNo}"
                                       FontFamily="Consolas"/>

                            <TextBlock Grid.Row="1" Text="Typ:" Foreground="Gray" Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ItemTypeLabel}" Margin="0,4,0,0"/>

                            <TextBlock Grid.Row="2" Text="Name:" Foreground="Gray" Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CatalogName}"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>

                            <TextBlock Grid.Row="3" Text="Farbe:" Foreground="Gray" Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ColorName}" Margin="0,4,0,0"/>

                            <TextBlock Grid.Row="4" Text="Menge:" Foreground="Gray" Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Quantity}" Margin="0,4,0,0"/>

                            <TextBlock Grid.Row="5" Text="Reserviert:" Foreground="Gray" Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ReservedQuantity}"
                                       Foreground="#D32F2F" Margin="0,4,0,0"/>

                            <TextBlock Grid.Row="6" Text="Verfuegbar:" Foreground="Gray" Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Available}"
                                       FontWeight="SemiBold" Margin="0,4,0,0"/>

                            <TextBlock Grid.Row="7" Text="Preis:" Foreground="Gray" Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding UnitPriceDisplay}"
                                       FontFamily="Consolas" Margin="0,4,0,0"/>

                            <TextBlock Grid.Row="8" Text="Zustand:" Foreground="Gray" Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding ConditionLabel}" Margin="0,4,0,0"/>
                        </Grid>

                        <!-- Letzter Sync separat unten - User-Vertrauen + Diagnose. -->
                        <TextBlock Text="Letzter Sync:" Foreground="Gray" FontSize="11"
                                   Margin="0,16,0,0"/>
                        <TextBlock Text="{Binding LastSyncedAtDisplay}"
                                   FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="3"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,1,0,0"
                Padding="0,6,0,0" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding FooterText}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                <TextBlock Grid.Column="1" Text="{Binding SyncStatusText}"
                           FontSize="12" FontStyle="Italic"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
