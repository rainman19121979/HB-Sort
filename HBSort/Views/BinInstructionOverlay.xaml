<UserControl x:Class="HBSort.Views.BinInstructionOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:HBSort.ViewModels"
             xmlns:b="clr-namespace:HBSort.Behaviors"
             Background="Transparent">
    <!--
        v0.1.22-beta.1 Block F: konsolidiertes Anweisungs-Overlay. Vorher gab
        es zwei separate UserControls (BinInstructionOverlay fuer Single +
        BinInstructionGroupOverlay fuer Group). Jetzt eine View die per
        DataTrigger auf BinInstruction.Mode den passenden Bereich zeigt.

        Single (UX X.31 Block B): mittig oben, prominent Bin-Label + Item-
        Bild. 8s-Auto-Dismiss-Timer im ScanViewModel.

        Group (UX X.32 Block C): mittig zentriert, Header + Items-Liste mit
        Quell/Ziel-Trennung. KEIN Auto-Dismiss (User-Spec: aktiv wegklicken).

        Beide Modi schliessen per Klick irgendwo, Enter / Leertaste / Esc.
    -->
    <Grid x:Name="OverlayRoot"
          Background="#80000000"
          MouseLeftButtonUp="OverlayBackground_MouseLeftButtonUp"
          ToolTip="Klick irgendwo zum Schliessen">

        <!-- ===== SINGLE-MODE ===== -->
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,40,0,0"
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                BorderBrush="{DynamicResource SystemAccentColorLight2Brush}"
                BorderThickness="2"
                CornerRadius="8"
                Padding="24"
                MaxWidth="560"
                MouseLeftButtonUp="OverlayPanel_MouseLeftButtonUp">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ScanViewModel.BinInstruction.Mode}"
                                     Value="{x:Static vm:BinInstructionMode.Single}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="6" Opacity="0.4"/>
            </Border.Effect>

            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="Lege diesen Eintrag in"
                           FontSize="14"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="{Binding ScanViewModel.BinInstruction.Label}"
                           FontSize="32" FontWeight="Bold"
                           Foreground="{DynamicResource SystemAccentBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,12"/>

                <Image Source="{Binding ScanViewModel.BinInstruction.ImageUrl,
                                        Converter={StaticResource NullToImageSource}}"
                       MaxWidth="200" MaxHeight="200"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12"/>

                <Button Content="OK"
                        IsDefault="True"
                        HorizontalAlignment="Center"
                        Padding="32,6"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="Ok_Click"
                        ToolTip="Druecke Enter / Leertaste oder klicke um fortzufahren."/>

                <TextBlock Text="Enter / Leertaste oder Klick zum Fortfahren"
                           FontSize="11"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- ===== SORT-INSTRUCTION-MODE (v0.1.24-beta.1) =====
             Post-Save-Modal mit Take/Put/Plus-Sektionen. Konzept 4.3 Rev. 3.
             Modal-only fuer alle 6 Sortier-Triggers, aktiv weggeklickt
             (Enter / OK-Klick / Esc), KEIN Auto-Dismiss.

             Phase 1.5 Polish (2026-05-15, User-Feedback): Layout aufgeraeumt
             - Lagerfach prominent (FontSize 22, Akzent-Farbe) statt im
               GroupBox-Header versteckt
             - GroupBox-Container entfernt, Trennlinien statt Borders
             - Items: Detail (BL-ID + Farbe) prominent in Monospace, Name
               klein darunter als Fallback bei Bild-Fehler
             - Header dezenter (kein Akzent mehr), Modal schmaler und mit
               mehr Padding
        -->
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="32"
                MaxWidth="560" MaxHeight="700"
                MouseLeftButtonUp="OverlayPanel_MouseLeftButtonUp">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ScanViewModel.BinInstruction.Mode}"
                                     Value="{x:Static vm:BinInstructionMode.SortInstruction}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="6" Opacity="0.4"/>
            </Border.Effect>

            <DockPanel LastChildFill="True">
                <!-- Header: "Operation erfolgreich" o.ae. Dezenter (kein
                     Akzent, kleinere FontSize) — der Bin-Label in den
                     Sektionen ist das visuelle Highlight, nicht der Header. -->
                <TextBlock DockPanel.Dock="Top"
                           Text="{Binding ScanViewModel.BinInstruction.HeaderText}"
                           TextWrapping="Wrap"
                           FontSize="14"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,0,0,24"/>

                <!-- Bottom: OK-Button mit Enter-Default + Hinweis-Text -->
                <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Center" Margin="0,24,0,0">
                    <Button Content="Verstanden (Enter)"
                            IsDefault="True"
                            HorizontalAlignment="Center"
                            Padding="32,8"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="Ok_Click"
                            ToolTip="Druecke Enter / Leertaste oder klicke um fortzufahren."/>
                    <TextBlock Text="Enter / Leertaste / Esc schliesst — KEIN Auto-Dismiss"
                               FontSize="11"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"/>
                </StackPanel>

                <!-- Mitte: scrollbarer Bereich mit Take/Put/Plus-Sektionen.
                     Layout pro Sektion:
                       - Mini-Label "Nimm aus" / "Lege in" (FontSize 11, secondary)
                       - Bin-Label prominent (FontSize 22, Bold, Akzent)
                       - Trennlinie
                       - Items: 48px-Bild, Detail prominent in Mono, Label klein
                -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520">
                    <StackPanel>

                        <!--
                            Phase 2a (2026-05-15): Item-Layout harmonisiert mit
                            Wizard-Stufe-1-Items. Jedes Item bekommt einen
                            Border mit dezentem Background (Light-Mode hellgrau,
                            Dark-Mode dunkelgrau via DynamicResource), 6px
                            CornerRadius, 10x8 Padding, 10px Spacing zwischen
                            Items. Detail prominent in Mono, Label klein
                            darunter, Quantity rechts. Engineering-Prinzip 1.3
                            (Konsistenz).
                        -->

                        <!-- Take-Sektionen -->
                        <ItemsControl ItemsSource="{Binding ScanViewModel.BinInstruction.TakeSections}">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ScanViewModel.BinInstruction.HasTakeSections}"
                                                     Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,16">
                                        <!-- Sektion-Header: Mini-Label + prominenter Bin-Label -->
                                        <TextBlock Text="Nimm aus"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                   Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding BinLabel}"
                                                   FontSize="22"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource SystemAccentBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,0,8"/>
                                        <Separator Margin="0,0,0,4"
                                                   Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                                            CornerRadius="6"
                                                            Padding="10,8"
                                                            Margin="0,5">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="60"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Image Grid.Column="0"
                                                                   Source="{Binding ImageUrl, Converter={StaticResource NullToImageSource}}"
                                                                   Width="48" Height="48"
                                                                   Stretch="Uniform"
                                                                   b:ImageZoom.IsEnabled="True"/>
                                                            <StackPanel Grid.Column="1"
                                                                        VerticalAlignment="Center"
                                                                        Margin="12,0">
                                                                <TextBlock Text="{Binding Detail}"
                                                                           FontSize="14"
                                                                           FontWeight="SemiBold"
                                                                           FontFamily="Consolas"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding Label}"
                                                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                                           FontSize="11"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding QuantityText}"
                                                                       FontSize="14"
                                                                       FontWeight="Bold"
                                                                       VerticalAlignment="Center"
                                                                       Margin="8,0,0,0"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Put-Sektionen -->
                        <ItemsControl ItemsSource="{Binding ScanViewModel.BinInstruction.PutSections}">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ScanViewModel.BinInstruction.HasPutSections}"
                                                     Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,16">
                                        <TextBlock Text="Lege in"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                   Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding BinLabel}"
                                                   FontSize="22"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource SystemAccentBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,0,8"/>
                                        <Separator Margin="0,0,0,4"
                                                   Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                                            CornerRadius="6"
                                                            Padding="10,8"
                                                            Margin="0,5">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="60"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Image Grid.Column="0"
                                                                   Source="{Binding ImageUrl, Converter={StaticResource NullToImageSource}}"
                                                                   Width="48" Height="48"
                                                                   Stretch="Uniform"
                                                                   b:ImageZoom.IsEnabled="True"/>
                                                            <StackPanel Grid.Column="1"
                                                                        VerticalAlignment="Center"
                                                                        Margin="12,0">
                                                                <TextBlock Text="{Binding Detail}"
                                                                           FontSize="14"
                                                                           FontWeight="SemiBold"
                                                                           FontFamily="Consolas"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding Label}"
                                                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                                           FontSize="11"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding QuantityText}"
                                                                       FontSize="14"
                                                                       FontWeight="Bold"
                                                                       VerticalAlignment="Center"
                                                                       Margin="8,0,0,0"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Plus-Hinweis (optional, z.B. fuer neue Figur) -->
                        <Border CornerRadius="4"
                                Padding="12,8"
                                Margin="0,8,0,0"
                                Background="{DynamicResource InfoBoxBackground}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ScanViewModel.BinInstruction.HasPlusHint}"
                                                     Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding ScanViewModel.BinInstruction.PlusHint}"
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       FontStyle="Italic"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===== GROUP-MODE ===== -->
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                BorderBrush="{DynamicResource SystemAccentColorLight2Brush}"
                BorderThickness="2"
                CornerRadius="8"
                Padding="24"
                MaxWidth="700" MaxHeight="600"
                MouseLeftButtonUp="OverlayPanel_MouseLeftButtonUp">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ScanViewModel.BinInstruction.Mode}"
                                     Value="{x:Static vm:BinInstructionMode.Group}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="6" Opacity="0.4"/>
            </Border.Effect>

            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top"
                           Text="{Binding ScanViewModel.BinInstruction.HeaderText}"
                           TextWrapping="Wrap"
                           FontSize="16" FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,0,0,16"/>

                <Button DockPanel.Dock="Bottom"
                        Content="Verstanden (Enter)"
                        IsDefault="True"
                        HorizontalAlignment="Center"
                        Padding="32,8"
                        Margin="0,16,0,0"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="Ok_Click"
                        ToolTip="Druecke Enter / Leertaste oder klicke um fortzufahren."/>

                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="450">
                    <ItemsControl ItemsSource="{Binding ScanViewModel.BinInstruction.Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- UX X.32 v0.1.19-beta.6: visuelle Trennung
                                     Quell-Items (oben, "rausnehmen") <-> Ziel-
                                     Items (unten, "reinlegen"). Vor jedem
                                     IsTargetItem=true: Separator. Plus
                                     leichter Akzent-Hintergrund am Item. -->
                                <StackPanel>
                                    <Separator Margin="0,8,0,4"
                                               Background="{DynamicResource SystemAccentColorLight2Brush}"
                                               Height="1"
                                               Visibility="{Binding IsTargetItem,
                                                                    Converter={StaticResource BoolToVisibility}}"/>

                                    <Border CornerRadius="4" Padding="8,4">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsTargetItem}" Value="True">
                                                        <Setter Property="Background"
                                                                Value="{DynamicResource InfoBoxBackground}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Image Grid.Column="0"
                                                   Source="{Binding ImageUrl, Converter={StaticResource NullToImageSource}}"
                                                   Width="48" Height="48"
                                                   Stretch="Uniform"/>

                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Margin="8,0">
                                                <TextBlock Text="{Binding ItemLabel}"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding QuantityText}"
                                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                           FontSize="11"/>
                                            </StackPanel>

                                            <Border Grid.Column="2"
                                                    Background="{DynamicResource SystemAccentColorLight2Brush}"
                                                    CornerRadius="4"
                                                    Padding="12,6"
                                                    VerticalAlignment="Center"
                                                    MinWidth="100">
                                                <TextBlock Text="{Binding BinLabel}"
                                                           Foreground="White"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
