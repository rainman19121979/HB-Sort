<UserControl x:Class="HBSort.Views.BinInstructionOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <!--
        UX X.31 Block B (v0.1.18): Mittiges Anweisungs-Overlay nach Persist
        einer Figur oder Lagern eines Einzelteils. Zeigt prominent das
        Lagerfach-Label + Item-Bild, damit der User nach dem Enter-Hotkey
        weiss wo das Item physisch hin soll. Schliesst per Klick irgendwo,
        per Enter / Leertaste / Esc oder per 8s-Timeout (im VM).

        Layout: HorizontalAlignment Center + VerticalAlignment Top damit
        die Webcam (Spalte 1) und Lagerliste-Liste (Spalte 3) sichtbar
        bleiben. Die mittlere Spalte des Sortier-Tabs wird teilweise
        ueberdeckt - das ist gewollt, weil das Pending nach dem Persist
        eh leer ist.
    -->
    <Grid x:Name="OverlayRoot"
          Background="#80000000"
          MouseLeftButtonUp="OverlayBackground_MouseLeftButtonUp"
          ToolTip="Klick irgendwo zum Schliessen">
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,40,0,0"
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                BorderBrush="{DynamicResource SystemAccentColorLight2Brush}"
                BorderThickness="2"
                CornerRadius="8"
                Padding="24"
                MaxWidth="560"
                MouseLeftButtonUp="OverlayPanel_MouseLeftButtonUp">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="6" Opacity="0.4"/>
            </Border.Effect>

            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="Lege diesen Eintrag in"
                           FontSize="14"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="{Binding ScanViewModel.BinInstruction.Label}"
                           FontSize="32" FontWeight="Bold"
                           Foreground="{DynamicResource SystemAccentBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,12"/>

                <Image Source="{Binding ScanViewModel.BinInstruction.ImageUrl,
                                        Converter={StaticResource NullToImageSource}}"
                       MaxWidth="200" MaxHeight="200"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12"/>

                <Button Content="OK"
                        IsDefault="True"
                        HorizontalAlignment="Center"
                        Padding="32,6"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="Ok_Click"
                        ToolTip="Druecke Enter / Leertaste oder klicke um fortzufahren."/>

                <TextBlock Text="Enter / Leertaste oder Klick zum Fortfahren"
                           FontSize="11"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
