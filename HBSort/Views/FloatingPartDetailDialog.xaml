<Window x:Class="HBSort.Views.FloatingPartDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:b="clr-namespace:HBSort.Behaviors"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Einzelteil"
        ToolTipService.IsEnabled="{DynamicResource TooltipsEnabled}"
        Icon="../Resources/app.ico"
        Width="520" Height="360"
        WindowStartupLocation="CenterOwner">
    <!--
        UX X.20 Teil 1: Detail-Popup fuer einen einzelnen FloatingPart aus
        der Lagerliste. Im Stil des MinifigSummaryDialog (groesses Bild links,
        Header-Block rechts, Schliessen-Button unten rechts), nur ohne
        Teile-Liste/Aktionen - wir zeigen reine Item-Eigenschaften.
    -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>     <!-- 0: Header -->
            <RowDefinition Height="*"/>        <!-- 1: Felder -->
            <RowDefinition Height="Auto"/>     <!-- 2: Buttons -->
        </Grid.RowDefinitions>

        <!-- Header: Bild links + Name + BL-Part-No + Lagerfach rechts -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0"
                   x:Name="PartImage"
                   Width="100" Height="100" Stretch="Uniform"
                   VerticalAlignment="Top"
                   b:ImageZoom.IsEnabled="True"
                   ToolTip="Vergroessern"/>

            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="NameText"
                           FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>

                <TextBlock Margin="0,4,0,0" FontSize="12">
                    <Run Text="BL-Part:" Foreground="Gray"/>
                    <Run x:Name="BlPartIdRun" FontFamily="Consolas"/>
                </TextBlock>

                <!-- Lagerfach-Badge im Stil von UX X.19. -->
                <Border Margin="0,8,0,0"
                        HorizontalAlignment="Left"
                        Background="{StaticResource InfoBoxBackground}"
                        BorderBrush="{StaticResource StatusInfoBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8,4"
                        ToolTip="Hier liegt das Teil aktuell im Lager.">
                    <TextBlock x:Name="StorageBinText"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource StatusInfoBrush}"/>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Felder: Farbe + Anzahl in einer Eigenschaften-Liste -->
        <Border Grid.Row="1" Margin="0,16,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="1" CornerRadius="4"
                Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Farbe-Zeile mit Swatch + Name + BL-ID -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Farbe:"
                           Foreground="Gray" FontSize="12"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border x:Name="ColorSwatch"
                            Width="20" Height="20"
                            BorderBrush="Black" BorderThickness="1"
                            Margin="0,0,8,0"/>
                    <TextBlock x:Name="ColorText"
                               FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Anzahl-Zeile -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Anzahl:"
                           Foreground="Gray" FontSize="12"
                           Margin="0,8,0,0"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Grid.Column="1"
                           x:Name="QuantityText"
                           FontSize="13" FontWeight="SemiBold"
                           Margin="0,8,0,0"/>
            </Grid>
        </Border>

        <!-- Buttons: Read-Only-Dialog (Schliessen via IsCancel/ESC). -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Schliessen" IsCancel="True" Width="120"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
